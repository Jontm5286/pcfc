---
/**
 * /categorias — PCFC
 * Página de categorías formativas. Sigue DESIGN.md §6 (sitemap narrativo):
 *   - Hero navy → claridad ("Tu hijo tiene un camino claro")
 *   - Lista de programas por edad → convicción ("Esto es lo que ofrece")
 *   - CTA inscripción por categoría → acción ("Inscríbelo ahora")
 *
 * Datos hardcodeados de las 4 categorías. En el futuro se cargarán desde EmDash.
 */

import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CategoryList, { type Category } from '../components/CategoryList.astro';
import FinalCta from '../components/FinalCta.astro';
import { fetchPublishedCategories, type PublishedCategory } from '../lib/academy-feed';

// Respaldo local (idéntico al hardcodeado previo): se usa si EmDash viene
// vacío o falla. Patrón index.astro (fetchPublishedGalleries + fallback).
const fallbackCategories = [
  {
    slug: 'pre' as const,
    title: 'Pre-Formativas',
    ageMin: 4,
    ageMax: 8,
    ageRange: '4–8 años',
    focus: 'Movilidad, coordinación, primer contacto con el balón',
    format: 'Partidos formativos 90 min',
    description:
      'El primer paso dentro del club. Jugamos a aprender: exploración del balón, coordinación motriz y reglas básicas en un entorno lúdico, seguro y siempre acompañado por nuestros entrenadores.',
    ctaHref: '/inscribete',
  },
  {
    slug: 'form-baja' as const,
    title: 'Formativas Bajas',
    ageMin: 9,
    ageMax: 12,
    ageRange: '9–12 años',
    focus: 'Técnica individual, reglas del juego, compañerismo',
    format: 'Partidos 7 vs 7',
    description:
      'Consolidamos la técnica individual — control, pase, conducción — e introducimos la táctica colectiva en formato 7v7. Los jugadores entienden el juego, sus posiciones y el valor del equipo.',
    ctaHref: '/inscribete',
  },
  {
    slug: 'form-alta' as const,
    title: 'Formativas Altas',
    ageMin: 13,
    ageMax: 15,
    ageRange: '13–15 años',
    focus: 'Táctica, preparación física, competición federada',
    format: 'Partidos 9 vs 9',
    description:
      'Etapa de competición real. Profundizamos en sistemas tácticos, añadimos trabajo físico estructurado y participamos en torneos federados para medirnos contra otros clubes de la región.',
    ctaHref: '/inscribete',
  },
  {
    slug: 'elite' as const,
    title: 'Elite / Reserva',
    ageMin: 16,
    ageMax: 19,
    ageRange: '16–19 años',
    focus: 'Alto rendimiento, scouting, preparación física avanzada',
    format: 'Partidos 11 vs 11',
    description:
      'El último tramo del proceso formativo. Entrenamientos de alta intensidad, gimnasio, análisis de vídeo y seguimiento individual. Varios de nuestros jugadores de esta categoría han sido captados por clubes profesionales.',
    ctaHref: '/inscribete',
  },
];

// EmDash en vivo (colección `categories`); respaldo local si <4 o falla.
// ageMin/ageMax no existen en EmDash → se heredan del respaldo por slug.
const liveCategories: PublishedCategory[] = await fetchPublishedCategories().catch(
  (): PublishedCategory[] => []
);
const categories: Category[] =
  liveCategories.length >= 4
    ? liveCategories.map((c) => {
        const fb = fallbackCategories.find((s) => s.slug === c.slug) ?? fallbackCategories[0];
        return {
          slug: (c.slug || fb.slug) as Category['slug'],
          title: c.name || fb.title,
          ageMin: fb.ageMin,
          ageMax: fb.ageMax,
          ageRange: c.ages || fb.ageRange,
          focus: c.focus || fb.focus,
          format: c.format || fb.format,
          description: c.description || fb.description,
          ctaHref: c.ctaHref || fb.ctaHref,
        };
      })
    : fallbackCategories;
---

<Base
  title="Categorías formativas"
  description="Las cuatro categorías formativas de Punta Cana FC: Pre-Formativas, Formativas Bajas, Formativas Altas y Elite/Reserva. Descubre en cuál está tu hijo."
>
  <!-- ============================================ -->
  <!-- HERO — claridad: "Tu hijo tiene un camino claro" -->
  <!-- ============================================ -->
  <PageHero
    eyebrow="Formación 4–19 años"
    title="Categorías formativas"
    lede="Cuatro etapas, un camino. Cada jugador de Punta Cana FC pasa por un proceso diseñado según su edad, su desarrollo y sus objetivos — desde el primer contacto con el balón hasta el alto rendimiento."
    image="historia"
    alt="Entrenamiento con balón de jugadores de Punta Cana FC formando campeones en el Caribe"
    titleClass="text-[clamp(2.5rem,6vw,4.5rem)] mb-5 max-w-[18ch]"
    ledeClass="max-w-[58ch]"
  />

  <!-- ============================================ -->
  <!-- LISTA DE PROGRAMAS POR EDAD — convicción -->
  <!-- ============================================ -->
  <section class="section bg-white">
    <div class="container-x">
      <SectionHeader
        eyebrow="Programas por edad"
        title="ENCUENTRA TU<br />CATEGORÍA"
        subtitle="Cada edad tiene su momento. Encuentra el programa indicado para tu hijo y dale el entorno que necesita para crecer como jugador."
      />

      <CategoryList categories={categories} />
    </div>
  </section>

  <!-- ============================================ -->
  <!-- CTA FINAL — acción -->
  <!-- ============================================ -->
  <FinalCta secondaryLabel="Conoce el club" secondaryHref="/club" />
</Base>
