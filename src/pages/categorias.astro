---
/**
 * /categorias — PCFC
 * Página de categorías formativas. Sigue DESIGN.md §6 (sitemap narrativo):
 *   - Hero navy → claridad ("Tu hijo tiene un camino claro")
 *   - Lista de programas por edad → convicción ("Esto es lo que ofrece")
 *   - CTA inscripción por categoría → acción ("Inscríbelo ahora")
 *
 * Datos hardcodeados de las 4 categorías. En el futuro se cargarán desde EmDash.
 */

import Base from "../layouts/Base.astro";
import StockImage from "../components/StockImage.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CategoryCard from "../components/CategoryCard.astro";

const categories = [
  {
    slug: "pre" as const,
    title: "Pre-Formativas",
    ageMin: 4,
    ageMax: 8,
    ageRange: "4–8 años",
    focus: "Movilidad, coordinación, primer contacto con el balón",
    format: "Partidos formativos 90 min",
    schedule: "Martes y jueves · 4:00–5:30 pm",
    description:
      "El primer paso dentro del club. Jugamos a aprender: exploración del balón, coordinación motriz y reglas básicas en un entorno lúdico, seguro y siempre acompañado por nuestros entrenadores.",
    ctaHref: "/inscribete",
  },
  {
    slug: "form-baja" as const,
    title: "Formativas Bajas",
    ageMin: 9,
    ageMax: 12,
    ageRange: "9–12 años",
    focus: "Técnica individual, reglas del juego, compañerismo",
    format: "Partidos 7 vs 7",
    schedule: "Lunes, miércoles y viernes · 4:00–6:00 pm",
    description:
      "Consolidamos la técnica individual — control, pase, conducción — e introducimos la táctica colectiva en formato 7v7. Los jugadores entienden el juego, sus posiciones y el valor del equipo.",
    ctaHref: "/inscribete",
  },
  {
    slug: "form-alta" as const,
    title: "Formativas Altas",
    ageMin: 13,
    ageMax: 15,
    ageRange: "13–15 años",
    focus: "Táctica, preparación física, competición federada",
    format: "Partidos 9 vs 9",
    schedule: "Martes y jueves · 5:00–7:00 pm + bloque de acondicionamiento",
    description:
      "Etapa de competición real. Profundizamos en sistemas tácticos, añadimos trabajo físico estructurado y participamos en torneos federados para medirnos contra otros clubes de la región.",
    ctaHref: "/inscribete",
  },
  {
    slug: "elite" as const,
    title: "Elite / Reserva",
    ageMin: 16,
    ageMax: 19,
    ageRange: "16–19 años",
    focus: "Alto rendimiento, scouting, preparación física avanzada",
    format: "Partidos 11 vs 11",
    schedule: "Lunes, miércoles y viernes · 6:00–8:00 pm + gimnasio",
    description:
      "El último tramo del proceso formativo. Entrenamientos de alta intensidad, gimnasio, análisis de vídeo y seguimiento individual. Varios de nuestros jugadores de esta categoría han sido captados por clubes profesionales.",
    ctaHref: "/inscribete",
  },
];
---

<Base
  title="Categorías formativas"
  description="Las cuatro categorías formativas de Punta Cana FC: Pre-Formativas, Formativas Bajas, Formativas Altas y Elite/Reserva. Descubre en cuál está tu hijo."
>
  <!-- ============================================ -->
  <!-- HERO — claridad: "Tu hijo tiene un camino claro" -->
  <!-- ============================================ -->
  <section class="hero-with-image text-white pt-[clamp(6rem,12vw,9rem)] pb-[clamp(4rem,8vw,6rem)] relative">
    <StockImage name="historia" alt="Entrenamiento con balón de jugadores de Punta Cana FC formando campeones en el Caribe" className="absolute inset-0 w-full h-full object-cover" width={1600} height={1200} loading="eager" />
    <div class="hero-overlay"></div>
    <div class="container-x relative z-10">
      <p class="eyebrow eyebrow--on-navy">Formación 4–19 años</p>
      <h1 class="h-display h-display--on-navy text-[clamp(2.5rem,6vw,4.5rem)] mb-5 max-w-[18ch]">
        Categorías formativas
      </h1>
      <p class="lede lede--on-navy max-w-[58ch]">
        Cuatro etapas, un camino. Cada jugador de Punta Cana FC pasa por un
        proceso diseñado según su edad, su desarrollo y sus objetivos — desde
        el primer contacto con el balón hasta el alto rendimiento.
      </p>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- LISTA DE PROGRAMAS POR EDAD — convicción -->
  <!-- ============================================ -->
  <section class="section bg-white">
    <div class="container-x">
      <SectionHeader
        eyebrow="Programas por edad"
        title="ENCUENTRA TU<br />CATEGORÍA"
        subtitle="Cada edad tiene su momento. Encuentra el programa indicado para tu hijo y dale el entorno que necesita para crecer como jugador."
      />

      <div
        class="grid grid-cols-1 md:grid-cols-2 gap-8"
        role="list"
        aria-label="Lista de categorías formativas"
      >
        {
          categories.map((cat) => (
            <div role="listitem">
              <CategoryCard
                slug={cat.slug}
                title={cat.title}
                ageRange={cat.ageRange}
                focus={cat.focus}
                format={cat.format}
                schedule={cat.schedule}
                description={cat.description}
                ageMin={cat.ageMin}
                ageMax={cat.ageMax}
                ctaHref={cat.ctaHref}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- CTA FINAL — acción -->
  <!-- ============================================ -->
  <section class="bg-navy text-white py-[clamp(4rem,8vw,6rem)] border-t border-navy-60/40">
    <div class="container-x flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-[52ch]">
        <p class="eyebrow eyebrow--on-navy">Siguiente paso</p>
        <h2 class="h-section h-section--on-navy mb-3">
          INSCRIBE A TU HIJO HOY
        </h2>
        <p class="lede lede--on-navy">
          Completa el formulario de inscripción en menos de tres minutos. Si
          tienes dudas, escríbenos por WhatsApp y te guiamos en el proceso.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/inscribete" class="btn btn--sky btn--on-navy btn--lg">
          Iniciar inscripción
          <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a href="/club" class="btn btn--outline-on-navy btn--lg">
          Conoce el club
        </a>
      </div>
    </div>
  </section>
</Base>
