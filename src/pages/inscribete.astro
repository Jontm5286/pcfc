---
import Base from '../layouts/Base.astro';
import StockImage from '../components/StockImage.astro';
import FaqSection from '../components/FaqSection.astro';
import { getSedes } from '../data/sedes';

// Sede preseleccionada vía ?sede=<slug> (desde las tarjetas de sede en
// /area-deportiva o en esta misma página → "Elegir esta sede").
// Solo se aceptan slugs de getSedes(); cualquier otro valor se ignora.
const sedeParam = (Astro.url.searchParams.get('sede') ?? '').trim().toLowerCase();
const sedeSlugs = new Set(getSedes().map((s) => s.slug));
const sedePreseleccionada = sedeSlugs.has(sedeParam) ? sedeParam : '';
const sedes = getSedes();

// NOTA: ya no se pide categoría en el formulario (decisión del club).
// El wizard deriva una categoría PROVISIONAL desde la fecha de nacimiento
// solo para cumplir el contrato del endpoint de plataforma (CategoryType),
// que exige `category`. El coordinador la confirma al activar.
// TABLA EDAD→CATEGORÍA PROVISIONAL (a validar por el club):
//   4–5 años → Sub-6 (Iniciación) | 6–7 → Sub-8 (Pre-Benjamín)
//   8–9 → Sub-10 (Benjamín) | 10–11 → Sub-12 (Alevín)
//   12–13 → Sub-14 (Infantil Mayor) | 14 → Sub-15 (Infantil)
//   15–17 → Sub-18 (Juvenil)
//   <4 → Sub-6 · >17 → Sub-18 · Femenino Juvenil nunca se auto-deriva.
---

<Base
  title="Inscríbete"
  description="Inscríbete en Punta Cana FC. Completa el formulario y un entrenador se pondrá en contacto en menos de 24 horas."
>

  <!-- ============================================================
       HERO — section con SectionHeader eyebrow + título + subtitle
       ============================================================ -->
  <section class="hero-with-image text-white pt-[clamp(6rem,12vw,9rem)] pb-[clamp(4rem,8vw,6rem)] relative">
    <StockImage
      name="jugadores-cancha"
      alt="Jugadores de Punta Cana FC entrenando en cancha al atardecer"
      className="absolute inset-0 w-full h-full object-cover object-[center_30%]"
      width={1600}
      height={1200}
      loading="eager"
    />
    <div class="hero-overlay"></div>
    <div class="container-x relative z-10">
      <div class="max-w-[720px]">
        <p class="eyebrow eyebrow--on-navy">Inscripciones abiertas · Temporada 2026</p>
        <h1 class="h-display h-display--on-navy text-[clamp(2.5rem,6.5vw,4.75rem)] mb-5">
          Únete a la academia<br/>del Caribe
        </h1>
        <p class="lede lede--on-navy max-w-[56ch]">
          Da el primer paso. Completa el formulario y un entrenador de PCFC se pondrá en contacto en menos de 24 horas.
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================================
       CONTENT — grid 2 columnas: info (proceso + requisitos) | formulario
       ============================================================ -->
  <section class="section">
    <div class="container-x">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-12 lg:gap-16 items-start">

        <!-- ── Columna izquierda: proceso + requisitos ── -->
        <div class="space-y-10">

          <!-- Proceso de 4 pasos -->
          <div>
            <h2 class="h-section mb-8">Proceso de inscripción</h2>
            <ol class="steps-list space-y-6">
              <li class="step-item">
                <div class="step-item__num" aria-hidden="true">1</div>
                <div>
                  <h3 class="step-item__title">Cuéntanos del jugador</h3>
                  <p class="step-item__sub">Llena los datos del jugador y del representante. Es rápido y sin compromiso.</p>
                </div>
              </li>
              <li class="step-item">
                <div class="step-item__num" aria-hidden="true">2</div>
                <div>
                  <h3 class="step-item__title">Prueba técnica personalizada</h3>
                  <p class="step-item__sub">El jugador realiza una evaluación con nuestros entrenadores certificados. Medimos su potencial con métricas objetivas.</p>
                </div>
              </li>
              <li class="step-item">
                <div class="step-item__num" aria-hidden="true">3</div>
                <div>
                  <h3 class="step-item__title">Conocemos tus expectativas</h3>
                  <p class="step-item__sub">Reunión con los padres y el jugador. Definimos juntos el camino ideal.</p>
                </div>
              </li>
              <li class="step-item">
                <div class="step-item__num" aria-hidden="true">4</div>
                <div>
                  <h3 class="step-item__title">Asignación y comienzo</h3>
                  <p class="step-item__sub">Tu hijo se integra a su categoría. Calentamiento grupal, evaluación continua y progresión garantizada.</p>
                </div>
              </li>
            </ol>
          </div>

        </div>

        <!-- ── Columna derecha: wizard de inscripción ── -->
        <div id="formulario" class="bg-white rounded-2xl border border-navy-10 p-8 lg:p-10 shadow-[0_4px_24px_rgba(0,40,92,0.08)]" data-sede-preselect={sedePreseleccionada}>
          <p class="wiz-eyebrow">Inscripción · 4 pasos cortos</p>
          <h2 class="h-card mb-2">Inscribe a tu hijo</h2>
          <p class="wiz-sub">Tu progreso se guarda solo en este dispositivo.</p>

          <!-- Barra de progreso -->
          <div class="wiz-progress" aria-hidden="true">
            <div class="wiz-bar"><div id="wiz-barfill"></div></div>
            <span class="wiz-stepcount" id="wiz-stepcount">Paso 1 de 4</span>
          </div>
          <ol class="wiz-dots" id="wiz-dots">
            <li class="on" data-dot="1">1 · Sede</li>
            <li data-dot="2">2 · Jugador</li>
            <li data-dot="3">3 · Tutor</li>
            <li data-dot="4">4 · Enviar</li>
          </ol>

          <!-- PASO 1: sede -->
          <section class="wiz-step on" data-step="1" aria-label="Paso 1: sede">
            <h3 class="wiz-title">¿Dónde va a entrenar?</h3>
            <p class="wiz-hint">Elige la sede donde entrenará.</p>
            <div class="wiz-pick" id="wiz-sedes" role="radiogroup" aria-label="Sede">
              {sedes.map((s) => (
                <button
                  type="button"
                  role="radio"
                  aria-checked={sedePreseleccionada === s.slug ? 'true' : 'false'}
                  data-slug={s.slug}
                  data-nombre={s.nombre}
                  class:list={['wiz-pick__btn', { sel: sedePreseleccionada === s.slug }]}
                >
                  <span class="wiz-pick__radio" aria-hidden="true"></span>
                  <span class="wiz-pick__text">
                    <b class="wiz-pick__name">{s.nombre}</b>
                    <small class="wiz-pick__addr">{s.direccion.includes('PLACEHOLDER') ? 'Dirección por confirmar — escríbenos por WhatsApp.' : s.direccion}</small>
                  </span>
                </button>
              ))}
            </div>
            <p class="wiz-note">La <b>categoría la asigna el club</b> según la fecha de nacimiento — no tienes que elegirla.</p>
            <p class="wiz-err" id="wiz-e1" role="alert" hidden>Elige la sede para continuar.</p>
            <div class="wiz-nav"><button type="button" class="btn btn--primary btn--lg wiz-nav__next" data-go="2">Continuar</button></div>
          </section>

          <!-- PASO 2: jugador -->
          <section class="wiz-step" data-step="2" aria-label="Paso 2: jugador" hidden>
            <h3 class="wiz-title">Datos del jugador</h3>
            <p class="wiz-hint">Tal como aparecen en su acta de nacimiento.</p>
            <div class="form-row-2">
              <div class="form-group">
                <label for="wiz-nombre" class="form-label">Nombre *</label>
                <input type="text" id="wiz-nombre" class="form-input" placeholder="Ej. Liam" autocomplete="given-name">
              </div>
              <div class="form-group">
                <label for="wiz-apellidos" class="form-label">Apellidos *</label>
                <input type="text" id="wiz-apellidos" class="form-input" placeholder="Ej. Tavárez Pérez" autocomplete="family-name">
              </div>
            </div>
            <div class="form-group">
              <label for="wiz-nacimiento" class="form-label">Fecha de nacimiento *</label>
              <input type="date" id="wiz-nacimiento" class="form-input">
            </div>
            <div class="form-group">
              <label for="wiz-colegio" class="form-label">Colegio al que asiste <span class="wiz-opt">(opcional)</span></label>
              <input type="text" id="wiz-colegio" class="form-input" placeholder="Ej. Colegio Punta Cana" autocomplete="off" maxlength="120">
            </div>
            <p class="wiz-cat" id="wiz-cat" hidden>Categoría provisional: <b id="wiz-cat-val"></b> <span>(la confirma el club)</span></p>
            <p class="wiz-err" id="wiz-e2" role="alert" hidden>Completa nombre, apellidos y una fecha de nacimiento válida.</p>
            <div class="wiz-nav">
              <button type="button" class="btn btn--secondary wiz-nav__back" data-go="1">Atrás</button>
              <button type="button" class="btn btn--primary btn--lg wiz-nav__next" data-go="3">Continuar</button>
            </div>
          </section>

          <!-- PASO 3: tutor -->
          <section class="wiz-step" data-step="3" aria-label="Paso 3: tutor" hidden>
            <h3 class="wiz-title">Datos del tutor</h3>
            <p class="wiz-hint">A este contacto enviaremos convocatorias y recibos.</p>
            <div class="form-group">
              <label for="wiz-tutor" class="form-label">Nombre del tutor *</label>
              <input type="text" id="wiz-tutor" class="form-input" placeholder="Nombre completo">
            </div>
            <div class="form-group">
              <span class="form-label" id="wiz-parentesco-label">Parentesco *</span>
              <div class="wiz-chips" id="wiz-parentesco" role="radiogroup" aria-labelledby="wiz-parentesco-label">
                <button type="button" data-v="Padre">Padre</button>
                <button type="button" data-v="Madre">Madre</button>
                <button type="button" data-v="Tutor Legal">Tutor Legal</button>
                <button type="button" data-v="Abuelo/a">Abuelo/a</button>
                <button type="button" data-v="Otro">Otro</button>
              </div>
            </div>
            <div class="form-row-2">
              <div class="form-group">
                <label for="wiz-tel" class="form-label">Teléfono / WhatsApp *</label>
                <input type="tel" id="wiz-tel" class="form-input" inputmode="tel" placeholder="809-000-0000" autocomplete="tel">
              </div>
              <div class="form-group">
                <label for="wiz-email" class="form-label">Correo *</label>
                <input type="email" id="wiz-email" class="form-input" inputmode="email" placeholder="correo@ejemplo.com" autocomplete="email">
              </div>
            </div>
            <div class="form-group">
              <label for="wiz-ocupacion" class="form-label">Ocupación del tutor <span class="wiz-opt">(opcional)</span></label>
              <input type="text" id="wiz-ocupacion" class="form-input" placeholder="Ej. Médica, docente, comerciante…" autocomplete="off" maxlength="120">
            </div>
            <button type="button" id="wiz-add2" class="wiz-toggle" aria-expanded="false" aria-controls="wiz-tutor2">+ Agregar segundo tutor (opcional)</button>
            <div id="wiz-tutor2" hidden>
              <div class="form-group">
                <label for="wiz-tutor2-nombre" class="form-label">Nombre del segundo tutor</label>
                <input type="text" id="wiz-tutor2-nombre" class="form-input" placeholder="Nombre completo">
              </div>
              <div class="form-group">
                <span class="form-label" id="wiz-parentesco2-label">Parentesco</span>
                <div class="wiz-chips" id="wiz-parentesco2" role="radiogroup" aria-labelledby="wiz-parentesco2-label">
                  <button type="button" data-v="Padre">Padre</button>
                  <button type="button" data-v="Madre">Madre</button>
                  <button type="button" data-v="Tutor Legal">Tutor Legal</button>
                  <button type="button" data-v="Abuelo/a">Abuelo/a</button>
                  <button type="button" data-v="Otro">Otro</button>
                </div>
              </div>
              <div class="form-group">
                <label for="wiz-tutor2-tel" class="form-label">Teléfono / WhatsApp</label>
                <input type="tel" id="wiz-tutor2-tel" class="form-input" inputmode="tel" placeholder="809-000-0000">
              </div>
            </div>
            <p class="wiz-err" id="wiz-e3" role="alert" hidden>Completa nombre, parentesco, teléfono y un correo válido del tutor.</p>
            <div class="wiz-nav">
              <button type="button" class="btn btn--secondary wiz-nav__back" data-go="2">Atrás</button>
              <button type="button" class="btn btn--primary btn--lg wiz-nav__next" data-go="4">Revisar</button>
            </div>
          </section>

          <!-- PASO 4: opcionales + resumen + envío -->
          <section class="wiz-step" data-step="4" aria-label="Paso 4: revisar y enviar" hidden>
            <h3 class="wiz-title">Revisa y envía</h3>
            <p class="wiz-hint">Lo opcional puede quedar para después, en la sede.</p>
            <div class="form-group">
              <label for="wiz-dir" class="form-label">Dirección <span class="wiz-opt">(opcional)</span></label>
              <input type="text" id="wiz-dir" class="form-input" placeholder="Sector, calle…" autocomplete="street-address">
            </div>
            <div class="form-group">
              <label for="wiz-med" class="form-label">Condición médica o alergia <span class="wiz-opt">(opcional)</span></label>
              <textarea id="wiz-med" rows="2" class="form-input" placeholder="Ej. Asma leve, usa inhalador"></textarea>
            </div>
            <div class="wiz-resume" id="wiz-resumen" aria-live="polite"></div>
            <div class="form-group">
              <label class="checkbox-label">
                <input type="checkbox" id="wiz-terminos" class="form-checkbox">
                <span class="form-label">Acepto los <a href="#" class="form-link">términos y condiciones</a> y la <a href="#" class="form-link">política de privacidad</a>. *</span>
              </label>
            </div>
            <!-- Honeypot anti-spam (oculto para humanos) -->
            <div class="hp-field" aria-hidden="true">
              <label for="wiz-sitio">Sitio web</label>
              <input type="text" id="wiz-sitio" tabindex="-1" autocomplete="off">
            </div>
            <p class="wiz-err" id="wiz-e4" role="alert" hidden></p>
            <div class="wiz-nav">
              <button type="button" class="btn btn--secondary wiz-nav__back" data-go="3">Atrás</button>
              <button type="button" id="wiz-send" class="btn btn--primary btn--lg wiz-nav__next">Enviar inscripción</button>
            </div>
          </section>

          <!-- ÉXITO -->
          <section class="wiz-step" data-step="5" aria-label="Inscripción recibida" hidden>
            <div class="wiz-ok">
              <div class="wiz-ok__big" aria-hidden="true">✓</div>
              <h3 class="wiz-title">¡Inscripción recibida!</h3>
              <p class="wiz-hint" id="wiz-okmsg">Te contactaremos por WhatsApp en menos de 48 horas para la prueba de nivel.</p>
            </div>
            <div class="wiz-nav"><button type="button" class="btn btn--primary btn--lg wiz-nav__next" data-go="1" id="wiz-again">Nueva inscripción</button></div>
          </section>

          <p class="wiz-draft" id="wiz-draft" hidden>Borrador guardado en este dispositivo.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================================================
       SEDES — dónde entrenará el jugador
       ============================================================ -->
  <section class="section bg-navy-05" id="sedes">
    <div class="container-x">
      <p class="eyebrow">Dónde entrenamos</p>
      <h2 class="h-section mb-2">Nuestras sedes</h2>
      <p class="lede mb-10 max-w-[60ch]">
        Elige tu sede más cercana en el formulario. Los horarios se confirman
        por sede al inscribirte.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          sedes.map((s) => (
            <article class="relative overflow-hidden bg-white border border-navy/10 rounded-lg p-6 md:p-8 transition-[border-color,box-shadow] duration-200 hover:border-navy/25 hover:shadow-[0_4px_20px_rgba(0,40,92,0.08)] flex flex-col gap-4">
              <div>
                <h3 class="h-card mb-2">{s.nombre}</h3>
                <p class="font-body text-[0.95rem] leading-[1.55] text-navy-60">
                  {s.direccion.includes('PLACEHOLDER')
                    ? 'Dirección por confirmar — escríbenos por WhatsApp y te guiamos.'
                    : s.direccion}
                </p>
              </div>
              <p class="font-body text-[0.95rem] leading-[1.55]">
                <a href={`tel:${s.telefono.replace(/\s/g, '')}`} class="text-navy underline underline-offset-4">
                  {s.telefono}
                </a>
              </p>
              <footer class="pt-2 mt-auto flex flex-wrap gap-3">
                <a
                  href={`/inscribete?sede=${s.slug}#formulario`}
                  class="btn btn--primary"
                  aria-label={`Elegir la sede ${s.nombre} en el formulario`}
                >
                  Elegir esta sede
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
                <a
                  href={s.mapsUrl}
                  class="btn btn--secondary"
                  target="_blank"
                  rel="noopener"
                  aria-label={`Cómo llegar a ${s.nombre}`}
                >
                  Cómo llegar
                </a>
              </footer>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================
       TRUST SIGNALS — social proof antes del footer
       ============================================================ -->
  <section class="section bg-navy-05">
    <div class="container-x">
      <blockquote class="trust-card">
        <p class="trust-card__quote">
          "Mi hijo mejoró su juego técnico en 6 meses. La evaluación objetiva realmente funciona."
        </p>
        <footer class="trust-card__footer">
          <cite class="trust-card__cite">María G.</cite>
          <span class="trust-card__meta">Madre de jugador Sub-12 · Temp. 2025</span>
        </footer>
      </blockquote>
      <p class="trust-stat">
        <strong>Más de 500 futbolista-inscritos</strong> desde 2016
      </p>
    </div>
  </section>

  <!-- ============================================================
       FAQ — dudas frecuentes antes del footer
       ============================================================ -->
  <FaqSection
    eyebrow="DUDAS FRECUENTES"
    title="¿Listo para unirte? Primero resolvemos tus dudas"
    faqs={[
      {
        question: "¿Cuándo abren las pruebas para la temporada 2026?",
        answer: "Las pruebas de admisión se realizan durante enero y febrero. Tras recibir tu solicitud de inscripción, un entrenador de PCFC se pondrá en contacto para agendarte una fecha y hora."
      },
      {
        question: "¿Cuál es la mensualidad y qué incluye?",
        answer: "La cuota mensual incluye 3 entrenamientos semanales con entrenadores certificados por la UEFA, uso de nuestras instalaciones (4 canchas, gimnasio y aula académica), material deportivo y participación en torneos internos. Las becas de mérito están disponibles para jugadores destacados."
      },
      {
        question: "¿Puedo inscribirme si mi hijo nunca ha jugado fútbol?",
        answer: "Sí. Contamos con una categoría de Pre-Formativas (4-8 años) orientada al primer contacto con el balón, trabajo de coordinación y motricidad, y amor por el juego. No se requiere experiencia previa."
      },
      {
        question: "¿Qué documentos debo presentar?",
        answer: "Acta de nacimiento, cédula o pasaporte del jugador, cédula del representante legal, certificado médico reciente (no mayor a 6 meses) y 2 fotos tipo carnet."
      },
      {
        question: "¿Tienen sedes fuera de Punta Cana?",
        answer: "Nuestra academia opera desde nuestras instalaciones principales en Punta Cana. En temporada también atendemos en Bávaro, Cap Cana, Higüey y La Romana, con sesiones grupales programadas para jugadores de esas zonas."
      }
    ]}
    contactEmail="admisiones@puntacanafc.com"
    contactPhone="+1 809-652-9450"
  />

<script>
  // ============================================================
  // Wizard de inscripción — 4 pasos + éxito.
  // Sin campo de categoría (decisión del club): se deriva una
  // categoría PROVISIONAL desde la fecha de nacimiento solo para
  // cumplir el contrato de /api/inscripcion-plataforma (CategoryType).
  // El coordinador la confirma al activar.
  //
  // TABLA EDAD→CATEGORÍA PROVISIONAL (a validar por el club):
  //   4–5 años → Sub-6 (Iniciación) | 6–7 → Sub-8 (Pre-Benjamín)
  //   8–9 → Sub-10 (Benjamín) | 10–11 → Sub-12 (Alevín)
  //   12–13 → Sub-14 (Infantil Mayor) | 14 → Sub-15 (Infantil)
  //   15–17 → Sub-18 (Juvenil)
  //   <4 → Sub-6 (Iniciación) · >17 → Sub-18 (Juvenil)
  //   Femenino Juvenil nunca se auto-deriva (lo asigna el club).
  // ============================================================
  const DRAFT_KEY = 'pcfc-inscripcion-draft-v1';
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function categoriaProvisional(fechaISO: string): string {
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(fechaISO);
    if (!m) return '';
    const hoy = new Date();
    let edad = hoy.getFullYear() - Number(m[1]);
    const mesDia = (hoy.getMonth() + 1) * 100 + hoy.getDate();
    if (mesDia < Number(m[2]) * 100 + Number(m[3])) edad -= 1;
    if (edad <= 5) return 'Sub-6 (Iniciación)';
    if (edad <= 7) return 'Sub-8 (Pre-Benjamín)';
    if (edad <= 9) return 'Sub-10 (Benjamín)';
    if (edad <= 11) return 'Sub-12 (Alevín)';
    if (edad <= 13) return 'Sub-14 (Infantil Mayor)';
    if (edad === 14) return 'Sub-15 (Infantil)';
    return 'Sub-18 (Juvenil)';
  }

  function fechaValida(fecha: string): boolean {
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(fecha);
    if (!m) return false;
    const y = Number(m[1]); const mo = Number(m[2]); const d = Number(m[3]);
    if (y < 2000 || y > new Date().getFullYear()) return false;
    const dt = new Date(Date.UTC(y, mo - 1, d));
    return dt.getUTCFullYear() === y && dt.getUTCMonth() === mo - 1 && dt.getUTCDate() === d;
  }

  const root = document.getElementById('formulario');
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement | null;
  const val = (id: string) => ($(id)?.value ?? '').trim();

  let sede = root?.dataset.sedePreselect ?? '';
  let sedeNombre = '';
  let parentesco = '';
  let parentesco2 = '';
  let tutor2on = false;

  const sedeBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('#wiz-sedes button'));
  function syncSedes() {
    sedeBtns.forEach((b) => {
      const on = b.dataset.slug === sede;
      b.classList.toggle('sel', on);
      b.setAttribute('aria-checked', on ? 'true' : 'false');
      if (on) sedeNombre = b.dataset.nombre ?? '';
    });
  }
  sedeBtns.forEach((b) => {
    b.addEventListener('click', () => { sede = b.dataset.slug ?? ''; syncSedes(); hideErr(1); saveDraft(); });
  });
  syncSedes();

  function chipGroup(id: string, set: (v: string) => void) {
    const btns = Array.from(document.querySelectorAll<HTMLButtonElement>(`#${id} button`));
    btns.forEach((b) => {
      if (b.dataset.v === (id === 'wiz-parentesco' ? parentesco : parentesco2)) b.classList.add('sel');
      b.addEventListener('click', () => {
        btns.forEach((x) => x.classList.remove('sel'));
        b.classList.add('sel');
        set(b.dataset.v ?? '');
        hideErr(3);
        saveDraft();
      });
    });
    return btns;
  }
  const chips1 = chipGroup('wiz-parentesco', (v) => { parentesco = v; });
  const chips2 = chipGroup('wiz-parentesco2', (v) => { parentesco2 = v; });

  const add2 = $('wiz-add2');
  const tutor2 = document.getElementById('wiz-tutor2');
  function setTutor2(on: boolean) {
    tutor2on = on;
    if (tutor2) tutor2.hidden = !on;
    if (add2) {
      add2.textContent = on ? '− Quitar segundo tutor' : '+ Agregar segundo tutor (opcional)';
      add2.setAttribute('aria-expanded', on ? 'true' : 'false');
    }
  }
  add2?.addEventListener('click', () => setTutor2(!tutor2on));

  function showErr(step: number, msg?: string) {
    const e = document.getElementById(`wiz-e${step}`);
    if (!e) return;
    if (msg) e.textContent = msg;
    e.hidden = false;
  }
  function hideErr(step: number) {
    document.getElementById(`wiz-e${step}`)?.setAttribute('hidden', '');
  }

  function validStep(n: number): boolean {
    if (n === 1) return sede !== '';
    if (n === 2) return val('wiz-nombre') !== '' && val('wiz-apellidos') !== '' && fechaValida(val('wiz-nacimiento'));
    if (n === 3) {
      return (
        val('wiz-tutor') !== '' &&
        parentesco !== '' &&
        val('wiz-tel').replace(/\D/g, '').length >= 7 &&
        EMAIL_RE.test(val('wiz-email'))
      );
    }
    return true;
  }

  const ERR_MSG: Record<number, string> = {
    1: 'Elige la sede para continuar.',
    2: 'Completa nombre, apellidos y una fecha de nacimiento válida.',
    3: 'Completa nombre, parentesco, teléfono y un correo válido del tutor.',
  };

  function escHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function renderResumen() {
    const el = document.getElementById('wiz-resumen');
    if (!el) return;
    const cat = categoriaProvisional(val('wiz-nacimiento'));
    const seg = tutor2on && val('wiz-tutor2-nombre')
      ? `<div><b>Segundo tutor:</b> ${escHtml(val('wiz-tutor2-nombre'))}${parentesco2 ? ` (${escHtml(parentesco2)})` : ''}${val('wiz-tutor2-tel') ? ` — ${escHtml(val('wiz-tutor2-tel'))}` : ''}</div>`
      : '';
    el.innerHTML =
      `<div><b>Sede:</b> ${escHtml(sedeNombre || sede)}</div>` +
      `<div><b>Jugador:</b> ${escHtml(val('wiz-nombre'))} ${escHtml(val('wiz-apellidos'))} (${escHtml(val('wiz-nacimiento'))})</div>` +
      `<div><b>Categoría provisional:</b> ${escHtml(cat)} <span class="wiz-resume__note">(la confirma el club)</span></div>` +
      (val('wiz-colegio') ? `<div><b>Colegio:</b> ${escHtml(val('wiz-colegio'))}</div>` : '') +
      `<div><b>Tutor:</b> ${escHtml(val('wiz-tutor'))} (${escHtml(parentesco)}) — ${escHtml(val('wiz-tel'))} · ${escHtml(val('wiz-email'))}</div>` +
      (val('wiz-ocupacion') ? `<div><b>Ocupación del tutor:</b> ${escHtml(val('wiz-ocupacion'))}</div>` : '') +
      seg;
  }

  function go(n: number) {
    document.querySelectorAll('.wiz-err').forEach((e) => e.setAttribute('hidden', ''));
    document.querySelectorAll('.wiz-step').forEach((s) => {
      const on = Number((s as HTMLElement).dataset.step) === n;
      (s as HTMLElement).hidden = !on;
      s.classList.toggle('on', on);
    });
    if (n <= 4) {
      const fill = document.getElementById('wiz-barfill');
      if (fill) fill.style.width = `${n * 25}%`;
      const count = document.getElementById('wiz-stepcount');
      if (count) count.textContent = `Paso ${n} de 4`;
      document.querySelectorAll('#wiz-dots li').forEach((d) => {
        d.classList.toggle('on', Number((d as HTMLElement).dataset.dot) === n);
      });
      if (n === 4) renderResumen();
    } else {
      const fill = document.getElementById('wiz-barfill');
      if (fill) fill.style.width = '100%';
      const count = document.getElementById('wiz-stepcount');
      if (count) count.textContent = 'Completado';
    }
    document.getElementById('formulario')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  document.querySelectorAll('[data-go]').forEach((b) => {
    b.addEventListener('click', () => {
      const n = Number((b as HTMLElement).dataset.go);
      const cur = currentStep();
      if (n > cur) {
        for (let s = cur; s < n; s += 1) {
          if (!validStep(s)) { go(s); showErr(s, ERR_MSG[s]); return; }
        }
      }
      if (n === 1 && (b as HTMLElement).id === 'wiz-again') resetWizard();
      else go(n);
    });
  });

  function currentStep(): number {
    const on = document.querySelector('.wiz-step.on');
    return on ? Number((on as HTMLElement).dataset.step) : 1;
  }

  // Borrador auto-guardado en localStorage
  function saveDraft() {
    try {
      localStorage.setItem(DRAFT_KEY, JSON.stringify({
        sede, parentesco, parentesco2, tutor2on,
        nombre: val('wiz-nombre'), apellidos: val('wiz-apellidos'),
        nacimiento: val('wiz-nacimiento'), colegio: val('wiz-colegio'), tutor: val('wiz-tutor'),
        ocupacion: val('wiz-ocupacion'), tel: val('wiz-tel'), email: val('wiz-email'),
        tutor2: val('wiz-tutor2-nombre'), tutor2tel: val('wiz-tutor2-tel'),
        dir: val('wiz-dir'), med: val('wiz-med'),
      }));
      document.getElementById('wiz-draft')?.removeAttribute('hidden');
    } catch { /* almacenamiento no disponible */ }
  }
  function loadDraft() {
    let d: Record<string, string | boolean> = {};
    try { d = JSON.parse(localStorage.getItem(DRAFT_KEY) ?? '{}'); } catch { return; }
    const set = (id: string, v: unknown) => { const el = $(id); if (el && typeof v === 'string') el.value = v; };
    if (typeof d.sede === 'string' && sedeBtns.some((b) => b.dataset.slug === d.sede)) sede = d.sede as string;
    if (typeof d.parentesco === 'string') {
      parentesco = d.parentesco as string;
      chips1.forEach((b) => b.classList.toggle('sel', b.dataset.v === parentesco));
    }
    if (typeof d.parentesco2 === 'string') {
      parentesco2 = d.parentesco2 as string;
      chips2.forEach((b) => b.classList.toggle('sel', b.dataset.v === parentesco2));
    }
    set('wiz-nombre', d.nombre); set('wiz-apellidos', d.apellidos);
    set('wiz-nacimiento', d.nacimiento); set('wiz-colegio', d.colegio); set('wiz-tutor', d.tutor);
    set('wiz-ocupacion', d.ocupacion); set('wiz-tel', d.tel); set('wiz-email', d.email);
    set('wiz-tutor2-nombre', d.tutor2); set('wiz-tutor2-tel', d.tutor2tel);
    set('wiz-dir', d.dir); set('wiz-med', d.med);
    if (d.tutor2on === true) setTutor2(true);
    syncSedes();
    updateCat();
    if (Object.keys(d).length) document.getElementById('wiz-draft')?.removeAttribute('hidden');
  }
  ['wiz-nombre', 'wiz-apellidos', 'wiz-nacimiento', 'wiz-colegio', 'wiz-tutor', 'wiz-ocupacion', 'wiz-tel', 'wiz-email',
   'wiz-tutor2-nombre', 'wiz-tutor2-tel', 'wiz-dir', 'wiz-med'].forEach((id) => {
    $(id)?.addEventListener('input', () => {
      if (id === 'wiz-nacimiento') updateCat();
      hideErr(currentStep());
      saveDraft();
    });
  });

  function updateCat() {
    const cat = categoriaProvisional(val('wiz-nacimiento'));
    const box = document.getElementById('wiz-cat');
    const lbl = document.getElementById('wiz-cat-val');
    if (box && lbl) {
      if (cat) { lbl.textContent = cat; box.hidden = false; }
      else box.hidden = true;
    }
  }

  function resetWizard() {
    try { localStorage.removeItem(DRAFT_KEY); } catch { /* noop */ }
    ['wiz-nombre', 'wiz-apellidos', 'wiz-nacimiento', 'wiz-colegio', 'wiz-tutor', 'wiz-ocupacion', 'wiz-tel', 'wiz-email',
     'wiz-tutor2-nombre', 'wiz-tutor2-tel', 'wiz-dir', 'wiz-med', 'wiz-sitio'].forEach((id) => {
      const el = $(id); if (el) el.value = '';
    });
    const term = $('wiz-terminos') as HTMLInputElement | null;
    if (term) term.checked = false;
    sede = root?.dataset.sedePreselect ?? '';
    parentesco = ''; parentesco2 = '';
    chips1.forEach((b) => b.classList.remove('sel'));
    chips2.forEach((b) => b.classList.remove('sel'));
    setTutor2(false);
    syncSedes();
    updateCat();
    document.getElementById('wiz-draft')?.setAttribute('hidden', '');
    go(1);
  }

  const sendBtn = document.getElementById('wiz-send') as HTMLButtonElement | null;
  sendBtn?.addEventListener('click', async () => {
    for (let s = 1; s <= 3; s += 1) {
      if (!validStep(s)) { go(s); showErr(s, ERR_MSG[s]); return; }
    }
    const term = $('wiz-terminos') as HTMLInputElement | null;
    if (!term?.checked) { showErr(4, 'Debes aceptar los términos para enviar.'); return; }
    const category = categoriaProvisional(val('wiz-nacimiento'));
    if (!category) { go(2); showErr(2); return; }
    if (!sendBtn) return;

    const payload = {
      firstName: val('wiz-nombre'),
      lastName: val('wiz-apellidos'),
      birthDate: val('wiz-nacimiento'),
      category,
      sede,
      parentName: val('wiz-tutor'),
      parentRelationship: parentesco,
      parentPhone: val('wiz-tel'),
      parentEmail: val('wiz-email'),
      school: val('wiz-colegio').slice(0, 120),
      parentOccupation: val('wiz-ocupacion').slice(0, 120),
      address: val('wiz-dir'),
      medicalNotes: val('wiz-med'),
      secondGuardian: tutor2on && val('wiz-tutor2-nombre')
        ? { name: val('wiz-tutor2-nombre'), relationship: parentesco2, phone: val('wiz-tutor2-tel') }
        : null,
      sitio_web: val('wiz-sitio'),
      terminos: true,
    };

    sendBtn.disabled = true;
    sendBtn.textContent = 'Enviando…';
    try {
      const res = await fetch('/api/inscripcion-plataforma', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const out = (await res.json().catch(() => null)) as { ok?: boolean; error?: string } | null;
      if (res.ok && out?.ok) {
        try { localStorage.removeItem(DRAFT_KEY); } catch { /* noop */ }
        document.getElementById('wiz-draft')?.setAttribute('hidden', '');
        const okmsg = document.getElementById('wiz-okmsg');
        if (okmsg) okmsg.textContent = `${payload.firstName} quedó preinscrito en ${sedeNombre || sede} (${category}, provisional). Te contactaremos por WhatsApp en menos de 48 horas.`;
        go(5);
      } else {
        showErr(4, out?.error ?? 'No pudimos enviar tu inscripción. Inténtalo de nuevo.');
      }
    } catch {
      showErr(4, 'Sin conexión. Revisa tu internet e inténtalo de nuevo.');
    } finally {
      sendBtn.disabled = false;
      sendBtn.textContent = 'Enviar inscripción';
    }
  });

  loadDraft();
</script>

</Base>

