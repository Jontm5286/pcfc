---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FaqSection from '../components/FaqSection.astro';
import SedeCards from '../components/SedeCards.astro';
import SedesMap from '../components/SedesMap.astro';
import ProcessSteps from '../components/inscribete/ProcessSteps.astro';
import WizardForm from '../components/inscribete/WizardForm.astro';
import TrustSignals from '../components/inscribete/TrustSignals.astro';
import { getSedes } from '../data/sedes';

export const prerender = true;

const sedes = getSedes();

// Prerender: se sirve el estado por defecto; ?sede= y ?prueba= se aplican en
// cliente con el <script> al final de esta página (paridad con el SSR previo).
// Sede preseleccionada vía ?sede=<slug> (desde /area-deportiva o "Elegir esta
// sede"); solo slugs de getSedes(), el resto se ignora (validado en cliente).
const sedePreseleccionada = '';

// Clase de prueba gratis: /inscribete?prueba=1 (desde /club y sedes).
const modoPrueba = false;

// NOTA: ya no se pide categoría en el formulario (decisión del club).
// El wizard deriva una categoría PROVISIONAL desde la fecha de nacimiento
// solo para cumplir el contrato del endpoint de plataforma (CategoryType),
// que exige `category`. El coordinador la confirma al activar.
// TABLA EDAD→CATEGORÍA PROVISIONAL (a validar por el club):
//   4–5 años → Sub-6 (Iniciación) | 6–7 → Sub-8 (Pre-Benjamín)
//   8–9 → Sub-10 (Benjamín) | 10–11 → Sub-12 (Alevín)
//   12–13 → Sub-14 (Infantil Mayor) | 14 → Sub-15 (Infantil)
//   15–17 → Sub-18 (Juvenil)
//   <4 → Sub-6 · >17 → Sub-18 · Femenino Juvenil nunca se auto-deriva.
---

<Base
  title="Inscríbete"
  description="Inscríbete en Punta Cana FC. Completa el formulario y un entrenador se pondrá en contacto en menos de 24 horas."
>
  <!-- ============================================================
       HERO — section con SectionHeader eyebrow + título + subtitle
       ============================================================ -->
  <PageHero
    eyebrow={modoPrueba
      ? 'Clase de prueba gratis · Temporada 2026'
      : 'Inscripciones abiertas · Temporada 2026'}
    title={modoPrueba ? 'Reserva su clase<br />de prueba' : 'Únete a la academia<br />del Caribe'}
    lede={modoPrueba
      ? 'Completa el formulario y el coordinador de la sede te contacta para agendar la clase de prueba gratis. Sin compromiso.'
      : 'Da el primer paso. Completa el formulario y un entrenador de PCFC se pondrá en contacto en menos de 24 horas.'}
    image="jugadores-cancha"
    alt="Jugadores de Punta Cana FC entrenando en cancha al atardecer"
    titleClass="text-[clamp(2.5rem,6.5vw,4.75rem)] mb-5"
    ledeClass="max-w-[56ch]"
  />

  <!-- ============================================================
       CONTENT — grid 2 columnas: info (proceso + requisitos) | formulario
       ============================================================ -->
  <section class="section">
    <div class="container-x">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-12 lg:gap-16 items-start">
        <!-- ── Columna izquierda: proceso + requisitos ── -->
        <div class="space-y-10">
          <ProcessSteps />
        </div>

        <!-- ── Columna derecha: wizard de inscripción ── -->
        <WizardForm
          sedes={sedes}
          sedePreseleccionada={sedePreseleccionada}
          modoPrueba={modoPrueba}
        />
      </div>
    </div>
  </section>

  <!-- ============================================================
       SEDES — dónde entrenará el jugador
       ============================================================ -->
  <section class="section bg-navy-05" id="sedes">
    <div class="container-x">
      <p class="eyebrow">Dónde entrenamos</p>
      <h2 class="h-section mb-2">Nuestras sedes</h2>
      <p class="lede mb-10 max-w-[60ch]">
        Elige tu sede más cercana en el formulario. Los horarios se confirman por sede al
        inscribirte.
      </p>

      <SedeCards sedes={sedes} variant="inscribete" />

      <SedesMap />
    </div>
  </section>

  <!-- ============================================================
       TRUST SIGNALS — social proof antes del footer
       ============================================================ -->
  <TrustSignals />

  <!-- ============================================================
       FAQ — dudas frecuentes antes del footer
       ============================================================ -->
  <FaqSection
    eyebrow="DUDAS FRECUENTES"
    title="¿Listo para unirte? Primero resolvemos tus dudas"
    faqs={[
      {
        question: '¿Cómo funciona la clase de prueba?',
        answer:
          'La clase de prueba es gratis. Se agenda con el coordinador de la sede: completa el formulario, elige la sede y te contactamos por WhatsApp para confirmar día y hora. No necesitas experiencia previa.',
      },
      {
        question: '¿Cuál es la mensualidad y qué incluye?',
        answer:
          'La cuota mensual incluye 3 entrenamientos semanales con entrenadores certificados por la UEFA, uso de nuestras instalaciones (4 canchas, gimnasio y aula académica), material deportivo y participación en torneos internos. Las becas de mérito están disponibles para jugadores destacados.',
      },
      {
        question: '¿Puedo inscribirme si mi hijo nunca ha jugado fútbol?',
        answer:
          'Sí. Contamos con una categoría de Pre-Formativas (4-8 años) orientada al primer contacto con el balón, trabajo de coordinación y motricidad, y amor por el juego. No se requiere experiencia previa.',
      },
      {
        question: '¿Qué documentos debo presentar?',
        answer:
          'Acta de nacimiento, cédula o pasaporte del jugador, cédula del representante legal, certificado médico reciente (no mayor a 6 meses) y 2 fotos tipo carnet.',
      },
      {
        question: '¿Tienen sedes fuera de Punta Cana?',
        answer:
          'Nuestra academia opera desde nuestras instalaciones principales en Punta Cana. En temporada también atendemos en Bávaro, Cap Cana, Higüey y La Romana, con sesiones grupales programadas para jugadores de esas zonas.',
      },
    ]}
    contactEmail="admisiones@puntacanafc.com"
    contactPhone="+1 829-246-4756"
  />

  <!-- ?sede= / ?prueba= en cliente (página prerenderizada): aplica la misma
       preselección y copy que antes se resolvía en servidor. Sin params, la
       página queda en su estado por defecto. NOTA: los textos deben coincidir
       con las props de PageHero/WizardForm de arriba y la clave del borrador
       con WizardForm.astro (DRAFT_KEY). -->
  <script>
    (() => {
      const params = new URLSearchParams(window.location.search);
      const sedeParam = (params.get('sede') ?? '').trim().toLowerCase();
      const esPrueba = params.get('prueba') === '1';
      if (!sedeParam && !esPrueba) return;

      const root = document.getElementById('formulario');

      // Sede: solo slugs con botón real; el borrador guardado manda (paridad
      // con el SSR, donde loadDraft() ganaba a la preselección del servidor).
      if (sedeParam) {
        const btn = document.querySelector<HTMLElement>(
          '#wiz-sedes button[data-slug="' + CSS.escape(sedeParam) + '"]'
        );
        let draftSede = '';
        try {
          const d = JSON.parse(
            window.localStorage.getItem('pcfc-inscripcion-draft-v1') ?? '{}'
          );
          if (d && typeof d.sede === 'string') draftSede = d.sede;
        } catch {
          /* almacenamiento no disponible */
        }
        const draftValido =
          !!draftSede &&
          !!document.querySelector(
            '#wiz-sedes button[data-slug="' + CSS.escape(draftSede) + '"]'
          );
        if (btn && !draftValido) {
          if (root) root.dataset.sedePreselect = sedeParam;
          btn.click();
        }
      }

      // Modo prueba (?prueba=1): mismo copy del servidor.
      if (esPrueba) {
        if (root) root.dataset.modoPrueba = '1';
        const hero = document.querySelector('.hero-with-image');
        if (hero) {
          const eyebrow = hero.querySelector('.eyebrow');
          if (eyebrow)
            eyebrow.textContent = 'Clase de prueba gratis · Temporada 2026';
          const h1 = hero.querySelector('h1');
          if (h1) h1.innerHTML = 'Reserva su clase<br />de prueba';
          const lede = hero.querySelector('.lede');
          if (lede)
            lede.innerHTML =
              'Completa el formulario y el coordinador de la sede te contacta para agendar la clase de prueba gratis. Sin compromiso.';
        }
        if (root) {
          const wizEyebrow = root.querySelector('.wiz-eyebrow');
          if (wizEyebrow)
            wizEyebrow.textContent = 'Clase de prueba · 4 pasos cortos';
          const h2 = root.querySelector('h2');
          if (h2) h2.textContent = 'Reserva su clase de prueba';
          if (!root.querySelector('.wiz-trial')) {
            const trial = document.createElement('p');
            trial.className = 'wiz-trial';
            trial.textContent =
              'Incluye una clase de prueba gratis. El coordinador de la sede te contacta para agendar.';
            const sub = root.querySelector('.wiz-sub');
            if (sub) sub.before(trial);
            else root.prepend(trial);
          }
          const send = document.getElementById('wiz-send');
          if (send) send.textContent = 'Solicitar clase de prueba';
          const okTitle = root.querySelector('[data-step="5"] .wiz-title');
          if (okTitle) okTitle.textContent = '¡Solicitud recibida!';
          const okMsg = document.getElementById('wiz-okmsg');
          if (okMsg)
            okMsg.textContent =
              'Te contactaremos por WhatsApp en menos de 48 horas para agendar la clase de prueba gratis.';
        }
      }
    })();
  </script>
</Base>
