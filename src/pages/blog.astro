---
import Base from '../layouts/Base.astro';
import StockImage from '../components/StockImage.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const blogPosts = await getCollection('blog');
---

<Base title="Blog" description="Noticias, eventos y novedades de Punta Cana FC. Mantente al día con la academia.">
  <!-- Hero -->
  <section class="hero-with-image text-white pt-[clamp(6rem,12vw,9rem)] pb-[clamp(4rem,8vw,6rem)] relative">
    <StockImage
      name="jugadores-cancha"
      alt="Jugadores de Punta Cana FC entrenando en cancha al atardecer"
      className="absolute inset-0 w-full h-full object-cover"
      width={1600}
      height={1200}
      loading="eager"
    />
    <div class="hero-overlay"></div>
    <div class="container-x">
      <p class="eyebrow eyebrow--on-navy">Blog</p>
      <h1 class="blog-hero__title">Noticias y Novedades</h1>
      <p class="blog-hero__desc">
        Mantente al día con todo lo que pasa en PCFC.
      </p>
    </div>
  </section>

  <!-- Blog Content -->
  <section class="section">
    <div class="container-x">
      <div class="blog-layout">
        <!-- Main Content -->
        <div class="blog-main">
          {
            blogPosts.length === 0 ? (
              <div class="blog-empty">
                <div class="empty-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2 2 0 0 1 2 17.5V8a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12"/><path d="M16 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4"/><path d="M4 8V6a2 2 0 0 1 2-2h8"/></svg>
                </div>
                <h3>Las historias de PCFC, pronto aquí.</h3>
                <p>
                  Estamos preparando contenido exclusivo para ti.
                  Noticias, entrevistas, highlights y mucho más sobre la
                  academia que está formando los campeones del mañana.
                </p>
                <a href="/" class="btn btn--primary">Volver al Inicio</a>
              </div>
            ) : (
              blogPosts
                .sort((a,b)=>b.data.publishedAt.localeCompare(a.data.publishedAt))
                .map(({data,id})=>{
                  const {title,excerpt,body,category}=data;
                  // mapa de clases CSS para badge por categoría (mantiene diseño fijo)
                  const categoryClass={
                    'Noticias':'badge--sky',
                    'Torneos':'badge--form-baja',
                    'Entrevistas':'badge--form-alta',
                    'Resultados':'badge--pre',
                    'Eventos':'badge--elite',
                  };
                  return (
                    <article class="blog-article" key={id}>
                      <h2 class="blog-article__title">{title}</h2>
                      <p class="blog-article__meta">
                        <span class={categoryClass[data.category] ?? 'badge--sky'}>{category}</span>
                        <span class="blog-article__date">{data.publishedAt}</span>
                      </p>
                      <p class="blog-article__excerpt">{excerpt}</p>
                      <div class="blog-article__body">
                        {body.map((p, i) => (
                          <p class="blog-article__paragraph" key={i}>
                            {p}
                          </p>
                        ))}
                      </div>
                      {(data.ctaPrimary || data.ctaSecondary) && (
                        <div class="blog-article__cta">
                          {data.ctaPrimary && (
                            <a href={data.ctaPrimary.href} class="btn btn--sky">
                              {data.ctaPrimary.label}
                            </a>
                          )}
                          {data.ctaSecondary && (
                            <a href={data.ctaSecondary.href} class="btn btn--outline btn--lg ml-2">
                              {data.ctaSecondary.label}
                            </a>
                          )}
                        </div>
                      )}
                    </article>
                  );
                })
        )}
        </div>

        <!-- Sidebar -->
        <aside class="blog-sidebar">
          <div class="sidebar-card">
            <h4 class="sidebar-heading">Categorías</h4>
            <ul class="sidebar-list">
              <li>
                <a href="#" class="sidebar-link">
                  <span class="badge badge--sky">Noticias</span>
                </a>
              </li>
              <li>
                <a href="#" class="sidebar-link">
                  <span class="badge badge--form-baja">Torneos</span>
                </a>
              </li>
              <li>
                <a href="#" class="sidebar-link">
                  <span class="badge badge--form-alta">Entrevistas</span>
                </a>
              </li>
              <li>
                <a href="#" class="sidebar-link">
                  <span class="badge badge--pre">Resultados</span>
                </a>
              </li>
              <li>
                <a href="#" class="sidebar-link">
                  <span class="badge badge--elite">Eventos</span>
                </a>
              </li>
            </ul>
          </div>

          <div class="sidebar-card">
            <h4 class="sidebar-heading">Síguenos</h4>
            <div class="social-links">
              <a href="https://instagram.com/puntacanafc" class="social-link" target="_blank" rel="noopener noreferrer">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-label="Instagram"><path d="M12 2.16c3.17 0 3.58.01 4.75.06 1.09.05 1.77.24 2.2.4a4.42 4.42 0 0 1 1.59 1.01 4.42 4.42 0 0 1 1.01 1.59c.16.43.35 1.11.4 2.2.05 1.17.06 1.58.06 4.75s-.01 3.58-.06 4.75c-.05 1.09-.24 1.77-.4 2.2a4.42 4.42 0 0 1-1.01 1.59 4.42 4.42 0 0 1-1.59 1.01c-.43.16-1.11.35-2.2.4-1.17.05-1.58.06-4.75.06s-3.58-.01-4.75-.06c-1.09-.05-1.77-.24-2.2-.4a4.42 4.42 0 0 1-1.59-1.01 4.42 4.42 0 0 1-1.01-1.59c-.16-.43-.35-1.11-.4-2.2-.05-1.17-.06-1.58-.06-4.75s.01-3.58.06-4.75c.05-1.09.24-1.77.4-2.2a4.42 4.42 0 0 1 1.01-1.59 4.42 4.42 0 0 1 1.59-1.01c.43-.16 1.11-.35 2.2-.4 1.17-.05 1.58-.06 4.75-.06m0-2.16c-3.17 0-3.59.01-4.77.06-1.11.05-1.84.25-2.37.42a4.54 4.54 0 0 0-1.64 1.04 4.54 4.54 0 0 0-1.04 1.64c-.17.53-.37 1.26-.42 2.37-.05 1.18-.06 1.6-.06 4.77s.01 3.59.06 4.77c.05 1.11.25 1.84.42 2.37a4.54 4.54 0 0 0 1.04 1.64 4.54 4.54 0 0 0 1.64 1.04c.53.17 1.26.37 2.37.42 1.18.05 1.6.06 4.77.06s3.59-.01 4.77-.06c1.11-.05 1.84-.25 2.37-.42a4.54 4.54 0 0 0 1.64-1.04 4.54 4.54 0 0 0 1.04-1.64c.17-.53.37-1.26.42-2.37.05-1.18.06-1.6.06-4.77s-.01-3.59-.06-4.77c-.05-1.11-.25-1.84-.42-2.37a4.54 4.54 0 0 0-1.04-1.64 4.54 4.54 0 0 0-1.64-1.04c-.53-.17-1.26-.37-2.37-.42-1.18-.05-1.6-.06-4.77-.06z"/><circle cx="12" cy="12" r="3.5"/></svg>
                <span>@puntacanafc</span>
              </a>
              <a href="https://facebook.com/puntacanafc" class="social-link" target="_blank" rel="noopener noreferrer">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-label="Facebook"><path d="M22.675 0h-21.35C.59 0 0 .59 0 1.32v21.36C0 23.41.59 24 1.32 24h11.5v-9.29h-3.08V11.15h3.08V9.19c0-3.06 1.86-4.75 4.63-4.75 1.33 0 2.67.24 2.67.24v2.94h-1.88c-1.48 0-1.95 1.05-1.95 1.92v2.31h3.58l-.59 2.82h-3V24h6.09c.73 0 1.32-.59 1.32-1.32V1.32C24 .59 23.41 0 22.675 0z"/></svg>
                <span>Punta Cana FC</span>
              </a>
              <a href="https://tiktok.com/@puntacanafc" class="social-link" target="_blank" rel="noopener noreferrer">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-label="TikTok"><path d="M19 3.41c-.77.1-1.54.2-2.31.3.85-.51 1.45-1.3 1.75-2.25-.8.48-1.68.8-2.6.97a4.18 4.18 0 0 0-7.82 2.66c0 3.24 2.62 5.9 6.1 6.55a6.3 6.3 0 0 1-1.49 1.2l-.02.02a6.14 6.14 0 0 0 6.88 4.26 6.3 6.3 0 0 0 1.49-1.2l.02.02A6.28 6.28 0 0 0 21 17.83a6.4 6.4 0 0 1-1.41-1.2 6.07 6.07 0 0 0 4.19-5.95V8.9a4.18 4.18 0 0 0-3.21-4.03 8.1 8.1 0 0 0-3.88-1.54z"/></svg>
                <span>@puntacanafc</span>
              </a>
            </div>
          </div>

          <div class="sidebar-card cta-sidebar">
            <h4 class="sidebar-heading sidebar-heading--light">¿Quieres Unirte?</h4>
            <p class="cta-desc">
              Las inscripciones están abiertas para todas las categorías.
            </p>
            <a href="/inscribete" class="btn btn--sky btn--on-navy btn--lg cta-btn">Inscribirse</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-with-image {
    background-size: cover;
    background-position: center center;
    background-attachment: scroll;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(7, 29, 59, 0.75) 0%, rgba(7, 29, 59, 0.85) 100%);
    pointer-events: none;
  }

  .blog-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-white);
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .blog-hero__desc {
    font-size: 1.125rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.78);
    max-width: 600px;
  }

  .blog-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 3rem;
  }

  .blog-empty {
    text-align: center;
    padding: 5rem 2rem;
    background: var(--color-pure-white);
    border: 1px solid var(--color-navy-10);
    border-radius: 16px;
  }

  .empty-icon {
    font-size: 4rem;
    color: var(--color-sky);
    opacity: 0.3;
    margin-bottom: 1.5rem;
  }

  .blog-empty h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    text-transform: uppercase;
    color: var(--color-navy);
    margin-bottom: 1rem;
  }

  .blog-empty p {
    color: var(--color-navy-60);
    max-width: 400px;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }

  /* Sidebar */
  .sidebar-card {
    background: var(--color-pure-white);
    border: 1px solid var(--color-navy-10);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .sidebar-heading {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-sky);
    margin-bottom: 1rem;
  }

  .sidebar-heading--light {
    color: var(--color-white);
  }

  .sidebar-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    transition: opacity 200ms ease;
  }

  .sidebar-link:hover {
    opacity: 0.75;
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-navy-60);
    font-size: 0.9rem;
    transition: color 200ms ease;
  }

  .social-link:hover {
    color: var(--color-sky);
  }

  .social-link svg {
    width: 20px;
    text-align: center;
    color: var(--color-navy-30);
    transition: color 200ms ease;
  }

  .social-link:hover svg {
    color: var(--color-sky);
  }

  .cta-sidebar {
    background: linear-gradient(135deg, rgba(66, 154, 192, 0.08), rgba(26, 138, 106, 0.05));
    border-color: rgba(66, 154, 192, 0.2);
    text-align: center;
  }

  .cta-desc {
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.9rem;
    margin-bottom: 1.25rem;
    line-height: 1.6;
  }

  .cta-btn {
    width: 100%;
  }

  @media (max-width: 992px) {
    .blog-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
