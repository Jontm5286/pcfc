---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { getCollection } from 'astro:content';

// FASE 3: índice real desde la colección local `blog` (file-based, sin EmDash).
const allPosts = (await getCollection('blog'))
  .filter((p) => p.data.published !== false)
  .sort((a, b) => +new Date(b.data.publishedAt) - +new Date(a.data.publishedAt));

function slugify(s: string): string {
  return s
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

// Categorías reales derivadas de los posts (únicas + conteo).
const catMap = new Map<string, { label: string; count: number }>();
for (const p of allPosts) {
  const label = p.data.category || 'Noticias';
  const key = slugify(label);
  const prev = catMap.get(key);
  catMap.set(key, { label: prev?.label ?? label, count: (prev?.count ?? 0) + 1 });
}
const categories = [...catMap.entries()].map(([slug, v]) => ({ slug, ...v }));

// Filtrado funcional vía ?categoria=<slug> (output: server → por request).
const activeCat = Astro.url.searchParams.get('categoria') ?? '';
const posts = activeCat
  ? allPosts.filter((p) => slugify(p.data.category || 'Noticias') === activeCat)
  : allPosts;

function badgeClass(label: string): string {
  const s = slugify(label);
  if (s === 'torneos') return 'badge--form-baja';
  if (s === 'entrevistas') return 'badge--form-alta';
  if (s === 'resultados') return 'badge--pre';
  return 'badge--sky';
}

function formatDate(iso: string): string {
  const d = new Date(iso + (iso.length === 10 ? 'T12:00:00' : ''));
  return Number.isNaN(+d)
    ? iso
    : d.toLocaleDateString('es-DO', { day: 'numeric', month: 'short', year: 'numeric' });
}

function postUrl(p: (typeof allPosts)[number]): string {
  return `/blog/${p.data.slug}`;
}
---

<Base
  title="Blog"
  description="Noticias, eventos y novedades de Punta Cana FC. Mantente al día con la academia."
>
  <!-- Hero -->
  <PageHero
    eyebrow="Blog"
    title="Noticias y Novedades"
    lede="Mantente al día con todo lo que pasa en PCFC."
    image="jugadores-cancha"
    alt="Jugadores de Punta Cana FC entrenando en cancha al atardecer"
  />

  <!-- Blog Content -->
  <section class="section">
    <div class="container-x">
      <div class="blog-layout">
        <!-- Main Content -->
        <div class="blog-main">
          {
            posts.length === 0 ? (
              <div class="blog-empty">
                <div class="empty-icon">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="48"
                    height="48"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <>
                      <path d="M4 19.5A2 2 0 0 1 2 17.5V8a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12" />
                      <path d="M16 4h4a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-4" />
                      <path d="M4 8V6a2 2 0 0 1 2-2h8" />
                    </>
                  </svg>
                </div>
                <h3>Sin artículos en esta categoría.</h3>
                <p>No hay publicaciones con este filtro. Explora el resto del blog.</p>
                <a href="/blog" class="btn btn--primary">
                  Ver todos
                </a>
              </div>
            ) : (
              <div class="blog-grid">
                {posts.map((p) => (
                  <article class="blog-card">
                    <div class="blog-card__top">
                      <span class={`badge ${badgeClass(p.data.category || 'Noticias')}`}>
                        {p.data.category || 'Noticias'}
                      </span>
                      <time datetime={p.data.publishedAt} class="blog-card__date">
                        {formatDate(p.data.publishedAt)}
                      </time>
                    </div>
                    <h3 class="blog-card__title">
                      <a href={postUrl(p)}>{p.data.title}</a>
                    </h3>
                    {p.data.excerpt && <p class="blog-card__excerpt">{p.data.excerpt}</p>}
                    <a href={postUrl(p)} class="blog-card__link">
                      Leer artículo <span aria-hidden="true">→</span>
                    </a>
                  </article>
                ))}
              </div>
            )
          }
        </div>

        <!-- Sidebar -->
        <aside class="blog-sidebar">
          <div class="sidebar-card">
            <h4 class="sidebar-heading">Categorías</h4>
            <ul class="sidebar-list">
              <li>
                <a
                  href="/blog"
                  class="sidebar-link"
                  aria-current={activeCat === '' ? 'page' : undefined}
                >
                  <span class="badge badge--sky"
                    >Todas{activeCat === '' ? ` (${allPosts.length})` : ''}</span
                  >
                  {activeCat !== '' && <span class="sidebar-count">{allPosts.length}</span>}
                </a>
              </li>
              {
                categories.map((c) => (
                  <li>
                    <a
                      href={activeCat === c.slug ? '/blog' : `/blog?categoria=${c.slug}`}
                      class="sidebar-link"
                      aria-current={activeCat === c.slug ? 'page' : undefined}
                    >
                      <span class={`badge ${badgeClass(c.label)}`}>{c.label}</span>
                      <span class="sidebar-count">{c.count}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="sidebar-card">
            <h4 class="sidebar-heading">Síguenos</h4>
            <div class="social-links">
              <a
                href="https://instagram.com/puntacanafc"
                class="social-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-label="Instagram"
                  ><path
                    d="M12 2.16c3.17 0 3.58.01 4.75.06 1.09.05 1.77.24 2.2.4a4.42 4.42 0 0 1 1.59 1.01 4.42 4.42 0 0 1 1.01 1.59c.16.43.35 1.11.4 2.2.05 1.17.06 1.58.06 4.75s-.01 3.58-.06 4.75c-.05 1.09-.24 1.77-.4 2.2a4.42 4.42 0 0 1-1.01 1.59 4.42 4.42 0 0 1-1.59 1.01c-.43.16-1.11.35-2.2.4-1.17.05-1.58.06-4.75.06s-3.58-.01-4.75-.06c-1.09-.05-1.77-.24-2.2-.4a4.42 4.42 0 0 1-1.59-1.01 4.42 4.42 0 0 1-1.01-1.59c-.16-.43-.35-1.11-.4-2.2-.05-1.17-.06-1.58-.06-4.75s.01-3.58.06-4.75c.05-1.09.24-1.77.4-2.2a4.42 4.42 0 0 1 1.01-1.59 4.42 4.42 0 0 1 1.59-1.01c.43-.16 1.11-.35 2.2-.4 1.17-.05 1.58-.06 4.75-.06m0-2.16c-3.17 0-3.59.01-4.77.06-1.11.05-1.84.25-2.37.42a4.54 4.54 0 0 0-1.64 1.04 4.54 4.54 0 0 0-1.04 1.64c-.17.53-.37 1.26-.42 2.37-.05 1.18-.06 1.6-.06 4.77s.01 3.59.06 4.77c.05 1.11.25 1.84.42 2.37a4.54 4.54 0 0 0 1.04 1.64 4.54 4.54 0 0 0 1.64 1.04c.53.17 1.26.37 2.37.42 1.18.05 1.6.06 4.77.06s3.59-.01 4.77-.06c1.11-.05 1.84-.25 2.37-.42a4.54 4.54 0 0 0 1.64-1.04 4.54 4.54 0 0 0 1.04-1.64c.17-.53.37-1.26.42-2.37.05-1.18.06-1.6.06-4.77s-.01-3.59-.06-4.77c-.05-1.11-.25-1.84-.42-2.37a4.54 4.54 0 0 0-1.04-1.64 4.54 4.54 0 0 0-1.64-1.04c-.53-.17-1.26-.37-2.37-.42-1.18-.05-1.6-.06-4.77-.06z"
                  ></path><circle cx="12" cy="12" r="3.5"></circle></svg
                >
                <span>@puntacanafc</span>
              </a>
              <a
                href="https://facebook.com/puntacanafc"
                class="social-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-label="Facebook"
                  ><path
                    d="M22.675 0h-21.35C.59 0 0 .59 0 1.32v21.36C0 23.41.59 24 1.32 24h11.5v-9.29h-3.08V11.15h3.08V9.19c0-3.06 1.86-4.75 4.63-4.75 1.33 0 2.67.24 2.67.24v2.94h-1.88c-1.48 0-1.95 1.05-1.95 1.92v2.31h3.58l-.59 2.82h-3V24h6.09c.73 0 1.32-.59 1.32-1.32V1.32C24 .59 23.41 0 22.675 0z"
                  ></path></svg
                >
                <span>Punta Cana FC</span>
              </a>
            </div>
          </div>

          <div class="sidebar-card cta-sidebar">
            <h4 class="sidebar-heading sidebar-heading--light">¿Quieres Unirte?</h4>
            <p class="cta-desc">Las inscripciones están abiertas para todas las categorías.</p>
            <a href="/inscribete" class="btn btn--sky btn--on-navy btn--lg cta-btn">Inscribirse</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-with-image {
    background-size: cover;
    background-position: center center;
    background-attachment: scroll;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(7, 29, 59, 0.75) 0%, rgba(7, 29, 59, 0.85) 100%);
    pointer-events: none;
  }

  .blog-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 3rem;
  }

  .blog-empty {
    text-align: center;
    padding: 5rem 2rem;
    background: var(--color-pure-white);
    border: 1px solid var(--color-navy-10);
    border-radius: 16px;
  }

  .empty-icon {
    font-size: 4rem;
    color: var(--color-sky);
    opacity: 0.3;
    margin-bottom: 1.5rem;
  }

  .blog-empty h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    text-transform: uppercase;
    color: var(--color-navy);
    margin-bottom: 1rem;
  }

  .blog-empty p {
    color: var(--color-navy-60);
    max-width: 400px;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }

  /* Sidebar */
  .sidebar-card {
    background: var(--color-pure-white);
    border: 1px solid var(--color-navy-10);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .sidebar-heading {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-sky);
    margin-bottom: 1rem;
  }

  .sidebar-heading--light {
    color: var(--color-navy);
  }

  .sidebar-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: opacity 200ms ease;
  }

  .sidebar-link:hover {
    opacity: 0.75;
  }

  .sidebar-link[aria-current='page'] {
    font-weight: 700;
  }

  .sidebar-count {
    font-size: 0.75rem;
    color: var(--color-navy-30);
  }

  /* Post cards (colección real) */
  .blog-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .blog-card {
    background: var(--color-pure-white);
    border: 1px solid var(--color-navy-10);
    border-radius: 12px;
    padding: 1.75rem;
  }

  .blog-card__top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.875rem;
  }

  .blog-card__date {
    font-size: 0.8rem;
    color: var(--color-navy-30);
  }

  .blog-card__title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 400;
    text-transform: uppercase;
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .blog-card__title a {
    color: var(--color-navy);
    text-decoration: none;
  }

  .blog-card__title a:hover {
    color: var(--color-sky);
  }

  .blog-card__excerpt {
    color: var(--color-navy-60);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .blog-card__link {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-sky);
    text-decoration: none;
  }

  .blog-card__link:hover {
    text-decoration: underline;
  }

  .social-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-navy-60);
    font-size: 0.9rem;
    transition: color 200ms ease;
  }

  .social-link:hover {
    color: var(--color-sky);
  }

  .social-link svg {
    width: 20px;
    text-align: center;
    color: var(--color-navy-30);
    transition: color 200ms ease;
  }

  .social-link:hover svg {
    color: var(--color-sky);
  }

  .cta-sidebar {
    background: linear-gradient(135deg, rgba(66, 154, 192, 0.08), rgba(26, 138, 106, 0.05));
    border-color: rgba(66, 154, 192, 0.2);
    text-align: center;
  }

  .cta-desc {
    color: var(--color-navy-60);
    font-size: 0.9rem;
    margin-bottom: 1.25rem;
    line-height: 1.6;
  }

  .cta-btn {
    width: 100%;
  }

  @media (max-width: 992px) {
    .blog-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
