---
import Base from '../layouts/Base.astro';
import StockImage from '../components/StockImage.astro';

const products = [
  {
    id: 1,
    name: 'Camiseta Titular 2026',
    category: 'Uniforme Oficial',
    price: 1250,
    color: 'var(--color-white)',
    accent: 'var(--color-navy)',
    badge: 'Más Vendido',
    badgeClass: 'badge--sky',
  },
  {
    id: 2,
    name: 'Short Oficial',
    category: 'Uniforme Oficial',
    price: 850,
    color: 'var(--color-white)',
    accent: 'var(--color-navy)',
    badge: null,
    badgeClass: null,
  },
  {
    id: 3,
    name: 'Calcetas Técnicas (3 pares)',
    category: 'Accesorios',
    price: 650,
    color: 'var(--color-white)',
    accent: 'var(--color-navy)',
    badge: null,
    badgeClass: null,
  },
  {
    id: 4,
    name: 'Pelota de Entrenamiento PCFC',
    category: 'Entrenamiento',
    price: 1200,
    color: 'var(--color-white)',
    accent: 'var(--color-navy)',
    badge: 'Nuevo',
    badgeClass: 'badge--pre',
  },
];

const formatPrice = (price: number) => `$${price.toLocaleString('es-DO')}`;
---

<Base title="Tienda" description="Tienda oficial de Punta Cana FC. Equipamiento y mercancía del club.">
  <!-- Hero -->
  <section class="hero-with-image text-white pt-[clamp(6rem,12vw,9rem)] pb-[clamp(4rem,8vw,6rem)] relative">
    <StockImage
      name="jugadores-cancha"
      alt="Jugadores de Punta Cana FC en cancha con el equipamiento oficial del club"
      className="absolute inset-0 w-full h-full object-cover object-[center_30%]"
      width={1600}
      height={1200}
      loading="eager"
    />
    <div class="hero-overlay"></div>
    <div class="container-x relative z-10">
      <p class="eyebrow eyebrow--on-navy">Tienda PCFC</p>
      <h1 class="h-display h-display--on-navy text-[clamp(2.5rem,6vw,4.5rem)] mb-5 max-w-[16ch]">
        Equipamiento Oficial
      </h1>
      <p class="lede lede--on-navy max-w-[52ch]">
        Todo lo que necesitas para jugar como un campeón.
      </p>
    </div>
  </section>

  <!-- Products Grid -->
  <section class="section">
    <div class="container-x">
      <div class="products-grid">
        {products.map((product) => (
          <article class="product-card">
            <div class="product-image bg-pure-white border-2 border-navy-10">
              <div class="product-swatch bg-navy flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-label="icon"><path d="M12 2L2 7v10c0 2.21 1.79 4 4 4h12c2.21 0 4-1.79 4-4V7l-10-5z"/></svg>
              </div>
              {product.badge && (
                <span class={`badge ${product.badgeClass} product-badge`}>{product.badge}</span>
              )}
            </div>
            <div class="product-info">
              <p class="product-category">{product.category}</p>
              <h3 class="product-name">{product.name}</h3>
              <p class="product-price">{formatPrice(product.price)}</p>
              <button class="btn btn--sky btn--full" type="button">Añadir al Carrito</button>
            </div>
          </article>
        ))}
      </div>

      <div class="tienda-cta">
        <p class="tienda-cta__text">
          ¿No encuentras lo que buscas? Estamos preparando más productos para ti.
        </p>
        <a href="/inscribete" class="btn btn--primary btn--lg">
          Inscribirse en PCFC
          <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Footer Strip -->
  <section class="tienda-footer-strip">
    <div class="container-x">
      <div class="footer-strip-inner">
        <div>
          <h3 class="footer-strip__heading">¿Quieres formar parte del club?</h3>
          <p class="footer-strip__desc">Las inscripciones están abiertas para todas las categorías.</p>
        </div>
        <a href="/inscribete" class="btn btn--sky btn--on-navy btn--lg">Inscribirse Ahora</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .tienda-hero {
    padding: 10rem 0 5rem;
    background: linear-gradient(135deg, var(--color-navy-dark), var(--color-navy));
    border-bottom: 1px solid var(--color-navy-10);
  }

  .tienda-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--color-white);
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .tienda-hero__desc {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-white);
    opacity: 0.80;
    max-width: 600px;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .product-card {
    background: var(--color-pure-white);
    border: 1px solid var(--color-navy-10);
    border-radius: 16px;
    overflow: hidden;
    transition: box-shadow 200ms ease, border-color 200ms ease;
  }

  .product-card:hover {
    box-shadow: 0 12px 40px rgba(0, 40, 92, 0.12);
    border-color: var(--color-sky-30);
  }

  .product-image {
    aspect-ratio: 1/1;
    border: 2px solid;
    border-radius: 14px 14px 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 2rem;
  }

  .product-swatch {
    width: 80px;
    height: 80px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
  }

  .product-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
  }

  .product-info {
    padding: 1.5rem;
  }

  .product-category {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-navy-60);
    margin-bottom: 0.5rem;
  }

  .product-name {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--color-navy);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .product-price {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 1.25rem;
  }

  .btn--full {
    width: 100%;
  }

  .tienda-cta {
    text-align: center;
    padding: 3rem 2rem;
    background: var(--color-navy-05);
    border-radius: 16px;
    margin-bottom: 2rem;
  }

  .tienda-cta__text {
    color: var(--color-navy-60);
    font-size: 1rem;
    margin-bottom: 1.5rem;
  }

  /* Footer Strip */
  .tienda-footer-strip {
    background: var(--color-navy-dark);
    padding: 4rem 0;
  }

  .footer-strip-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .footer-strip__heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 400;
    text-transform: uppercase;
    color: var(--color-white);
    margin-bottom: 0.5rem;
  }

  .footer-strip__desc {
    color: var(--color-white);
    opacity: 0.70;
    font-size: 1rem;
  }

  @media (max-width: 1100px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .products-grid {
      grid-template-columns: 1fr;
    }

    .footer-strip-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
