---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import HomeCategories from "../components/HomeCategories.astro";
import WhyPcfc from "../components/WhyPcfc.astro";
import ValuePillars from "../components/ValuePillars.astro";
import CommunityMosaic from "../components/CommunityMosaic.astro";
import PathwayCards from "../components/PathwayCards.astro";
import Sponsors from "../components/Sponsors.astro";
import EnrollmentCta from "../components/EnrollmentCta.astro";

// ── Datos EDITABLES via EmDash CMS (src/content/ + content.config.ts) ──
// El cliente edita estos en /_emdash/admin/ (hero stats, nextMatch, sponsors, gallery, categorías).
// Los SVG iconos de value-pillars + pathway-cards quedan en homeData.ts (Design-fixed, NO editable).
import {
  getNextMatch,
  getCategories,
  getStats,
  getPillars,
  getGalleryImages,
  getSponsors,
} from "../lib/content";
// Value-pillars + pathway-cards: iconos SVG fixed (no cliente edita) → datos estáticos.
import { getValuePillarsData, getPathwayCardsData } from "../data/homeData";

// Cargar datos editable del CMS (async → await en frontmatter Astro).
const nextMatch = await getNextMatch();
const categories = await getCategories();
const stats = await getStats();
const pillars = await getPillars();
const galleryImages = await getGalleryImages();
const valuePillars = getValuePillarsData();   // SVG iconos — no editable
const pathwayCards = getPathwayCardsData();    // iconos — no editable
const sponsors = await getSponsors();
---
<Base title="Inicio" showFixtures={true}>
  <!-- HERO — impacto: próximo partido + identidad -->
  <Hero
    eyebrow="Academia · Punta Cana"
    title="Pasión por el Fútbol"
    description="Academia premium de alto rendimiento en el Caribe dominicano. Metodología profesional, valores sólidos y un camino claro desde los 4 hasta los 19 años."
    bullets={[
      "Plan formativo por etapa biológica, no por edad cronológica.",
      "Entrenadores con licencias UEFA y experiencia en academias de élite.",
      "Instalaciones de primer nivel: 4 canchas, gimnasio y aula académica.",
    ]}
    galleryImages={galleryImages}
    nextMatch={nextMatch}
  />

  <!-- CATEGORÍAS — progresión: tu hijo tiene camino -->
  <HomeCategories categories={categories} />

  <!-- VALUE PILLARS — beneficios de unirse al club -->
  <ValuePillars
    eyebrow="Beneficios"
    title="¿POR QUÉ UNIRSE A PCFC?"
    pillars={valuePillars}
  />
  <!-- POR QUÉ PCFC — confianza: números + pilares -->
  <WhyPcfc stats={stats} pillars={pillars} />

  <!-- ÚLTIMAS FOTOS — comunidad: somos muchos -->
  <CommunityMosaic images={galleryImages} />

  <!-- PATHWAY CARDS — dos caminos: padres y jugadores -->
  <PathwayCards cards={pathwayCards} />

  <!-- PATROCINADORES — aliados del club -->
  <Sponsors
    eyebrow="Aliados"
    title="PATROCINADORES Y ALIADOS"
    sponsors={sponsors}
  />

  <!-- CTA INSCRIPCIÓN — acción: el siguiente paso -->
  <EnrollmentCta />
</Base>
