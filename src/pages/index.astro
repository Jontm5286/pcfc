---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import HomeCategories from '../components/HomeCategories.astro';
import FeaturedPlayers from '../components/FeaturedPlayers.astro';
import WhyPcfc from '../components/WhyPcfc.astro';
import SeasonNumbers from '../components/SeasonNumbers.astro';
import ValuePillars from '../components/ValuePillars.astro';
import CommunityMosaic from '../components/CommunityMosaic.astro';
import PathwayCards from '../components/PathwayCards.astro';
import Sponsors from '../components/Sponsors.astro';
import EnrollmentCta from '../components/EnrollmentCta.astro';
import {
  getNextMatchData,
  getCategoriesData,
  getPillarsData,
  getStatsData,
  getGalleryImagesData,
  getValuePillarsData,
  getPathwayCardsData,
  getSponsorsData,
  getFeaturedPlayersData,
  type NextMatch,
  type FeaturedPlayer,
  type Category,
} from '../data/homeData';
import {
  fetchAcademyFeed,
  fetchHeroGalleryImages,
  fetchLatestGalleryImages,
  fetchPublishedGalleries,
  fetchPublishedPlayers,
  fetchPublishedHero,
  fetchPublishedCategories,
  academyCategoryToWeb,
  formatMatchDate,
  formatMatchTime,
  type AcademyFeed,
  type AcademyMatch,
  type PublishedGallery,
  type PublishedPlayer,
  type PublishedHero,
  type PublishedCategory,
} from '../lib/academy-feed';
import { getCollection } from 'astro:content';
import { getSeasonPills } from '../lib/content';

// Load static datasets for home page sections
// Fuentes vivas en PARALELO (una sola consulta D1 de galerías, compartida
// entre hero y comunidad). Cada fuente con respaldo si falla: la página
// nunca tumba por una fuente caída.
const [feed, galleriesRes, livePlayers, heroLive, liveCategories] = await Promise.all([
  fetchAcademyFeed().catch(
    (): AcademyFeed => ({ upcoming: [], played: [] }),
  ),
  fetchPublishedGalleries().catch(
    (): { galleries: PublishedGallery[] } => ({ galleries: [] }),
  ),
  fetchPublishedPlayers().catch((): PublishedPlayer[] => []),
  fetchPublishedHero().catch((): PublishedHero | null => null),
  fetchPublishedCategories().catch((): PublishedCategory[] => []),
]);
// Próximo partido: el más cercano del feed Academy; respaldo local si falla.
const nearestUpcoming: AcademyMatch | undefined = [...feed.upcoming].sort((a, b) =>
  a.matchDate.localeCompare(b.matchDate)
)[0];

function toNextMatch(m: AcademyMatch): NextMatch {
  const cat = academyCategoryToWeb(m.category);
  const pcfc = `PCFC ${cat.short}`;
  const rival = m.opponent || 'Rival por confirmar';
  const homeTeam = m.isHome ? pcfc : rival;
  const awayTeam = m.isHome ? rival : pcfc;
  return {
    date: formatMatchDate(m.matchDate),
    time: formatMatchTime(m.matchTime) ?? '--:--',
    category: cat.short,
    categorySlug: cat.slug,
    home: homeTeam,
    homeLogo: m.isHome ? '/Logo-PCFC.svg' : m.opponentLogo || '/Logo-PCFC.svg',
    away: awayTeam,
    awayLogo: m.isHome ? m.opponentLogo || '/Logo-PCFC.svg' : '/Logo-PCFC.svg',
    venue: m.location || (m.isHome ? 'Cancha Principal · PCFC' : 'Por confirmar'),
  };
}

const nextMatch: NextMatch = nearestUpcoming ? toNextMatch(nearestUpcoming) : getNextMatchData();
// Categorías: admin EmDash en vivo (4+) mapeado a HomeCategories;
// respaldo estático si el admin viene vacío o incompleto.
const staticCategories = getCategoriesData();
const categories: Category[] =
  liveCategories.length >= 4
    ? liveCategories.map((c) => {
        const fb =
          staticCategories.find((s) => s.slug === c.slug) ?? staticCategories[0];
        return {
          slug: c.slug || fb.slug,
          name: c.name || fb.name,
          badge: c.badge || fb.badge,
          ages: c.ages || fb.ages,
          copy: c.copy || fb.copy,
          focus: c.focus || fb.focus,
          format: c.format || fb.format,
          description: c.description || fb.description,
          ctaHref: c.ctaHref || fb.ctaHref,
        };
      })
    : staticCategories;
// Hero: textos del admin EmDash en vivo; respaldo estático si no hay fila.
// galleryImages (carrusel show_in_hero) y nextMatch quedan intactos.
const heroTitle = heroLive?.title || 'Pasión por el Fútbol';
const heroDescription =
  heroLive?.subtitle ||
  'Academia premium de alto rendimiento en Punta Cana, Republica Dominicana. Metodología profesional, valores sólidos y un camino claro desde los 4 hasta los 19 años.';
const heroCtaPrimary = heroLive?.ctaPrimary
  ? { label: heroLive.ctaPrimary, href: heroLive.ctaPrimaryHref || '/inscribete' }
  : undefined;
const heroCtaSecondary = heroLive?.ctaSecondary
  ? { label: heroLive.ctaSecondary, href: heroLive.ctaSecondaryHref || '/club' }
  : undefined;
const pillars = getPillarsData();
const stats = getStatsData();
const galleryImages = getGalleryImagesData();
// Rotador del hero: fotos de partidos con flag `show_in_hero` (EmDash);
// respaldo estático si ningún partido está marcado.
const heroFromPartidos = await fetchHeroGalleryImages(galleriesRes.galleries);
const heroGalleryImages = heroFromPartidos.length > 0 ? heroFromPartidos : galleryImages;
// Comunidad: portadas EmDash primero (lo más reciente) + estáticas
// para completar los 5 tiles hasta que haya 5+ partidos con foto.
const latestFromPartidos = await fetchLatestGalleryImages(galleriesRes.galleries, 5);
const communityImages = [...latestFromPartidos, ...galleryImages].slice(0, 5);
const valuePillars = getValuePillarsData();
const pathwayCards = getPathwayCardsData();
const sponsors = getSponsorsData();

// Temporada en números (variante A: banda navy + 4 cifras).
// Partidos jugados en vivo desde la API Academy; respaldo manual si el feed falla.
const seasonPills = await getSeasonPills();
const livePlayed = feed.played.length > 0 ? feed.played.length : null;

// Jugadores destacados: admin EmDash en vivo (featured + order);
// respaldo local (src/content/players) y estático si el admin falla.
const playerEntries = await getCollection('players');
// Fotos de jugadores: la foto del admin EmDash tiene prioridad;
// el asset local (src/assets/players/<slug>.jpg) queda como respaldo.
const localPlayerModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/players/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const localPlayerPhotos: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(localPlayerModules).map(([path, mod]) => [
    path.split('/').pop()!.replace(/\.[^.]+$/, ''),
    mod.default,
  ]),
);
const featuredPlayers: FeaturedPlayer[] =
  livePlayers.length > 0
    ? livePlayers.map((p) => ({
        name: p.name,
        slug: p.slug,
        position: p.position as FeaturedPlayer['position'],
        number: p.number,
        photo: p.photo ?? localPlayerPhotos[p.slug] ?? '',
        photoAlt: p.photoAlt || p.name,
        category: p.category as FeaturedPlayer['category'],
        matches: p.matches,
        goals: p.goals,
        assists: p.assists,
        season: p.season ?? '2026/2027',
      }))
    : playerEntries.length > 0
      ? playerEntries
        .filter((e) => e.data.featured)
        .sort((a, b) => a.data.order - b.data.order)
        .map((e) => ({
          name: e.data.name,
          slug: e.data.slug,
          position: e.data.position,
          number: e.data.number,
          photo: e.data.photo ?? localPlayerPhotos[e.data.slug],
          photoAlt: e.data.photoAlt,
          category: e.data.category,
          matches: e.data.matches,
          goals: e.data.goals,
          assists: e.data.assists,
          season: e.data.season,
        }))
    : getFeaturedPlayersData();
---

<Base title="Inicio" showFixtures={true}>
  <!-- HERO — impacto: próximo partido + identidad -->
  <Hero
    eyebrow="Academia Punta Cana FC"
    title={heroTitle}
    description={heroDescription}
    ctaPrimary={heroCtaPrimary}
    ctaSecondary={heroCtaSecondary}
    bullets={[
      'Plan formativo por etapa biológica, no por edad cronológica.',
      'Entrenadores con licencias FIFA y experiencia en academias de élite.',
      'Instalaciones de primer nivel: 2 canchas, gimnasio y aula académica.',
    ]}
    galleryImages={heroGalleryImages}
    nextMatch={nextMatch}
  />

  <!-- CATEGORÍAS — progresión: tu hijo tiene camino -->
  <HomeCategories categories={categories} />

  <!-- JUGADORES DESTACADOS — caras del club -->
  <FeaturedPlayers players={featuredPlayers} />

  <!-- VALUE PILLARS — beneficios de unirse al club -->
  <!-- <ValuePillars eyebrow="Beneficios" title="¿POR QUÉ UNIRSE A PCFC?" pillars={valuePillars} /> -->
  <!-- POR QUÉ PCFC — confianza: números + pilares -->
  <WhyPcfc stats={stats} pillars={pillars} />

  <!-- TEMPORADA EN NÚMEROS (variante A: banda navy + 4 cifras) -->
  <SeasonNumbers pills={seasonPills} livePlayed={livePlayed} />

  <!-- ÚLTIMAS FOTOS — comunidad: somos muchos -->
  <CommunityMosaic images={communityImages} />

  <!-- PATHWAY CARDS — dos caminos: padres y jugadores -->
  <PathwayCards cards={pathwayCards} />

  <!-- PATROCINADORES — aliados del club -->
  <Sponsors eyebrow="Aliados" title="PATROCINADORES Y ALIADOS" sponsors={sponsors} />

  <!-- CTA INSCRIPCIÓN — acción: el siguiente paso -->
  <EnrollmentCta />
</Base>
