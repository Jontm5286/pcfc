      alt: `PCFC Sub-13 vs Casa España — Foto ${i + 1}`,
      downloadName: `pcfc-sub13-casa-espana-2sep-${String(i + 1).padStart(2, '0')}.jpg`,
    })),
  },
];

// Galerías desde EmDash (colección `partidos`, un partido = una galería).
// Solo publicadas + con fotos. Si EmDash viene vacío, se usa el respaldo local.
const { galleries: emdashGalleries, cacheHint: galleriesCacheHint } =
  await fetchPublishedGalleries();
if (galleriesCacheHint) Astro.cache.set(galleriesCacheHint);

const emdashPosts: MatchPost[] = emdashGalleries.map((g) => ({
  id: g.slug,
  categorySlug: g.categorySlug,
  categoryLabel: g.categoryLabel,
  team1: g.team1,
  team2: g.team2,
  date: g.date,
  photoCount: g.photos.length,
  thumbnail: g.thumbnail,
  thumbnailAlt: g.thumbnailAlt,
  photos: g.photos.map((ph, i) => ({
    src: ph.src,
    alt: ph.alt,
    caption: ph.caption,
    downloadName: `${g.slug}-${String(i + 1).padStart(2, '0')}.jpg`,
  })),
}));

const allPosts: MatchPost[] = emdashPosts.length > 0 ? emdashPosts : posts;
---

<Base
  title="Galería de Fotos"
  description="Galería completa de fotos de todos los partidos de Punta Cana FC. Imágenes de los partidos de las cuatro categorías formativas."
>
  <!-- Lightbox — un solo componente para toda la página -->
  <Lightbox />

  <!-- ============================================ -->
  <!-- HERO — Galería de fotos                   -->
  <!-- ============================================ -->
  <section
    class="hero-with-image text-white pt-[clamp(6rem,12vw,9rem)] pb-[clamp(4rem,8vw,6rem)] relative"
  >
    <StockImage
      name="partido-sub13"
      alt="Partido de fútbol juvenil en cancha de Punta Cana FC"
      className="absolute inset-0 w-full h-full object-cover object-[center_30%]"
      width={1600}
      height={1200}
      loading="eager"
    />
    <div class="hero-overlay"></div>
    <div class="container-x relative z-10">
      <p class="eyebrow eyebrow--on-navy">PARTIDOS RECIENTES</p>
      <h1 class="h-display h-display--on-navy text-[clamp(2.5rem,6vw,4.5rem)] mb-5 max-w-[16ch]">
        Galería de fotos
      </h1>
      <p class="lede lede--on-navy max-w-[52ch]">
        Porque cada partido es un recuerdo. Descarga las fotos de tu hijo en acción. Galería
        completa de todos los partidos de las cuatro categorías formativas.
      </p>
    </div>
  </section>
  <!-- ============================================ -->
  <!-- GRID DE POSTS POR PARTIDO — descubrimiento  -->
  <!-- ============================================ -->
  <section class="section bg-white">
    <div class="container-x">
      <div class="mb-10">
        <h2 class="h-section text-[clamp(1.5rem,3vw,2.25rem)] mb-2">Partidos recientes</h2>
        <p class="lede text-[0.95rem]">
          {allPosts.length} partidos con galería de fotos. Haz clic en una tarjeta para ver todas las imágenes
          del encuentro.
        </p>
      </div>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
        id="posts-grid"
      >
        {
          allPosts.map((post) => (
            <PostCard
              href={`#${post.id}`}
              thumbnail={post.thumbnail}
              thumbnailAlt={post.thumbnailAlt}
              categorySlug={post.categorySlug}
              categoryLabel={post.categoryLabel}
              team1={post.team1}
              team2={post.team2}
              date={post.date}
              photoCount={post.photoCount}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- POSTS INDIVIDUALES — emoción + propiedad    -->
  <!-- ============================================ -->
  {
    allPosts.map((post) => (
      <section
        id={post.id}
        class="section bg-pure-white border-t border-navy/10"
        aria-labelledby={`post-heading-${post.id}`}
      >
        <div class="container-x">
          {/* Encabezado del post individual */}
          <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8 pb-6 border-b border-navy/10">
            <div>
              <span class={`badge badge--${post.categorySlug} mb-3`}>{post.categoryLabel}</span>
              <h2
                id={`post-heading-${post.id}`}
                class="h-section text-[clamp(1.5rem,3vw,2.25rem)] text-navy max-w-[22ch]"
              >
                {post.team1} vs {post.team2}
              </h2>
              <time datetime={post.date} class="mt-2 text-[0.9rem] text-navy-60 font-medium">
                {post.date} · {post.photoCount} fotos
              </time>
            </div>

            <a
              href="#posts-grid"
              class="btn btn--outline btn--lg flex-shrink-0 self-start sm:self-auto"
              aria-label={`Volver al grid de partidos — ${post.team1} vs ${post.team2}`}
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <line x1="19" y1="12" x2="5" y2="12" />
                <polyline points="12 19 5 12 12 5" />
              </svg>
              Ver todos los partidos
            </a>
          </div>

          {/* Grid de fotos */}
          <GalleryGrid photos={post.photos} galleryId={post.id} />
        </div>
      </section>
    ))
  }
</Base>

<script>
  // Si la URL tiene un hash (#post-id), hacer scroll suave a esa sección
  if (window.location.hash) {
    const target = document.querySelector(window.location.hash);
    if (target) {
      setTimeout(() => {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 100);
    }
  }
</script>
