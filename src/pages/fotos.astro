---
/**
 * /fotos — PCFC
 * Galería de fotos por partido.
 * Lee desde EmDash DB (ec_partidos + ec_gallery).
 */
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import Lightbox from "../components/Lightbox.astro";
import type { Photo } from "../components/GalleryGrid.astro";
import Database from "better-sqlite3";

interface MatchPost {
  id: string;
  categorySlug: "pre" | "form-baja" | "form-alta" | "elite";
  categoryLabel: string;
  team1: string;
  team2: string;
  date: string;
  photoCount: number;
  thumbnail: string;
  thumbnailAlt: string;
  photos: Photo[];
}

const categoryMap: Record<string, { slug: "pre" | "form-baja" | "form-alta" | "elite"; label: string }> = {
  "Pre-Formativas": { slug: "pre", label: "Pre-Formativas" },
  "Formativas Bajas": { slug: "form-baja", label: "Formativas Bajas" },
  "Formativas Altas": { slug: "form-alta", label: "Formativas Altas" },
  "Elite": { slug: "elite", label: "Elite / Reserva" },
};

let posts: MatchPost[] = [];

try {
  const db = new Database("data.db", { readonly: true });

  // Read partidos
  const partidos = db.prepare(
    "SELECT id, publicar, imagen, fecha, categoria, equipo FROM ec_partidos WHERE deleted_at IS NULL"
  ).all() as any[];

  // Read gallery
  const gallery = db.prepare(
    "SELECT id, src, alt, \"order\", partido_id FROM ec_gallery WHERE deleted_at IS NULL"
  ).all() as any[];

  db.close();

  // Build posts from partidos
  posts = partidos
    .filter((p) => p.publicar !== 0)
    .map((p) => {
      const cat = categoryMap[p.categoria] || { slug: "elite" as const, label: p.categoria || "Elite" };
      const matchPhotos = gallery
        .filter((g) => g.partido_id === p.id)
        .sort((a, b) => (a.order ?? 99) - (b.order ?? 99))
        .map((g) => ({
          src: g.src || "",
          alt: g.alt || "",
        }));

      return {
        id: p.id,
        categorySlug: cat.slug,
        categoryLabel: cat.label,
        team1: p.equipo || "PCFC",
        team2: "",
        date: p.fecha || "",
        photoCount: matchPhotos.length,
        thumbnail: p.imagen || "",
        thumbnailAlt: p.equipo || "Partido",
        photos: matchPhotos,
      };
    })
    .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

  // If no partidos, show all gallery photos as one big post
  if (posts.length === 0 && gallery.length > 0) {
    const allPhotos = gallery
      .sort((a, b) => (a.order ?? 99) - (b.order ?? 99))
      .map((g) => ({
        src: g.src || "",
        alt: g.alt || "",
      }));

    posts = [{
      id: "all-photos",
      categorySlug: "elite",
      categoryLabel: "Todas las fotos",
      team1: "PCFC",
      team2: "",
      date: "",
      photoCount: allPhotos.length,
      thumbnail: allPhotos[0]?.src || "",
      thumbnailAlt: "Galería completa PCFC",
      photos: allPhotos,
    }];
  }
} catch (err) {
  console.error("[fotos] Error reading DB:", err);
}
---

<Base
  title="Galería de Fotos"
  description="Galería completa de fotos de todos los partidos de Punta Cana FC."
>
  <Lightbox />

  <section class="bg-navy text-white pt-[clamp(6rem,12vw,9rem)] pb-[clamp(4rem,8vw,6rem)]">
    <div class="container-x">
      <p class="eyebrow eyebrow--on-navy">PARTIDOS RECIENTES</p>
      <h1 class="h-display h-display--on-navy text-[clamp(2.5rem,6vw,4.5rem)] mb-5 max-w-[18ch]">
        Galería de fotos
      </h1>
      <p class="lede lede--on-navy max-w-[52ch]">
        Porque cada partido es un recuerdo. Descarga las fotos de tu hijo en
        acción. Galería completa de todos los partidos de las cuatro categorías
        formativas.
      </p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-x">
      <div class="mb-10">
        <h2 class="h-section text-[clamp(1.5rem,3vw,2.25rem)] mb-2">
          Partidos recientes
        </h2>
        <p class="lede text-[0.95rem]">
          {posts.length} partidos con galería de fotos. Haz clic en una tarjeta
          para ver todas las imágenes del encuentro.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="posts-grid">
        {posts.map((post) => (
          <PostCard
            href={`#${post.id}`}
            thumbnail={post.thumbnail}
            thumbnailAlt={post.thumbnailAlt}
            categorySlug={post.categorySlug}
            categoryLabel={post.categoryLabel}
            team1={post.team1}
            team2={post.team2}
            date={post.date}
            photoCount={post.photoCount}
          />
        ))}
      </div>
    </div>
  </section>

  {posts.map((post) => (
    <section
      id={post.id}
      class="section bg-pure-white border-t border-navy/10"
      aria-labelledby={`post-heading-${post.id}`}
    >
      <div class="container-x">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8 pb-6 border-b border-navy/10">
          <div>
            <span class={`badge badge--${post.categorySlug} mb-3`}>
              {post.categoryLabel}
            </span>
            <h2 id={`post-heading-${post.id}`} class="h-section text-[clamp(1.5rem,3vw,2.25rem)] text-navy max-w-[22ch]">
              {post.team1} {post.team2 ? `vs ${post.team2}` : ""}
            </h2>
            <time datetime={post.date} class="mt-2 text-[0.9rem] text-navy-60 font-medium">
              {post.date} · {post.photoCount} fotos
            </time>
          </div>
          <a href="#posts-grid" class="btn btn--outline btn--lg flex-shrink-0 self-start sm:self-auto">
            ← Volver
          </a>
        </div>
        <GalleryGrid photos={post.photos} galleryId={post.id} />
      </div>
    </section>
  ))}
</Base>

<script>
  if (window.location.hash) {
    const target = document.querySelector(window.location.hash);
    if (target) {
      setTimeout(() => {
        target.scrollIntoView({ behavior: "smooth", block: "start" });
      }, 100);
    }
  }
</script>
