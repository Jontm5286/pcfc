---
/**
 * /fotos — PCFC
 * Página de galería de fotos por partido.
 * Sigue DESIGN.md §6 (sitemap narrativo, sección FOTOS):
 *   - HeroSection navy con título "Galería de fotos"
 *   - Grid de posts por partido usando PostCard
 *   - Post individual (galería) — placeholder con datos hardcodeados
 *   - Lightbox al hacer click en foto
 *   - Botón "Ver todas las fotos" → navega al post individual
 */
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import Lightbox from '../components/Lightbox.astro';
import type { Photo } from '../components/GalleryGrid.astro';
import StockImage from '../components/StockImage.astro';
import { fetchPublishedGalleries } from '../lib/academy-feed';

// ──────────────────────────────────────────────────────────────
// Datos hardcodeados — 8 posts mínimos tal como exige la tarea
// ──────────────────────────────────────────────────────────────

interface MatchPost {
  id: string;
  categorySlug: 'pre' | 'form-baja' | 'form-alta' | 'elite';
  categoryLabel: string;
  team1: string;
  team2: string;
  date: string;
  photoCount: number;
  thumbnail: string;
  thumbnailAlt: string;
  photos: Photo[];
}

const posts: MatchPost[] = [
