---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import TwoColMedia from '../components/TwoColMedia.astro';
import { Image } from 'astro:assets';
import luisFlores from '../assets/luis-flores.jpg';
import anaFlores from '../assets/ana-flores.jpg';
---

<Base
  title="Club"
  description="Conoce la historia, misión y visión de Punta Cana FC. Más de 10 años formando campeones en el Caribe."
>
  <!-- Hero -->
  <PageHero
    eyebrow="Nuestro Club"
    title="Conoce Punta Cana FC"
    lede="Más de 10 años dedicados a formar no solo futbolistas, sino personas de bien."
    image="historia"
    alt="Jugadores de Punta Cana FC entrenando — más de 10 años formando campeones en el Caribe"
  />

  <!-- Historia -->
  <section class="section" id="historia">
    <div class="container-x">
      <TwoColMedia
        eyebrow="Nuestra Historia"
        title="De Un Sueño a la Realidad"
        paragraphs={[
          'Punta Cana FC nació con la visión de crear la academia de fútbol de clase mundial en el Caribe. Desde un pequeño grupo de jugadores ha crecido hasta convertirse en la academia de fútbol más importante de la región.',
          'A lo largo de nuestros más de 10 años de trayectoria, hemos formado cientos de jugadores que han llegado a competir en ligas profesionales nacionales e internacionales.',
        ]}
      >
        <a href="/inscribete" class="btn btn--sky">Únete al Club</a>
        <div slot="media" class="historia-collage">
          <img
            src="/images/historia/fundador-mate-bn.jpg"
            alt="Fundador de Punta Cana FC tomando mate — retrato en blanco y negro"
            class="historia-collage__main"
            loading="lazy"
            width={1920}
            height={1280}
          />
          <img
            src="/images/historia/entrenador-gorra.jpg"
            alt="Entrenador de Punta Cana FC con gorra del club en la cancha"
            class="historia-collage__overlap"
            loading="lazy"
            width={1200}
            height={900}
          />
        </div>
      </TwoColMedia>
    </div>
  </section>

  <!-- Mision Vision Valores -->
  <section class="section mv-section" id="mision">
    <div class="container-x">
      <p class="eyebrow eyebrow--on-navy">Misión, Visión y Valores</p>
      <h2 class="h-section h-section--on-navy">Formando campeones dentro y fuera de la cancha</h2>
      <div class="mv-grid">
        <div class="mv-card">
          <div class="mv-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <circle cx="12" cy="12" r="6"></circle>
              <circle cx="12" cy="12" r="2"></circle>
            </svg>
          </div>
          <h3 class="h-card h-card--on-navy">Misión</h3>
          <p class="mv-desc">
            Formar futbolistas de excelencia a través de un entrenamiento profesional, integral y
            basado en valores, contribuyendo al desarrollo deportivo del Caribe.
          </p>
        </div>
        <div class="mv-card">
          <div class="mv-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </div>
          <h3 class="h-card h-card--on-navy">Visión</h3>
          <p class="mv-desc">
            Ser reconocida como la academia de fútbol líder en América Latina, formando campeones
            dentro y fuera de la cancha.
          </p>
        </div>
        <div class="mv-card">
          <div class="mv-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"
              ></path>
            </svg>
          </div>
          <h3 class="h-card h-card--on-navy">Valores</h3>
          <p class="mv-desc">
            Disciplina, respeto, trabajo en equipo, perseverancia y pasión. Estos son los pilares
            que guían a cada jugador de PCFC.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Equipo Directivo -->
  <section class="section" id="equipo-directivo">
    <div class="container-x">
      <p class="eyebrow">Equipo Directivo</p>
      <h2 class="h-section">Liderazgo con Visión</h2>
      <div class="team-grid">
        <div class="team-member">
          <Image
            src={luisFlores}
            alt="Luis Flores, Director General de Punta Cana FC"
            class="team-photo"
            loading="lazy"
            width={640}
            height={800}
            widths={[320, 640]}
            sizes="(max-width: 768px) 100vw, 340px"
          />
          <h3 class="team-name">Luis Flores</h3>
          <p class="team-role">Director General</p>
        </div>
        <div class="team-member">
          <Image
            src={anaFlores}
            alt="Ana Flores, Directora Deportiva de Punta Cana FC"
            class="team-photo"
            loading="lazy"
            width={640}
            height={800}
            widths={[320, 640]}
            sizes="(max-width: 768px) 100vw, 340px"
          />
          <h3 class="team-name">Ana Flores</h3>
          <p class="team-role">Directora Deportiva</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .historia-collage {
    width: 100%;
  }
  .historia-collage__main {
    width: 88%;
    height: auto;
    aspect-ratio: 3/2;
    object-fit: cover;
    border-radius: 16px;
    display: block;
    box-shadow: 0 16px 48px rgba(0, 40, 92, 0.18);
  }
  .historia-collage__overlap {
    width: 54%;
    height: auto;
    aspect-ratio: 4/3;
    object-fit: cover;
    display: block;
    margin-left: auto;
    margin-top: -24%;
    border: 6px solid var(--color-pure-white);
    border-radius: 16px;
    box-shadow: 0 16px 48px rgba(0, 40, 92, 0.22);
    position: relative;
  }

  .mv-section {
    background: var(--color-navy-dark);
  }

  .mv-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
  }

  .mv-card {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 16px;
    text-align: center;
    padding: 3rem 2rem;
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }

  .mv-card:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.24);
  }

  .mv-icon {
    width: 70px;
    height: 70px;
    margin: 0 auto 1.5rem;
    background: var(--color-sky-10);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-sky);
  }

  .h-card--on-navy {
    font-size: 1.3rem;
    margin-bottom: 1rem;
  }

  .mv-desc {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem 2rem;
    margin-top: 3rem;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .team-member {
    text-align: center;
  }

  .team-photo {
    width: 100%;
    max-width: 340px;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 20px;
    display: block;
    margin: 0 auto 1.25rem;
  }

  .team-name {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--color-navy);
  }

  .team-role {
    color: var(--color-sky);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  @media (max-width: 992px) {
    .historia-collage__main {
      width: 100%;
    }
    .historia-collage__overlap {
      width: 78%;
      margin-top: -14%;
    }
    .mv-grid {
      grid-template-columns: 1fr;
    }
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
