---
import Base from '../../layouts/Base.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import EnrollmentCta from '../../components/EnrollmentCta.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

// FASE 3: artículo real desde la colección local `blog` (file-based, sin EmDash).
// El slug de ruta es el `slug` del frontmatter de cada .md.
export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((p) => p.data.published !== false)
    .map((entry) => ({
      params: { slug: entry.data.slug },
      props: { entry },
    }));
}

// ─── Props ───────────────────────────────────────────────────────────────────

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props as Props;
if (!entry) return new Response('Post no encontrado', { status: 404 });

const post = entry.data;
const slug = post.slug;
const category = post.category || 'Noticias';

// ─── Relacionados: misma categoría primero, resto recientes (máx 3) ─────────

const allOthers = (await getCollection('blog'))
  .filter((p) => p.data.slug !== slug && p.data.published !== false)
  .sort((a, b) => +new Date(b.data.publishedAt) - +new Date(a.data.publishedAt));
const related = [
  ...allOthers.filter((p) => (p.data.category || 'Noticias') === category),
  ...allOthers.filter((p) => (p.data.category || 'Noticias') !== category),
].slice(0, 3);

// ─── Helpers ─────────────────────────────────────────────────────────────────

function slugify(s: string): string {
  return s
    .toLowerCase()
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

function formatDate(iso: string): string {
  const d = new Date(iso + (iso.length === 10 ? 'T12:00:00' : ''));
  return Number.isNaN(+d)
    ? iso
    : d.toLocaleDateString('es-DO', { day: 'numeric', month: 'short', year: 'numeric' });
}

function readingTime(paragraphs: string[]): number {
  const words = paragraphs
    .join(' ')
    .replace(/[#|*_\-[\]()]/g, ' ')
    .trim()
    .split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 200));
}

// Mini-render del `body` (array de párrafos markdown: ## h2, listas -, tablas |, **bold**, [links]).
function inlineMd(s: string): string {
  let out = s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  out = out.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  out = out.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
  return out;
}

function renderBodyHtml(items: string[]): string {
  let html = '';
  let i = 0;
  while (i < items.length) {
    const line = items[i].trim();
    if (line.startsWith('## ')) {
      html += `<h2>${inlineMd(line.slice(3))}</h2>`;
      i++;
      continue;
    }
    if (line.startsWith('|')) {
      const rows: string[][] = [];
      while (i < items.length && items[i].trim().startsWith('|')) {
        const cells = items[i]
          .trim()
          .split('|')
          .slice(1, -1)
          .map((c) => c.trim());
        if (!cells.every((c) => /^:?-{2,}:?$/.test(c))) rows.push(cells);
        i++;
      }
      if (rows.length > 0) {
        const [head, ...bodyRows] = rows;
        html +=
          `<div class="table-wrap"><table><thead><tr>` +
          head.map((c) => `<th>${inlineMd(c)}</th>`).join('') +
          `</tr></thead><tbody>` +
          bodyRows
            .map((r) => `<tr>${r.map((c) => `<td>${inlineMd(c)}</td>`).join('')}</tr>`)
            .join('') +
          `</tbody></table></div>`;
      }
      continue;
    }
    if (line.startsWith('- ')) {
      let lis = '';
      while (i < items.length && items[i].trim().startsWith('- ')) {
        lis += `<li>${inlineMd(items[i].trim().slice(2))}</li>`;
        i++;
      }
      html += `<ul>${lis}</ul>`;
      continue;
    }
    if (!line) {
      i++;
      continue;
    }
    html += `<p>${inlineMd(items[i].trim())}</p>`;
    i++;
  }
  return html;
}

const minutes = readingTime(post.body ?? []);
const bodyHtml = renderBodyHtml(post.body ?? []);
const coverSrc = post.coverImage && post.coverImage !== '' ? post.coverImage : undefined;
const coverAltText = post.coverAlt || post.title;
const tagSlug = slugify(category);
---

<Base title={post.title} description={post.excerpt || post.title}>
  <!-- ── Article hero ──────────────────────────────────────────────────── -->
  <section class="article-hero">
    <div class="container-x max-w-[900px] mx-auto">
      <SectionHeader
        eyebrow={category}
        title={post.title}
        subtitle={post.excerpt || ''}
        align="left"
      />

      <!-- Meta: autor + fecha + lectura -->
      <div class="article-meta">
        <address class="article-author">
          <span class="article-author__name">Redacción PCFC</span>
          <span class="article-author__title">Punta Cana FC</span>
        </address>
        <div class="article-meta__right">
          <time datetime={post.publishedAt} class="article-date">
            {formatDate(post.publishedAt)}
          </time>
          <span class="article-meta__sep" aria-hidden="true">·</span>
          <span class="article-reading">
            {minutes} min de lectura
          </span>
        </div>
      </div>

      <!-- Tags (categoría real del post) -->
      <div class="article-tags" role="list" aria-label="Etiquetas del artículo">
        <span
          role="listitem"
          class={`badge ${tagSlug === 'noticias' ? 'badge--sky' : tagSlug === 'torneos' ? 'badge--form-baja' : tagSlug === 'entrevistas' ? 'badge--form-alta' : tagSlug === 'resultados' ? 'badge--pre' : 'badge--sky'}`}
        >
          {category}
        </span>
      </div>
    </div>
  </section>

  <!-- ── Cover (solo si el post trae coverImage) ───────────────────────── -->
  {
    coverSrc && (
      <div class="article-image-wrapper">
        <div class="container-x">
          <figure class="article-figure">
            <img
              src={coverSrc}
              alt={coverAltText}
              loading="eager"
              fetchpriority="high"
              class="article-hero-img"
            />
            <figcaption class="article-figure__caption">{coverAltText}</figcaption>
          </figure>
        </div>
      </div>
    )
  }

  <!-- ── Article body ──────────────────────────────────────────────────── -->
  <article class="article-body">
    <div class="container-x max-w-[720px]">
      <div class="article-content prose" set:html={bodyHtml} />
    </div>
  </article>

  <!-- ── Relacionados (datos reales) ───────────────────────────────────── -->
  {
    related.length > 0 && (
      <section class="article-gallery">
        <div class="container-x">
          <h2 class="article-gallery__title">Sigue leyendo</h2>
          <div class="related-grid">
            {related.map((r) => (
              <a href={`/blog/${r.data.slug}`} class="related-card">
                <span class="badge badge--sky related-card__cat">
                  {r.data.category || 'Noticias'}
                </span>
                <span class="related-card__title">{r.data.title}</span>
                {r.data.excerpt && <span class="related-card__excerpt">{r.data.excerpt}</span>}
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ── CTA Inscripción ───────────────────────────────────────────────── -->
  <EnrollmentCta
    eyebrow="El siguiente paso es ahora"
    title="¿LISTO PARA<br />UNIRTE AL CLUB?"
    copy="Las inscripciones para la temporada 2026 están abiertas. Completa el formulario y nuestro equipo te contactará en menos de 24 horas."
    enrollHref={post.ctaPrimary?.href ?? '/inscribete'}
    whatsappHref="https://wa.me/18096529450"
  />
</Base>

<style>
  /* ── Article hero ──────────────────────────────────────────────────── */
  .article-hero {
    padding: clamp(7rem, 15vw, 10rem) 0 clamp(2rem, 4vw, 3rem);
    background: linear-gradient(180deg, var(--color-navy-05) 0%, var(--color-pure-white) 100%);
    border-bottom: 1px solid var(--color-navy-10);
  }

  /* ── Meta bar ─────────────────────────────────────────────────────── */
  .article-meta {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-navy-10);
  }

  .article-author {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    font-style: normal;
  }

  .article-author__name {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-navy);
  }

  .article-author__title {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-navy-30);
    letter-spacing: 0.03em;
  }

  .article-meta__right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-navy-30);
  }

  .article-meta__sep {
    color: var(--color-navy-10);
  }

  .article-reading {
    font-weight: 500;
  }

  /* ── Tags ──────────────────────────────────────────────────────────── */
  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  /* ── Hero image ────────────────────────────────────────────────────── */
  .article-image-wrapper {
    padding: 2rem 0;
    background: var(--color-pure-white);
  }

  .article-figure {
    margin: 0;
  }

  .article-hero-img {
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--color-navy-10);
  }

  .article-figure__caption {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--color-navy-30);
    margin-top: 0.625rem;
    text-align: center;
    font-style: italic;
  }

  /* ── Article body ──────────────────────────────────────────────────── */
  .article-body {
    padding: clamp(2.5rem, 5vw, 4rem) 0;
    background: var(--color-pure-white);
  }

  .article-content.prose {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-navy);
  }

  .article-content.prose :global(p) {
    margin-bottom: 1.5rem;
    color: var(--color-navy);
  }

  .article-content.prose :global(h2) {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.875rem);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: -0.005em;
    color: var(--color-navy);
    margin-top: 3rem;
    margin-bottom: 1.25rem;
    line-height: 1.1;
    border-top: 2px solid var(--color-navy);
    padding-top: 1.5rem;
  }

  .article-content.prose :global(h3) {
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .article-content.prose :global(ul) {
    margin-bottom: 1.5rem;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .article-content.prose :global(a) {
    color: var(--color-sky);
    text-decoration: underline;
  }

  .article-content.prose :global(strong) {
    font-weight: 700;
  }

  .article-content.prose :global(.table-wrap) {
    overflow-x: auto;
    margin-bottom: 1.5rem;
    border: 1px solid var(--color-navy-10);
    border-radius: 8px;
  }

  .article-content.prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .article-content.prose :global(th),
  .article-content.prose :global(td) {
    padding: 0.625rem 0.875rem;
    text-align: left;
    border-bottom: 1px solid var(--color-navy-10);
  }

  .article-content.prose :global(th) {
    background: var(--color-navy-05);
    font-weight: 700;
  }

  /* ── Related section ────────────────────────────────────────────────── */
  .article-gallery {
    padding: clamp(2.5rem, 5vw, 4rem) 0;
    background: var(--color-navy-05);
    border-top: 1px solid var(--color-navy-10);
    border-bottom: 1px solid var(--color-navy-10);
  }

  .article-gallery__title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.625rem);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: -0.005em;
    color: var(--color-navy);
    margin-bottom: 1.5rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: var(--color-pure-white);
    border: 1px solid var(--color-navy-10);
    border-radius: 8px;
    padding: 1.25rem;
    text-decoration: none;
  }

  .related-card__cat {
    align-self: flex-start;
  }

  .related-card__title {
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.4;
  }

  .related-card__excerpt {
    font-size: 0.85rem;
    color: var(--color-navy-60);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Responsive ────────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .article-meta {
      flex-direction: column;
      gap: 0.75rem;
    }

    .article-meta__right {
      gap: 0.375rem;
    }

    .article-hero-img {
      aspect-ratio: 16 / 9;
      border-radius: 4px;
    }
  }
</style>
