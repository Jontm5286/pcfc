---
/**
 * Sponsors Page — PCFC
 * Página dedicada a patrocinadores y aliados del club.
 * Solo muestra sponsors gestionados vía /_emdash/admin/ (EmDash CMS).
 */

import Base from '../layouts/Base.astro';
import StockImage from '../components/StockImage.astro';
import { getSponsorsData } from '../data/homeData';

const sponsors = getSponsorsData();
---

<Base title="Patrocinadores y Aliados" description="Conoce los patrocinadores y aliados del Punta Cana FC. Marcas que apoyan el fútbol formativo en el Caribe.">
  <!-- Hero -->
  <section class="hero-with-image text-white pt-[clamp(6rem,12vw,9rem)] pb-[clamp(4rem,8vw,6rem)] relative">
    <StockImage
      name="directivo"
      alt="Aliados y directivos de Punta Cana FC que apoyan el fútbol formativo en el Caribe"
      className="absolute inset-0 w-full h-full object-cover object-[center_30%]"
      width={1600}
      height={1200}
      loading="eager"
    />
    <div class="hero-overlay"></div>
    <div class="container-x relative z-10">
      <p class="eyebrow eyebrow--on-navy">Aliados</p>
      <h1 class="h-display h-display--on-navy text-[clamp(2.5rem,6vw,4.5rem)] mb-5 max-w-[16ch]">
        Nuestros Patrocinadores
      </h1>
      <p class="lede lede--on-navy max-w-[52ch]">
        Marcas y empresas que apoyan la formación de campeones en el Caribe.
      </p>
    </div>
  </section>

  <section class="section bg-navy-dark">
    <div class="container-x">
      {sponsors.length > 0 ? (
        <>
          <div
            class="flex flex-wrap items-center justify-center gap-x-10 gap-y-8"
            role="list"
            aria-label="Lista de patrocinadores"
          >
            {sponsors.map((sponsor) => (
              <div role="listitem" class="group">
                {sponsor.href ? (
                  <a
                    href={sponsor.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Visitar sitio de ${sponsor.name}`}
                    class="block opacity-70 hover:opacity-100 transition-opacity duration-200"
                  >
                    <img
                      src={sponsor.logo}
                      alt={`Logo de ${sponsor.name}`}
                      loading="lazy"
                      class="h-10 md:h-12 w-auto object-contain"
                    />
                  </a>
                ) : (
                  <img
                    src={sponsor.logo}
                    alt={`Logo de ${sponsor.name}`}
                    loading="lazy"
                    class="h-10 md:h-12 w-auto object-contain opacity-70 group-hover:opacity-100 transition-opacity duration-200"
                  />
                )}
              </div>
            ))}
          </div>
        </>
      ) : (
        <div class="text-center py-16">
          <p class="lede lede--on-navy opacity-50">Patrocinadores próximamente</p>
        </div>
      )}
    </div>
  </section>
</Base>
