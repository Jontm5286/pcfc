---
/**
 * Sponsors Page — PCFC
 * Página dedicada a patrocinadores y aliados del club.
 * Solo muestra sponsors gestionados vía /_emdash/admin/ (EmDash CMS).
 */

import Base from '../layouts/Base.astro';
import { getSponsorsFromEmDash } from '../lib/content';

const sponsors = await getSponsorsFromEmDash();
---

<Base title="Patrocinadores y Aliados" description="Conoce los patrocinadores y aliados del Punta Cana FC. Marcas que apoyan el fútbol formativo en el Caribe.">
  <section class="section bg-navy-dark">
    <div class="container-x">
      {sponsors.length > 0 ? (
        <>
          <div class="text-center mb-10">
            <p class="eyebrow eyebrow--on-navy">Aliados</p>
            <h1 class="h-section h-section--on-navy">Nuestros Patrocinadores</h1>
            <p class="lede lede--on-navy max-w-[60ch] mx-auto mt-4">
              Marcas y empresas que apoyan la formación de campeones en el Caribe.
            </p>
          </div>

          <div
            class="flex flex-wrap items-center justify-center gap-x-10 gap-y-8"
            role="list"
            aria-label="Lista de patrocinadores"
          >
            {sponsors.map((sponsor) => (
              <div role="listitem" class="group">
                {sponsor.href ? (
                  <a
                    href={sponsor.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Visitar sitio de ${sponsor.name}`}
                    class="block opacity-70 hover:opacity-100 transition-opacity duration-200"
                  >
                    <img
                      src={sponsor.logo}
                      alt={`Logo de ${sponsor.name}`}
                      loading="lazy"
                      class="h-10 md:h-12 w-auto object-contain"
                    />
                  </a>
                ) : (
                  <img
                    src={sponsor.logo}
                    alt={`Logo de ${sponsor.name}`}
                    loading="lazy"
                    class="h-10 md:h-12 w-auto object-contain opacity-70 group-hover:opacity-100 transition-opacity duration-200"
                  />
                )}
              </div>
            ))}
          </div>
        </>
      ) : (
        <div class="text-center py-16">
          <p class="lede lede--on-navy opacity-50">Patrocinadores próximamente</p>
        </div>
      )}
    </div>
  </section>
</Base>
