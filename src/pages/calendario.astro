---
/**
 * /calendario — PCFC
 * Página completa de calendario con filtros por categoría, próximos partidos y pasados.
 * Sigue DESIGN.md §6 (sitemap narrativo) y §7 (patrones de componentes).
 */

import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CalendarFilters from '../components/CalendarFilters.astro';
import MatchListItem from '../components/MatchListItem.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { buildMatchSlug } from '../lib/match-photos';
import {
  fetchAcademyFeed,
  fetchPublishedGalleries,
  toCalendarItem,
  type AcademyMatch,
  type CalendarMatchItem,
} from '../lib/academy-feed';

export const prerender = true;

// ---------------------------------------------------------------------------
// Feed en vivo: convocatorias de la app de gestión (FutbolPro Academy).
// GET {ACADEMY_API_URL}/api/public/matches -> { upcoming, played }.
// Sin auth y con CORS abierto; solo expone datos aptos para publicar.
// Si el feed falla o viene vacío, se usan los arreglos locales de respaldo.
// ---------------------------------------------------------------------------

// NOTA: el fetch del feed en vivo y las listas display van DESPUÉS de los
// arreglos de respaldo (const no admite uso anticipado).

// Próximos partidos (anticipación) — datos locales de respaldo.
// Si el feed en vivo de la app de gestión responde, se usa ese en su lugar.
const fallbackUpcomingMatches: CalendarMatchItem[] = [
  {
    categorySlug: 'elite',
    categoryLabel: 'Elite / Reserva',
    date: 'Sáb 13 sep',
    time: '10:00 AM',
    team1: 'PCFC',
    team2: 'Atlético Bávaro',
    venue: 'Cancha Principal · PCFC',
    photosHref: undefined,
    past: false,
  },
  {
    categorySlug: 'form-alta',
    categoryLabel: 'Formativas Altas',
    date: 'Dom 14 sep',
    time: '9:00 AM',
    team1: 'PCFC Sub-15',
    team2: 'Moca FC',
    venue: 'Cancha Auxiliar · PCFC',
    photosHref: undefined,
    past: false,
  },
  {
    categorySlug: 'form-baja',
    categoryLabel: 'Formativas Bajas',
    date: 'Sáb 20 sep',
    time: '11:00 AM',
    team1: 'PCFC Sub-12',
    team2: 'San Cristóbal FC',
    venue: 'Estadio Garrik',
    photosHref: undefined,
    past: false,
  },
  {
    categorySlug: 'pre',
    categoryLabel: 'Pre-Formativas',
    date: 'Dom 21 sep',
    time: '10:30 AM',
    team1: 'PCFC Sub-8',
    team2: 'Escuela Bavaro',
    venue: 'Cancha 3 · PCFC',
    photosHref: undefined,
    past: false,
  },
  {
    categorySlug: 'form-alta',
    categoryLabel: 'Formativas Altas',
    date: 'Sáb 27 sep',
    time: '4:00 PM',
    team1: 'PCFC Sub-14',
    team2: 'Selección Federativa',
    venue: 'Florer Puerto',
    photosHref: undefined,
    past: false,
  },
  {
    categorySlug: 'elite',
    categoryLabel: 'Elite / Reserva',
    date: 'Dom 28 sep',
    time: '3:00 PM',
    team1: 'PCFC Reserva',
    team2: 'Higüey United',
    venue: 'Cancha Principal · PCFC',
    photosHref: undefined,
    past: false,
  },
];

// Partidos jugados (recuerdo) — respaldo local si el feed en vivo falla.
const fallbackPastMatches: CalendarMatchItem[] = [
  {
    categorySlug: 'elite',
    categoryLabel: 'Elite / Reserva',
    date: 'Sáb 6 sep',
    time: '10:00 AM',
    team1: 'PCFC',
    team2: 'Atlántico FC',
    venue: 'Cancha Principal · PCFC',
    photosHref: '/fotos#pcfc-vs-atlantico-6sep',
    past: true,
  },
  {
    categorySlug: 'form-alta',
    categoryLabel: 'Formativas Altas',
    date: 'Sáb 30 ago',
    time: '4:00 PM',
    team1: 'PCFC Sub-15',
    team2: 'Santiago FC',
    venue: 'Cancha Auxiliar · PCFC',
    photosHref: '/fotos#pcfc-sub15-vs-santiago-30ago',
    past: true,
  },
  {
    categorySlug: 'form-baja',
    categoryLabel: 'Formativas Bajas',
    date: 'Dom 24 ago',
    time: '11:00 AM',
    team1: 'PCFC Sub-10',
    team2: 'Canay FC',
    venue: 'Caseral',
    photosHref: '/fotos#pcfc-sub10-vs-canay-24ago',
    past: true,
  },
  {
    categorySlug: 'pre',
    categoryLabel: 'Pre-Formativas',
    date: 'Sáb 16 ago',
    time: '9:30 AM',
    team1: 'PCFC Sub-6',
    team2: 'Casa España',
    venue: 'Casa España',
    photosHref: '/fotos#pcfc-sub6-vs-casa-espana-16ago',
    past: true,
  },
  {
    categorySlug: 'form-alta',
    categoryLabel: 'Formativas Altas',
    date: 'Sáb 9 ago',
    time: '4:00 PM',
    team1: 'PCFC Sub-13',
    team2: 'Casa España',
    venue: 'Casa España',
    photosHref: undefined,
    past: true,
  },
];

// Galerías publicadas en EmDash (colección `match_photos`): solo esas enlazan "Ver fotos".
// Las nuevas fechas del feed se crean como draft vía `pnpm sync:match-photos`
// y no enlazan hasta tener fotos. Match por academy_id, fallback al slug.
const { galleries: publishedGalleries, cacheHint: galleriesCacheHint } =
  await fetchPublishedGalleries();
if (galleriesCacheHint) Astro.cache.set(galleriesCacheHint);
const publishedGallerySlugs = new Set(publishedGalleries.map((g) => g.slug));
const gallerySlugByAcademyId = new Map(
  publishedGalleries.flatMap((g) => (g.academyId ? [[g.academyId, g.slug] as const] : []))
);

// Feed en vivo (después de los respaldos por el TDZ de const).
const feed = await fetchAcademyFeed();
const liveUpcoming: CalendarMatchItem[] = feed.upcoming.map((m: AcademyMatch) =>
  toCalendarItem(m, false)
);
const livePlayed: CalendarMatchItem[] = feed.played.map((m: AcademyMatch) => {
  const item = toCalendarItem(m, true);
  const slug =
    gallerySlugByAcademyId.get(m.id) ?? buildMatchSlug(item.team1, item.team2, m.matchDate);
  if (publishedGallerySlugs.has(slug)) item.photosHref = `/fotos#${slug}`;
  return item;
});

const displayUpcoming: CalendarMatchItem[] =
  liveUpcoming.length > 0 ? liveUpcoming : fallbackUpcomingMatches;
const displayPast: CalendarMatchItem[] = livePlayed.length > 0 ? livePlayed : fallbackPastMatches;
---

<Base
  title="Calendario"
  description="Calendario completo de partidos de Punta Cana FC. Próximos encuentros y resultados de las cuatro categorías formativas."
>
  <!-- ============================================ -->
  <!-- HERO — Calendario -->
  <!-- ============================================ -->
  <PageHero
    eyebrow="Temporada 2026"
    title="Calendario"
    lede="Todos los partidos de la temporada, organizados por categoría. Marca tu calendario, filtra por equipo y no te pierdas ningún encuentro de tu hijo."
    image="partido-sub13"
    alt="Partido de fútbol juvenil en cancha de Punta Cana FC"
  />

  <!-- ============================================ -->
  <!-- FILTROS — control -->
  <!-- ============================================ -->
  <section class="bg-pure-white py-10 border-b border-navy/10">
    <div class="container-x flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <h2 class="font-display text-[1.25rem] uppercase text-navy leading-tight">
          Filtra por categoría
        </h2>
        <p class="text-[0.85rem] text-navy-60 mt-1">
          Encuentra rápidamente los partidos de tu equipo.
        </p>
      </div>
      <CalendarFilters />
    </div>
  </section>

  <!-- ============================================ -->
  <!-- PRÓXIMOS PARTIDOS — anticipación -->
  <!-- ============================================ -->
  <section class="section bg-white">
    <div class="container-x">
      <SectionHeader
        eyebrow="Esta semana"
        title="PRÓXIMOS<br />PARTIDOS"
        subtitle="Consulta los próximos partidos de cada categoría. Filtra por edad y formato, y planifica tu asistencia."
      />

      <ul
        id="match-list"
        class="list-none bg-white border border-navy/10 rounded-lg overflow-hidden"
        role="list"
        aria-label="Próximos partidos"
      >
        {
          displayUpcoming.map((match) => (
            <MatchListItem
              categorySlug={match.categorySlug}
              categoryLabel={match.categoryLabel}
              date={match.date}
              time={match.time}
              team1={match.team1}
              team2={match.team2}
              venue={match.venue}
              sedeLine={match.sedeLine}
              photosHref={match.photosHref}
              past={match.past}
              score={match.score}
              opponentLogo={match.opponentLogo}
            />
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- PARTIDOS JUGADOS — recuerdo -->
  <!-- ============================================ -->
  <section class="section bg-pure-white border-t border-navy/10">
    <div class="container-x">
      <SectionHeader
        eyebrow="Lo que vivimos"
        title="PARTIDOS<br />JUGADOS"
        subtitle="Revive los momentos clave de los partidos recientes. Cada encuentro tiene su galería de fotos."
      />

      <ul
        id="match-list-past"
        class="list-none bg-white border border-navy/10 rounded-lg overflow-hidden"
        role="list"
        aria-label="Partidos jugados"
      >
        {
          displayPast.map((match) => (
            <MatchListItem
              categorySlug={match.categorySlug}
              categoryLabel={match.categoryLabel}
              date={match.date}
              time={match.time}
              team1={match.team1}
              team2={match.team2}
              venue={match.venue}
              sedeLine={match.sedeLine}
              photosHref={match.photosHref}
              past={match.past}
              score={match.score}
              opponentLogo={match.opponentLogo}
            />
          ))
        }
      </ul>

      <div class="mt-12 text-center">
        <a href="/fotos" class="btn btn--primary btn--lg">
          Ver galería completa
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  // ── Hidratación viva: re-render con GET /api/feed-vivo ────────────────────
  // El shell prerenderizado queda como fallback. Si el endpoint responde con
  // listas no vacías, se reconcilian los photosHref contra /api/fotos
  // (set de slugs publicados; por academy_id vía `slug`, con fallback al
  // href que trae el servidor) y se re-renderizan las listas.
  // Con API caída o respuesta vacía: no se toca el DOM, nunca se rompe.
  interface CalendarItem {
    categorySlug: string;
    categoryLabel: string;
    date: string;
    time?: string;
    team1: string;
    team2: string;
    venue: string;
    sedeLine?: string;
    photosHref?: string;
    slug?: string;
    past: boolean;
    score?: string;
    opponentLogo?: string;
  }

  async function hydrateCalendario() {
    let feed: { upcoming?: CalendarItem[]; played?: CalendarItem[] } | undefined;
    try {
      const res = await fetch('/api/feed-vivo', { headers: { Accept: 'application/json' } });
      if (!res.ok) return;
      feed = await res.json();
    } catch {
      return;
    }
    if (!feed || (!feed.upcoming?.length && !feed.played?.length)) return;

    // Set de galerías publicadas hoy (para reconciliar "Ver fotos").
    let published: Set<string> | null = null;
    try {
      const res = await fetch('/api/fotos?page=1&limit=50', { headers: { Accept: 'application/json' } });
      if (res.ok) {
        const data = await res.json();
        published = new Set((data.posts ?? []).map((p: { id: string }) => p.id));
      }
    } catch {
      published = null;
    }

    const esc = (s: unknown): string =>
      String(s ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');

    const pinSvg =
      '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-navy-60" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>';
    const camSvg =
      '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>';

    const renderItem = (m: CalendarItem): string => {
      const photosHref =
        published && m.slug
          ? published.has(m.slug)
            ? `/fotos#${m.slug}`
            : undefined
          : m.photosHref;
      const action = m.past
        ? photosHref
          ? `<a href="${esc(photosHref)}" class="inline-flex items-center gap-1.5 text-[0.8rem] font-semibold text-sky hover:text-navy transition-colors duration-150 whitespace-nowrap" aria-label="Ver fotos del partido ${esc(m.team1)} vs ${esc(m.team2)}">${camSvg}Ver fotos</a>`
          : '<span class="text-[0.8rem] text-navy-60 italic">Sin fotos</span>'
        : '<span class="badge badge--sky text-[0.7rem]">Próximo</span>';
      return `<li class="match-item border-b border-navy/10 last:border-b-0 bg-white hover:bg-sky-05 transition-colors duration-150" data-category="${esc(m.categorySlug)}"><div class="container-x flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6 py-4"><div class="flex items-center gap-3 sm:min-w-[160px]"><span class="badge badge--${esc(m.categorySlug)}">${esc(m.categoryLabel)}</span><div class="flex flex-col"><span class="text-[0.8rem] font-semibold text-navy tracking-wide">${esc(m.date)}</span>${m.time ? `<span class="text-[0.75rem] text-navy-60 font-normal">${esc(m.time)}</span>` : ''}</div></div><div class="flex-1 flex items-center gap-3 min-w-0"><span class="font-body font-semibold text-[0.95rem] text-navy shrink-0">${esc(m.team1)}</span>${m.score ? `<span class="text-[0.8rem] font-bold text-navy bg-sky-05 border border-navy/10 rounded px-1.5 py-0.5 shrink-0">${esc(m.score)}</span>` : '<span class="text-navy-60 text-[0.75rem] font-semibold shrink-0">vs</span>'}<span class="font-body font-semibold text-[0.95rem] text-navy-60 shrink-0 min-w-0 truncate inline-flex items-center gap-1.5">${m.opponentLogo ? `<img src="${esc(m.opponentLogo)}" alt="Escudo de ${esc(m.team2)}" loading="lazy" width="20" height="20" class="w-5 h-5 rounded-full object-cover shrink-0" />` : ''}${esc(m.team2)}</span></div><div class="flex flex-col sm:min-w-[160px]"><div class="flex items-center gap-1.5">${pinSvg}<span class="text-[0.8rem] text-navy-60 whitespace-nowrap">${esc(m.venue)}</span></div>${m.sedeLine ? `<span class="text-[0.75rem] font-semibold text-navy mt-0.5 pl-[19px]">${esc(m.sedeLine)}</span>` : ''}</div><div class="flex items-center gap-3 sm:shrink-0">${action}</div></div></li>`;
    };

    if (feed.upcoming?.length) {
      const ul = document.getElementById('match-list');
      if (ul) ul.innerHTML = feed.upcoming.map(renderItem).join('');
    }
    if (feed.played?.length) {
      const ul = document.getElementById('match-list-past');
      if (ul) ul.innerHTML = feed.played.map(renderItem).join('');
    }
  }

  hydrateCalendario();
</script>
