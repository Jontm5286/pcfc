---
/**
 * /calendario — PCFC
 * Página completa de calendario con filtros por categoría, próximos partidos y pasados.
 * Sigue DESIGN.md §6 (sitemap narrativo) y §7 (patrones de componentes).
 */

import Base from '../layouts/Base.astro';
import StockImage from '../components/StockImage.astro';
import CalendarFilters from '../components/CalendarFilters.astro';
import MatchListItem from '../components/MatchListItem.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { getCollection } from 'astro:content';
import { buildMatchSlug } from '../lib/match-photos';
import {
  fetchAcademyFeed,
  academyCategoryToWeb,
  formatMatchDate,
  formatMatchTime,
  type AcademyMatch,
  type WebCategorySlug,
} from '../lib/academy-feed';

// ---------------------------------------------------------------------------
// Feed en vivo: convocatorias de la app de gestión (FutbolPro Academy).
// GET {ACADEMY_API_URL}/api/public/matches -> { upcoming, played }.
// Sin auth y con CORS abierto; solo expone datos aptos para publicar.
// Si el feed falla o viene vacío, se usan los arreglos locales de respaldo.
// ---------------------------------------------------------------------------

interface CalendarMatchItem {
  categorySlug: WebCategorySlug;
  categoryLabel: string;
  date: string;
  time?: string;
  team1: string;
  team2: string;
  venue: string;
  photosHref?: string;
  past: boolean;
  score?: string;
  opponentLogo?: string;
}

function toCalendarItem(m: AcademyMatch, past: boolean): CalendarMatchItem {
  const cat = academyCategoryToWeb(m.category);
  return {
    categorySlug: cat.slug,
    categoryLabel: cat.label,
    date: formatMatchDate(m.matchDate),
    time: formatMatchTime(m.matchTime),
    team1: `PCFC ${cat.short}`,
    team2: m.opponent || 'Rival por confirmar',
    venue: m.location || (m.isHome ? 'Cancha Principal · PCFC' : 'Por confirmar'),
    photosHref: undefined,
    past,
    score: m.result ? `${m.result.home} - ${m.result.away}` : undefined,
    opponentLogo: m.opponentLogo || undefined,
  };
}

// NOTA: el fetch del feed en vivo y las listas display van DESPUÉS de los
// arreglos de respaldo (const no admite uso anticipado).

// Próximos partidos (anticipación) — datos locales de respaldo.
// Si el feed en vivo de la app de gestión responde, se usa ese en su lugar.
const fallbackUpcomingMatches: CalendarMatchItem[] = [
  {
    categorySlug: 'elite',
    categoryLabel: 'Elite / Reserva',
    date: 'Sáb 13 sep',
    time: '10:00 AM',
    team1: 'PCFC',
    team2: 'Atlético Bávaro',
    venue: 'Cancha Principal · PCFC',
    photosHref: undefined,
    past: false,
  },
  {
    categorySlug: 'form-alta',
    categoryLabel: 'Formativas Altas',
    date: 'Dom 14 sep',
    time: '9:00 AM',
    team1: 'PCFC Sub-15',
    team2: 'Moca FC',
    venue: 'Cancha Auxiliar · PCFC',
    photosHref: undefined,
    past: false,
  },
  {
    categorySlug: 'form-baja',
    categoryLabel: 'Formativas Bajas',
    date: 'Sáb 20 sep',
    time: '11:00 AM',
    team1: 'PCFC Sub-12',
    team2: 'San Cristóbal FC',
    venue: 'Estadio Garrik',
    photosHref: undefined,
    past: false,
  },
  {
    categorySlug: 'pre',
    categoryLabel: 'Pre-Formativas',
    date: 'Dom 21 sep',
    time: '10:30 AM',
    team1: 'PCFC Sub-8',
    team2: 'Escuela Bavaro',
    venue: 'Cancha 3 · PCFC',
    photosHref: undefined,
    past: false,
  },
  {
    categorySlug: 'form-alta',
    categoryLabel: 'Formativas Altas',
    date: 'Sáb 27 sep',
    time: '4:00 PM',
    team1: 'PCFC Sub-14',
    team2: 'Selección Federativa',
    venue: 'Florer Puerto',
    photosHref: undefined,
    past: false,
  },
  {
    categorySlug: 'elite',
    categoryLabel: 'Elite / Reserva',
    date: 'Dom 28 sep',
    time: '3:00 PM',
    team1: 'PCFC Reserva',
    team2: 'Higüey United',
    venue: 'Cancha Principal · PCFC',
    photosHref: undefined,
    past: false,
  },
];

// Partidos jugados (recuerdo) — respaldo local si el feed en vivo falla.
const fallbackPastMatches: CalendarMatchItem[] = [
  {
    categorySlug: 'elite',
    categoryLabel: 'Elite / Reserva',
    date: 'Sáb 6 sep',
    time: '10:00 AM',
    team1: 'PCFC',
    team2: 'Atlántico FC',
    venue: 'Cancha Principal · PCFC',
    photosHref: '/fotos#pcfc-vs-atlantico-6sep',
    past: true,
  },
  {
    categorySlug: 'form-alta',
    categoryLabel: 'Formativas Altas',
    date: 'Sáb 30 ago',
    time: '4:00 PM',
    team1: 'PCFC Sub-15',
    team2: 'Santiago FC',
    venue: 'Cancha Auxiliar · PCFC',
    photosHref: '/fotos#pcfc-sub15-vs-santiago-30ago',
    past: true,
  },
  {
    categorySlug: 'form-baja',
    categoryLabel: 'Formativas Bajas',
    date: 'Dom 24 ago',
    time: '11:00 AM',
    team1: 'PCFC Sub-10',
    team2: 'Canay FC',
    venue: 'Caseral',
    photosHref: '/fotos#pcfc-sub10-vs-canay-24ago',
    past: true,
  },
  {
    categorySlug: 'pre',
    categoryLabel: 'Pre-Formativas',
    date: 'Sáb 16 ago',
    time: '9:30 AM',
    team1: 'PCFC Sub-6',
    team2: 'Casa España',
    venue: 'Casa España',
    photosHref: '/fotos#pcfc-sub6-vs-casa-espana-16ago',
    past: true,
  },
  {
    categorySlug: 'form-alta',
    categoryLabel: 'Formativas Altas',
    date: 'Sáb 9 ago',
    time: '4:00 PM',
    team1: 'PCFC Sub-13',
    team2: 'Casa España',
    venue: 'Casa España',
    photosHref: undefined,
    past: true,
  },
];

// Galerías publicadas (colección match_photos): solo esas enlazan "Ver fotos".
// Las nuevas fechas del feed se crean como draft (published: false) vía
// `pnpm sync:match-photos` y no enlazan hasta tener fotos.
const publishedGalleries = new Set(
  (await getCollection('match_photos'))
    .filter((e) => e.data.published && (e.data.photos?.length ?? 0) > 0)
    .map((e) => e.slug),
);

// Feed en vivo (después de los respaldos por el TDZ de const).
const feed = await fetchAcademyFeed();
let liveUpcoming: CalendarMatchItem[] = feed.upcoming.map((m: AcademyMatch) =>
  toCalendarItem(m, false),
);
let livePlayed: CalendarMatchItem[] = feed.played.map((m: AcademyMatch) => {
  const item = toCalendarItem(m, true);
  const slug = buildMatchSlug(item.team1, item.team2, m.matchDate);
  if (publishedGalleries.has(slug)) item.photosHref = `/fotos#${slug}`;
  return item;
});

const displayUpcoming: CalendarMatchItem[] =
  liveUpcoming.length > 0 ? liveUpcoming : fallbackUpcomingMatches;
const displayPast: CalendarMatchItem[] =
  livePlayed.length > 0 ? livePlayed : fallbackPastMatches;
---

<Base
  title="Calendario"
  description="Calendario completo de partidos de Punta Cana FC. Próximos encuentros y resultados de las cuatro categorías formativas."
>
  <!-- ============================================ -->
  <!-- HERO — Calendario -->
  <!-- ============================================ -->
  <section
    class="hero-with-image text-white pt-[clamp(6rem,12vw,9rem)] pb-[clamp(4rem,8vw,6rem)] relative"
  >
    <StockImage
      name="partido-sub13"
      alt="Partido de fútbol juvenil en cancha de Punta Cana FC"
      className="absolute inset-0 w-full h-full object-cover object-[center_30%]"
      width={1600}
      height={1200}
      loading="eager"
    />
    <div class="hero-overlay"></div>
    <div class="container-x relative z-10">
      <p class="eyebrow eyebrow--on-navy">Temporada 2026</p>
      <h1 class="h-display h-display--on-navy text-[clamp(2.5rem,6vw,4.5rem)] mb-5 max-w-[16ch]">
        Calendario
      </h1>
      <p class="lede lede--on-navy max-w-[52ch]">
        Todos los partidos de la temporada, organizados por categoría. Marca tu calendario, filtra
        por equipo y no te pierdas ningún encuentro de tu hijo.
      </p>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- FILTROS — control -->
  <!-- ============================================ -->
  <section class="bg-pure-white py-10 border-b border-navy/10">
    <div class="container-x flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <h2 class="font-display text-[1.25rem] uppercase text-navy leading-tight">
          Filtra por categoría
        </h2>
        <p class="text-[0.85rem] text-navy-60 mt-1">
          Encuentra rápidamente los partidos de tu equipo.
        </p>
      </div>
      <CalendarFilters />
    </div>
  </section>

  <!-- ============================================ -->
  <!-- PRÓXIMOS PARTIDOS — anticipación -->
  <!-- ============================================ -->
  <section class="section bg-white">
    <div class="container-x">
      <SectionHeader
        eyebrow="Esta semana"
        title="PRÓXIMOS<br />PARTIDOS"
        subtitle="Consulta los próximos partidos de cada categoría. Filtra por edad y formato, y planifica tu asistencia."
      />

      <ul
        id="match-list"
        class="list-none bg-white border border-navy/10 rounded-lg overflow-hidden"
        role="list"
        aria-label="Próximos partidos"
      >
        {
          displayUpcoming.map((match) => (
            <MatchListItem
              categorySlug={match.categorySlug}
              categoryLabel={match.categoryLabel}
              date={match.date}
              time={match.time}
              team1={match.team1}
              team2={match.team2}
              venue={match.venue}
              photosHref={match.photosHref}
              past={match.past}
              score={match.score}
              opponentLogo={match.opponentLogo}
            />
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- PARTIDOS JUGADOS — recuerdo -->
  <!-- ============================================ -->
  <section class="section bg-pure-white border-t border-navy/10">
    <div class="container-x">
      <SectionHeader
        eyebrow="Lo que vivimos"
        title="PARTIDOS<br />JUGADOS"
        subtitle="Revive los momentos clave de los partidos recientes. Cada encuentro tiene su galería de fotos."
      />

      <ul
        class="list-none bg-white border border-navy/10 rounded-lg overflow-hidden"
        role="list"
        aria-label="Partidos jugados"
      >
        {
          displayPast.map((match) => (
            <MatchListItem
              categorySlug={match.categorySlug}
              categoryLabel={match.categoryLabel}
              date={match.date}
              time={match.time}
              team1={match.team1}
              team2={match.team2}
              venue={match.venue}
              photosHref={match.photosHref}
              past={match.past}
              score={match.score}
              opponentLogo={match.opponentLogo}
            />
          ))
        }
      </ul>

      <div class="mt-12 text-center">
        <a href="/fotos" class="btn btn--primary btn--lg">
          Ver galería completa
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</Base>
