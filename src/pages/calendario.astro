    categoryLabel: "Elite / Reserva",
    date: "Sáb 6 sep",
    time: "10:00 AM",
    team1: "PCFC",
    team2: "Atlántico FC",
    venue: "Cancha Principal · PCFC",
    photosHref: "/fotos/pcfc-vs-atlantico-6sep",
