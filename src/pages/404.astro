---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada" description="La página que buscas no existe o fue movida." noindex>
  <main class="container-x py-24 text-center min-h-[60vh] flex flex-col items-center justify-center">
    <p class="eyebrow">Error 404</p>
    <h1 class="h-section mt-4 mb-4">Página no encontrada</h1>
    <p class="lede max-w-[48ch] mx-auto mb-8">
      La dirección que buscas no existe o cambió de lugar.
    </p>
    <a href="/" class="btn btn--primary">Volver al inicio</a>
  </main>
</Base>
