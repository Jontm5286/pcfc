---
/**
 * Sponsors Debug Page — PCFC + EmDash CMS
 * ========================================
 * Página de diagnóstico para inspeccionar la colección de sponsors.
 * Acceder en: /dev/sponsors-debug
 */

// import { getEmDashCollection } from 'emdash';
import { getCollection } from 'astro:content';
import { resolveLogoUrl, getSponsorsFromEmDash } from '../../lib/content';

// 1. getEmDashCollection RAW
let emdashRaw: any = null;
let emdashError: string | null = null;
try {
  // emdashRaw = await getEmDashCollection('sponsors');
} catch (err) {
  emdashError = err instanceof Error ? err.message : String(err);
}

// 2. getCollection (Astro JSON files)
let astroCollection: any[] = [];
let astroError: string | null = null;
try {
  const items = await getCollection('sponsors');
  astroCollection = items.map(i => ({
    slug: i.slug,
    id: i.id,
    ...i.data,
  }));
} catch (err) {
  astroError = err instanceof Error ? err.message : String(err);
}

// 3. Helper getSponsorsFromEmDash
let helperResult: any[] = [];
let helperError: string | null = null;
try {
  helperResult = await getSponsorsFromEmDash();
} catch (err) {
  helperError = err instanceof Error ? err.message : String(err);
}

const resolvedLogos = (helperResult || []).map(s => ({
  name: s.name,
  raw_logo: s.logo,
  resolved: resolveLogoUrl(s.logo),
}));
---

<!DOCTYPE html>
<html lang="es-DO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sponsors Debug | PCFC</title>
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: #0a0e27;
        color: #e4e6eb;
        padding: 2rem;
        margin: 0;
      }
      h1 { color: #4dd0e1; border-bottom: 2px solid #4dd0e1; padding-bottom: 0.5rem; }
      h2 { color: #ffd54f; margin-top: 2rem; }
      h3 { color: #81c784; margin-top: 1rem; }
      .section {
        background: #1a1f3a;
        border: 1px solid #2d3561;
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
      }
      .ok { color: #81c784; }
      .error { color: #ff5252; background: #2d1a1a; padding: 1rem; border-radius: 4px; }
      .empty { color: #ff9800; background: #2d2719; padding: 1rem; border-radius: 4px; }
      pre {
        background: #0a0e27;
        border: 1px solid #2d3561;
        border-radius: 4px;
        padding: 1rem;
        overflow-x: auto;
        font-size: 0.85rem;
      }
      .count {
        display: inline-block;
        background: #4dd0e1;
        color: #0a0e27;
        padding: 0.25rem 0.75rem;
        border-radius: 12px;
        font-weight: bold;
        font-size: 0.9rem;
      }
      .sponsor-card {
        background: #0a0e27;
        border: 1px solid #2d3561;
        border-radius: 6px;
        padding: 1rem;
        margin-bottom: 0.5rem;
      }
      .logo-preview {
        max-width: 100px;
        max-height: 40px;
        margin-top: 0.5rem;
        background: white;
        padding: 4px;
        border-radius: 4px;
      }
    </style>
  </head>
  <body>
    <h1>🔍 Sponsors Debug — EmDash CMS</h1>
    <p>Diagnóstico de la colección <code>sponsors</code> desde múltiples fuentes.</p>

    <!-- 1. getEmDashCollection RAW -->
    <div class="section">
      <h2>1. <code>getEmDashCollection('sponsors')</code> — RAW</h2>
      {emdashError && (
        <div class="error">
          <strong>❌ ERROR:</strong> {emdashError}
        </div>
      )}

      {!emdashError && emdashRaw && (
        <div>
          <p>
            {emdashRaw.entries && emdashRaw.entries.length > 0 ? (
              <span class="count">✅ {emdashRaw.entries.length} entries</span>
            ) : (
              <span class="count">⚠️ 0 entries</span>
            )}
          </p>
          {emdashRaw.entries && emdashRaw.entries.length > 0 ? (
            <details>
              <summary>Ver datos RAW</summary>
              <pre>{JSON.stringify(emdashRaw.entries.slice(0, 2), null, 2)}</pre>
            </details>
          ) : (
            <div class="empty">
              ⚠️ La colección está VACÍA. Verifica que <code>live.config.ts</code> tenga la Live Collection <code>_emdash</code> registrada.
            </div>
          )}
        </div>
      )}
    </div>

    <!-- 2. getCollection (JSON) -->
    <div class="section">
      <h2>2. <code>getCollection('sponsors')</code> — JSON Files</h2>
      {astroError && (
        <div class="error">
          <strong>❌ ERROR:</strong> {astroError}
        </div>
      )}
      {!astroError && (
        <p>
          Archivos JSON: <span class="count">{astroCollection.length}</span>
        </p>
      )}
    </div>

    <!-- 3. Helper -->
    <div class="section">
      <h2>3. <code>getSponsorsFromEmDash()</code> — Helper</h2>
      {helperError && (
        <div class="error">
          <strong>❌ ERROR:</strong> {helperError}
        </div>
      )}
      {!helperError && (
        <p>
          Sponsors procesados: <span class="count">{helperResult.length}</span>
        </p>
      )}

      {helperResult.length > 0 && (
        <div>
          <h3>Sponsors:</h3>
          {helperResult.map((s, i) => (
            <div class="sponsor-card">
              <strong>#{i + 1} {s.name}</strong>
              <br/>
              <small>href: <code>{s.href || '(vacío)'}</code></small>
              <br/>
              <small>logo raw: <code>{s.logo?.substring(0, 80)}</code></small>
              <br/>
              <small>logo resolved: <code>{resolveLogoUrl(s.logo).substring(0, 80)}</code></small>
              <img src={resolveLogoUrl(s.logo)} alt={s.name} class="logo-preview" onerror="this.style.background='#ff5252'; this.alt='❌ Error'" />
            </div>
          ))}
        </div>
      )}
    </div>

    <!-- 4. Checklist -->
    <div class="section">
      <h2>4. 📋 Checklist de Configuración</h2>
      <ul>
        <li>✅ <code>src/live.config.ts</code> existe con Live Collection <code>_emdash</code></li>
        <li>✅ Import de <code>emdashLoader</code> desde <code>'emdash/runtime'</code></li>
        <li>✅ <code>src/content.config.ts</code> NO usa <code>emdashLoader()</code> (solo <code>type: "data"</code>)</li>
        <li>✅ DB EmDash tiene sponsors con <code>status='published'</code></li>
      </ul>
    </div>

    <p style="margin-top:3rem; text-align:center; opacity:0.5;">
      PCFC Debug • {new Date().toISOString()}
    </p>
  </body>
</html>
