---
/**
 * /fotos/todas — PCFC
 * Archivo de galerías por partido: SSR contra la D1 en vivo + resto vía
 * botón "Cargar más" contra GET /api/fotos (respeta ?pagina=N).
 */
import Base from '../../layouts/Base.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getAllPosts, getPostsPage } from '../../lib/fotos-posts';

export const prerender = false;

const PER_PAGE = 10;

const { posts } = await getAllPosts();
const totalPages = Math.max(1, Math.ceil(posts.length / PER_PAGE));

// SSR: cada request lee la D1 en vivo; las páginas 2+ llegan en
// cliente vía GET /api/fotos (botón "Cargar más", respeta ?pagina=N).
const pagePosts = (await getPostsPage(1, PER_PAGE)).posts;

const title = 'Archivo de fotos por partido | Punta Cana FC';
const description =
  'Archivo completo de galerías de fotos de los partidos de Punta Cana FC, 10 partidos por página.';
---

<Base title={title} description={description}>
  <section class="section bg-white pt-[clamp(6rem,12vw,9rem)]">
    <div class="container-x">
      <div class="mb-10">
        <p class="eyebrow mb-3">ARCHIVO</p>
        <h1 class="h-section text-[clamp(1.75rem,4vw,2.75rem)] mb-2">Fotos por partido</h1>
        <p class="lede text-[0.95rem]" id="archivo-lede" data-total-pages={totalPages}>
          {posts.length} partidos con galería · página <span id="archivo-pagina">1</span> de {totalPages}. Toca el corazón
          para votar por tus fotos favoritas.
        </p>
        <a href="/fotos" class="btn btn--outline mt-5">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Volver a destacadas
        </a>
      </div>
    </div>
  </section>

  <div id="partidos">
  {
    pagePosts.map((post, i) => (
      <section
        id={post.id}
        class="section bg-pure-white border-t border-navy/10"
        aria-labelledby={`post-heading-${post.id}`}
      >
        <div class="container-x">
          <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8 pb-6 border-b border-navy/10">
            <div>
              <span class={`badge badge--${post.categorySlug} mb-3`}>{post.categoryLabel}</span>
              <h2
                id={`post-heading-${post.id}`}
                class="h-section text-[clamp(1.5rem,3vw,2.25rem)] text-navy max-w-[22ch]"
              >
                {post.title}
              </h2>
              <time datetime={post.date} class="mt-2 text-[0.9rem] text-navy-60 font-medium">
                {[post.date, `${post.photoCount} fotos`].filter(Boolean).join(' · ')}
              </time>
            </div>
          </div>

          <GalleryGrid photos={post.photos} galleryId={post.id} likes={true} eager={i === 0} />
        </div>
      </section>
    ))
  }
  </div>

  {
    totalPages > 1 && (
      <nav
        class="section bg-white border-t border-navy/10"
        aria-label="Paginación del archivo de fotos"
        id="cargar-mas-wrap"
        data-total-pages={totalPages}
      >
        <div class="container-x flex flex-wrap items-center justify-center gap-2">
          <button type="button" class="btn btn--primary btn--lg" id="cargar-mas">
            Cargar más partidos
          </button>
        </div>
        <p
          class="mt-3 text-center text-[0.85rem] text-navy-60 font-medium"
          id="cargar-mas-estado"
        >
        </p>
      </nav>
    )
  }

  <script>
    // "Cargar más" — páginas 2+ del archivo vía GET /api/fotos (híbrida).
    // Replica el grid completo por partido. Respeta ?pagina=N en deep links.
    (function () {
      type ApiPhoto = { src: string; alt?: string | null; caption?: string | null };
      type ApiPost = {
        id: string; title: string; date?: string | null; photoCount: number;
        categorySlug: string; categoryLabel: string; photos?: ApiPhoto[];
      };
      type ApiPage = { posts?: ApiPost[]; totalPages?: number };
      var wrap = document.getElementById('cargar-mas-wrap');
      var btn = document.getElementById('cargar-mas') as HTMLButtonElement | null;
      var estado = document.getElementById('cargar-mas-estado');
      var list = document.getElementById('partidos');
      var ledeNum = document.getElementById('archivo-pagina');
      if (!wrap || !btn || !list) return;
      const wrapEl = wrap;
      const btnEl = btn;
      const listEl = list;
      var PER_PAGE = 10;
      var serverTotal = Number(wrapEl.getAttribute('data-total-pages') || '1');
      var params = new URLSearchParams(window.location.search);
      var raw = parseInt(params.get('pagina') || '1', 10);
      var requested = isNaN(raw) || raw < 1 ? 1 : raw;
      var page = 1;
      var loading = false;

      function esc(s: unknown): string {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c: string): string {
          return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>)[c];
        });
      }

      function likeSvg() {
        return '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>';
      }

      function itemHtml(postId: string, ph: ApiPhoto, idx: number, total: number): string {
        var alt = esc(ph.alt || ('Foto ' + idx + ' de ' + total));
        var caption = ph.caption
          ? '<span class="absolute bottom-2 left-2 right-2 text-left caption text-white text-[0.7rem] leading-snug bg-navy/55 rounded px-1.5 py-0.5 line-clamp-2">' +
            esc(ph.caption) + '</span>'
          : '';
        return (
          '<div class="gallery-item-wrap group relative aspect-[4/5] overflow-hidden bg-navy-05 border border-navy/10 rounded-md transition-[box-shadow,border-color,transform] duration-200 hover:shadow-[0_4px_20px_rgba(0,40,92,0.12)] hover:border-navy/25 active:scale-[0.98]">' +
          '<button type="button" class="gallery-item absolute inset-0 w-full h-full cursor-pointer" data-photo-index="' + idx +
          '" aria-label="Abrir foto ' + (idx + 1) + ' de ' + total + ': ' + alt + '">' +
          '<img src="' + esc(ph.src) + '" alt="' + alt + '" loading="lazy" ' +
          'class="w-full h-full object-cover transition-transform duration-300 ease-[cubic-bezier(0.23,1,0.32,1)] group-hover:scale-[1.03]" />' +
          caption + '</button>' +
          '<button type="button" class="like-btn" data-photo-key="' + esc(postId) + ':' + idx +
          '" aria-pressed="false" aria-label="Me gusta esta foto" title="Me gusta">' +
          likeSvg() + '<span class="like-count" data-like-count>0</span></button></div>'
        );
      }

      function sectionHtml(post: ApiPost): string {
        var photos: ApiPhoto[] = post.photos || [];
        var meta = [post.date, post.photoCount + ' fotos'].filter(Boolean).join(' · ');
        var items = photos.map(function (ph: ApiPhoto, i: number): string { return itemHtml(post.id, ph, i, photos.length); }).join('');
        return (
          '<section id="' + esc(post.id) + '" aria-labelledby="post-heading-' + esc(post.id) + '" class="section bg-pure-white border-t border-navy/10"><div class="container-x">' +
          '<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8 pb-6 border-b border-navy/10"><div>' +
          '<span class="badge badge--' + esc(post.categorySlug) + ' mb-3">' + esc(post.categoryLabel) + '</span>' +
          '<h2 id="post-heading-' + esc(post.id) + '" class="h-section text-[clamp(1.5rem,3vw,2.25rem)] text-navy max-w-[22ch]">' + esc(post.title) + '</h2>' +
          '<time datetime="' + esc(post.date) + '" class="mt-2 text-[0.9rem] text-navy-60 font-medium">' + esc(meta) + '</time>' +
          '</div>' +
          '<a href="/fotos/' + esc(post.id) + '" class="btn btn--outline shrink-0">Abrir galería completa</a></div>' +
          '<div class="gallery-grid grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3" data-component="gallery-grid" data-gallery-id="' + esc(post.id) + '">' +
          items + '</div></div></section>'
        );
      }

      function syncUrl(n: number): void {
        params.set('pagina', String(n));
        history.replaceState(null, '', window.location.pathname + '?' + params.toString());
      }

      function loadPage(n: number): Promise<void> {
        if (loading) return Promise.resolve();
        loading = true;
        btnEl.disabled = true;
        if (estado) estado.textContent = 'Cargando partidos…';
        return fetch('/api/fotos?page=' + n + '&limit=' + PER_PAGE)
          .then(function (res: Response): Promise<ApiPage> {
            if (!res.ok) throw new Error('http ' + res.status);
            return res.json();
          })
          .then(function (data: ApiPage): Promise<void> {
            var totalPages = data.totalPages || serverTotal;
            var apiPosts: ApiPost[] = data.posts || [];
            listEl.insertAdjacentHTML('beforeend', apiPosts.map(sectionHtml).join(''));
            var w = window as unknown as { __pcfcBindLikes?: (root?: ParentNode) => Promise<void> };
            var bind = typeof w.__pcfcBindLikes === 'function' ? w.__pcfcBindLikes(listEl) : Promise.resolve();
            return bind.then(function (): void {
              page = n;
              syncUrl(n);
              if (ledeNum) ledeNum.textContent = String(n);
              if (estado) estado.textContent = '';
              if (n >= totalPages) wrapEl.hidden = true;
              else btnEl.disabled = false;
            });
          })
          .catch(function (): void {
            if (estado) estado.textContent = 'No se pudo cargar. Intenta de nuevo.';
            btnEl.disabled = false;
          })
          .then(function (): void { loading = false; });
      }

      btnEl.addEventListener('click', function (): void { loadPage(page + 1); });

      var target = Math.min(requested, serverTotal);
      if (target > 1) {
        var chain: Promise<void> = Promise.resolve();
        for (var n = 2; n <= target; n += 1) {
          (function (nn: number): void { chain = chain.then(function (): Promise<void> { return loadPage(nn); }); })(n);
        }
      } else if (requested > serverTotal) {
        wrapEl.hidden = true;
      }
    })();
  </script>

  <Lightbox />
</Base>
