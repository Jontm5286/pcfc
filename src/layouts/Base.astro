---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import FixturesBar from '../components/FixturesBar.astro';
import Footer from '../components/Footer.astro';
import Reveal from '../components/Reveal.astro';

interface Props {
  title: string;
  description?: string;
  showFixtures?: boolean;
  noindex?: boolean;
  /** JSON-LD adicional de la página (BreadcrumbList, FAQPage, etc.). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Academia premium de fútbol en Punta Cana. Entrenamiento profesional, formación integral y desarrollo de alto rendimiento para jugadores de 4 a 19 años.',
  showFixtures = false,
  noindex = false,
  jsonLd,
} = Astro.props;

// URL canónica de la página: Astro.site ya termina en "/", así que se resuelve
// contra el pathname (que empieza por "/") para no duplicar la barra.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Punta Cana FC</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/Logo-PCFC.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Preconnect para fonts (performance) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Preconnect a imágenes remotas temporales (logos Academy/placeholders) -->
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />

    <!-- Google Fonts con display=swap para evitar FOIT -->
    <link
      href="https://fonts.googleapis.com/css2?family=Bowlby+One+SC&family=Inter:wght@400;500;600;700&family=Montserrat:wght@400;700;900&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />

    <!-- Fallback para navegadores sin soporte -->
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Bowlby+One+SC&family=Inter:wght@400;500;600;700&family=Montserrat:wght@400;700;900&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <link rel="canonical" href={pageUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Microsoft Clarity (ID yxo8cx0zsl) + Google Analytics 4
      (G-SS9SN2G5DQ): se cargan tras window load para no frenar el primer render. -->
    <script is:inline>
      window.addEventListener('load', function () {
        (function (c, l, a, r, i, t, y) {
          c[a] =
            c[a] ||
            function () {
              (c[a].q = c[a].q || []).push(arguments);
            };
          t = l.createElement(r);
          t.async = 1;
          t.src = 'https://www.clarity.ms/tag/' + i;
          y = l.getElementsByTagName(r)[0];
          y.parentNode.insertBefore(t, y);
        })(window, document, 'clarity', 'script', 'yxo8cx0zsl');
        const g = document.createElement('script');
        g.async = 1;
        g.src = 'https://www.googletagmanager.com/gtag/js?id=G-SS9SN2G5DQ';
        document.head.appendChild(g);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        window.gtag('config', 'G-SS9SN2G5DQ');
      });
    </script>
    <link rel="alternate" hreflang="es" href={pageUrl} />
    <link rel="alternate" hreflang="x-default" href={pageUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_DO" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Punta Cana FC — Academia premium de fútbol en Punta Cana"
    />
    <meta property="og:site_name" content="Punta Cana FC" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site).href} />
    <meta
      name="twitter:image:alt"
      content="Punta Cana FC — Academia premium de fútbol en Punta Cana"
    />
    <meta name="twitter:site" content="@puntacanafc" />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SportsClub',
        name: 'Punta Cana FC',
        alternateName: 'PCFC',
        url: Astro.site?.href,
        logo: new URL('/Logo-PCFC.svg', Astro.site).href,
        description: description,
        telephone: '+1-829-246-4756',
        email: 'info@puntacanafc.com',
        foundingDate: '2017-01-20',
        founder: [
          { '@type': 'Person', name: 'Luis Flores' },
          { '@type': 'Person', name: 'Ana Clara Flores' },
        ],
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Punta Cana',
          addressRegion: 'La Altagracia',
          addressCountry: 'DO',
        },
        areaServed: ['Punta Cana', 'Bávaro', 'La Altagracia'],
        sport: 'Football',
        sameAs: ['https://www.instagram.com/puntacanafc', 'https://www.facebook.com/puntacanafc'],
      })}
    />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>

    <header id="fixtures-bar" class="bg-[rgba(5,19,41,0.95)] border-b border-[rgba(12,30,61,0.64)]">
      {showFixtures && <FixturesBar />}
    </header>
    <script is:inline>
      // Oculta la cinta FixturesBar al hacer scroll (el usuario la quiere
      // visible solo arriba del todo). Sin dependencias, pasivo.
      (function () {
        const bar = document.getElementById('fixtures-bar');
        if (!bar || bar.children.length === 0) return;
        const onScroll = function () {
          bar.style.display = window.scrollY > 60 ? 'none' : '';
        };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      })();
    </script>
    <Navbar />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <Reveal />

    <!-- Banner básico de consentimiento de cookies -->
    <div
      id="cookie-banner"
      style="position:fixed;bottom:0;left:0;right:0;background:rgba(5,19,41,0.95);color:#fff;padding:1rem 1.25rem;display:none;z-index:200;border-top:1px solid rgba(255,255,255,0.1);font-family:sans-serif;font-size:0.85rem;"
    >
      <div
        style="max-width:1100px;margin:0 auto;display:flex;align-items:center;gap:1rem;flex-wrap:wrap;"
      >
        <span>Utilizamos cookies para mejorar la experiencia. Al continuar aceptas su uso.</span>
        <button
          onclick="this.closest('#cookie-banner').style.display='none';localStorage.setItem('cookies_accepted','1');"
          style="margin-left:auto;background:#0ea5e9;color:#fff;border:none;padding:0.5rem 1rem;border-radius:4px;cursor:pointer;font-weight:600;"
          >Entendido</button
        >
      </div>
    </div>
    <script is:inline>
      if (localStorage.getItem('cookies_accepted') !== '1') {
        document.getElementById('cookie-banner').style.display = 'block';
      }
    </script>
  </body>
</html>
