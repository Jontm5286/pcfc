---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import FixturesBar from "../components/FixturesBar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  showFixtures?: boolean;
}

const {
  title,
  description = "Academia premium de fútbol en Punta Cana. Entrenamiento profesional, formación integral y desarrollo de alto rendimiento para jugadores de 4 a 19 años.",
  showFixtures = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Punta Cana FC</title>
    <meta name="description" content={description} />

    <!-- Preconnect para fonts (performance) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Google Fonts con display=swap para evitar FOIT -->
    <link
      href="https://fonts.googleapis.com/css2?family=Bowlby+One+SC&family=Inter:wght@400;500;600;700&family=Montserrat:wght@400;700;900&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />

    <!-- Fallback para navegadores sin soporte -->
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Bowlby+One+SC&family=Inter:wght@400;500;600;700&family=Montserrat:wght@400;700;900&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <link rel="canonical" href={Astro.site + Astro.url.pathname} />
    <link rel="alternate" hreflang="es" href={Astro.site + Astro.url.pathname} />
    <link rel="alternate" hreflang="x-default" href={Astro.site + Astro.url.pathname} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_DO" />
    <meta property="og:url" content={Astro.site + Astro.url.pathname} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/Logo-PCFC.svg", Astro.site).href} />
    <meta property="og:site_name" content="Punta Cana FC" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/Logo-PCFC.svg", Astro.site).href} />
    <meta name="twitter:site" content="@puntacanafc" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SportsOrganization",
      "name": "Punta Cana FC",
      "alternateName": "PCFC",
      "url": Astro.site?.href,
      "logo": new URL("/Logo-PCFC.svg", Astro.site).href,
      "description": description,
      "telephone": "+1-809-000-0000",
      "email": "info@puntacanafc.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Punta Cana",
        "addressRegion": "La Altagracia",
        "addressCountry": "DO"
      },
      "sport": "Football",
      "sameAs": [
        "https://www.instagram.com/puntacanafc",
        "https://www.facebook.com/puntacanafc"
      ]
    })} />
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>

    <header
      class="sticky top-0 z-[100] bg-[rgba(5,19,41,0.95)] border-b border-[rgba(12,30,61,0.64)]"
    >
      {showFixtures && <FixturesBar />}
      <Navbar />
    </header>

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>
