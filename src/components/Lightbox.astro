---
/**
 * Lightbox — PCFC
 * Overlay a pantalla completa para ver fotos en grande y descargarlas.
 * Sigue DESIGN.md §7 (Lightbox):
 *   - Overlay rgba(0,20,40,0.92)
 *   - Foto centrada, max-height 85vh
 *   - Botones: cerrar (×), descargar ↓, flechas ← →
 *   - Keyboard: Escape cierra, flechas navegan
 *   - Descarga: botón ↓ descarga la foto original sin compresión
 *
 * Uso: incluir <Lightbox /> una vez por página. Escucha el evento
 * `photo:open` emitido por <GalleryGrid /> y muestra la foto correspondiente.
 *
 * Props:
 *   - defaultGalleryId?: string  Si se define, sólo abre fotos del grid
 *                                que coincida con este id. Útil cuando hay
 *                                varios grids en la misma página.
 */

interface Props {
  defaultGalleryId?: string;
}

const { defaultGalleryId } = Astro.props;
---

<div
  class="lightbox"
  data-component="lightbox"
  data-default-gallery-id={defaultGalleryId}
  role="dialog"
  aria-modal="true"
  aria-label="Visor de fotos"
  hidden
>
  <!-- Backdrop clickeable para cerrar -->
  <button
    type="button"
    class="lightbox__backdrop"
    data-lightbox-close
    aria-label="Cerrar visor"
  ></button>

  <!-- Contenido del lightbox -->
  <div class="lightbox__content">
    <!-- Botón cerrar -->
    <button
      type="button"
      class="lightbox__btn lightbox__btn--close"
      data-lightbox-close
      aria-label="Cerrar"
    >
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>

    <!-- Botón anterior -->
    <button
      type="button"
      class="lightbox__btn lightbox__btn--prev"
      data-lightbox-prev
      aria-label="Foto anterior"
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="15 18 9 12 15 6" />
      </svg>
    </button>

    <!-- Imagen -->
    <figure class="lightbox__figure">
      <img class="lightbox__img" src="" alt="" />
      <figcaption class="lightbox__caption" data-lightbox-caption></figcaption>
    </figure>

    <!-- Botón siguiente -->
    <button
      type="button"
      class="lightbox__btn lightbox__btn--next"
      data-lightbox-next
      aria-label="Foto siguiente"
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="9 18 15 12 9 6" />
      </svg>
    </button>

    <!-- Barra inferior: contador + descarga -->
    <div class="lightbox__bar">
      <span class="lightbox__counter" data-lightbox-counter>1 / 1</span>
      <a
        class="lightbox__btn lightbox__btn--download"
        data-lightbox-download
        href=""
        download=""
        aria-label="Descargar foto"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
        <span>Descargar</span>
      </a>
    </div>
  </div>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: var(--color-navy-dark);
    opacity: 0.92;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: lightbox-fade-in 180ms ease-out;
  }
  .lightbox[hidden] {
    display: none;
  }

  .lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: transparent;
    border: 0;
    cursor: zoom-out;
  }

  .lightbox__content {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(3.5rem, 8vh, 5rem) clamp(1rem, 4vw, 2.5rem);
  }

  .lightbox__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    max-width: min(92vw, 1400px);
    max-height: 100%;
  }

  .lightbox__img {
    display: block;
    max-width: 100%;
    max-height: 85vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
    background: var(--color-navy-dark);
  }

  .lightbox__caption {
    color: var(--color-white);
    opacity: 0.78;
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.4;
    text-align: center;
    max-width: 60ch;
  }
  .lightbox__caption:empty {
    display: none;
  }

  .lightbox__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--color-white);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 6px;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease;
  }
  .lightbox__btn:hover {
    border-color: var(--color-white);
    background: var(--color-white);
    opacity: 0.08;
  }
  .lightbox__btn:focus-visible {
    outline: 2px solid var(--color-sky);
    outline-offset: 2px;
  }

  .lightbox__btn--close {
    position: absolute;
    top: clamp(1rem, 3vh, 1.75rem);
    right: clamp(1rem, 3vw, 1.75rem);
    width: 44px;
    height: 44px;
    padding: 0;
  }

  .lightbox__btn--prev,
  .lightbox__btn--next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    padding: 0;
  }
  .lightbox__btn--prev { left: clamp(0.5rem, 2vw, 1.25rem); }
  .lightbox__btn--next { right: clamp(0.5rem, 2vw, 1.25rem); }

  .lightbox__btn--download {
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .lightbox__bar {
    position: absolute;
    bottom: clamp(1rem, 3vh, 1.75rem);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-white);
    font-family: var(--font-body);
  }

  .lightbox__counter {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-white);
    opacity: 0.78;
    padding: 0.4rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 4px;
  }

  @media (max-width: 640px) {
    .lightbox__btn--prev,
    .lightbox__btn--next {
      width: 40px;
      height: 40px;
    }
    .lightbox__btn--download span {
      display: none;
    }
  }

  @keyframes lightbox-fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox { animation: none; }
  }
</style>

<script>
  type PhotoEventDetail = {
    galleryId: string;
    index: number;
    photos: Array<{
      src: string;
      alt: string;
      caption?: string;
      downloadName?: string;
    }>;
  };

  interface LightboxState {
    photos: PhotoEventDetail["photos"];
    index: number;
  }

  function setupLightbox(root: HTMLElement) {
    const imgEl = root.querySelector<HTMLImageElement>(".lightbox__img");
    const captionEl = root.querySelector<HTMLElement>("[data-lightbox-caption]");
    const counterEl = root.querySelector<HTMLElement>("[data-lightbox-counter]");
    const downloadEl = root.querySelector<HTMLAnchorElement>(
      "[data-lightbox-download]",
    );
    const prevBtn = root.querySelector<HTMLButtonElement>("[data-lightbox-prev]");
    const nextBtn = root.querySelector<HTMLButtonElement>("[data-lightbox-next]");
    const closeBtns = root.querySelectorAll<HTMLButtonElement>(
      "[data-lightbox-close]",
    );
    if (
      !imgEl ||
      !captionEl ||
      !counterEl ||
      !downloadEl ||
      !prevBtn ||
      !nextBtn
    )
      return;

    const defaultGalleryId = root.dataset.defaultGalleryId || "";
    let state: LightboxState | null = null;

    const render = () => {
      if (!state) return;
      const photo = state.photos[state.index];
      if (!photo) return;
      imgEl.src = photo.src;
      imgEl.alt = photo.alt;
      captionEl.textContent = photo.caption ?? "";
      counterEl.textContent = `${state.index + 1} / ${state.photos.length}`;
      downloadEl.href = photo.src;
      downloadEl.setAttribute(
        "download",
        photo.downloadName || deriveDownloadName(photo.src),
      );
      const hasMany = state.photos.length > 1;
      prevBtn.hidden = !hasMany;
      nextBtn.hidden = !hasMany;
    };

    const open = (photos: PhotoEventDetail["photos"], index: number) => {
      state = { photos, index };
      root.hidden = false;
      document.body.style.overflow = "hidden";
      render();
    };

    const close = () => {
      root.hidden = true;
      document.body.style.overflow = "";
      // Limpia src para liberar memoria en el navegador
      imgEl.src = "";
      imgEl.alt = "";
      state = null;
    };

    const step = (delta: number) => {
      if (!state) return;
      const len = state.photos.length;
      state.index = (state.index + delta + len) % len;
      render();
    };

    document.addEventListener("photo:open", (event) => {
      const e = event as CustomEvent<PhotoEventDetail>;
      if (
        defaultGalleryId &&
        e.detail &&
        e.detail.galleryId &&
        e.detail.galleryId !== defaultGalleryId
      ) {
        return;
      }
      open(e.detail.photos, e.detail.index);
    });

    closeBtns.forEach((btn) => btn.addEventListener("click", close));
    prevBtn.addEventListener("click", () => step(-1));
    nextBtn.addEventListener("click", () => step(1));

    document.addEventListener("keydown", (event) => {
      if (root.hidden) return;
      if (event.key === "Escape") {
        event.preventDefault();
        close();
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        step(-1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        step(1);
      }
    });
  }

  function deriveDownloadName(src: string): string {
    try {
      const url = new URL(src, window.location.href);
      const path = url.pathname.split("/").pop() || "foto.jpg";
      return path;
    } catch {
      return "foto.jpg";
    }
  }

  document
    .querySelectorAll<HTMLElement>('[data-component="lightbox"]')
    .forEach(setupLightbox);
</script>
