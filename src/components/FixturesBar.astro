---
import { fixtures, categoryColors } from '../data/fixtures';
---

<div
  class="bg-navy-05 border-b border-navy-10 shadow-[0_1px_1.75px_rgba(0,0,0,0.05)] overflow-hidden"
  role="region"
  aria-label="Próximos partidos y eventos"
>
  <div class="overflow-hidden">
    <div class="marquee-track flex w-max gap-6 py-2.5 px-[clamp(1.25rem,4vw,2.5rem)]">
      {[...fixtures, ...fixtures].map((fixture) => (
        <div class="fixture-card relative shrink-0 w-[280px] md:w-[280px] w-[80vw] py-2 px-1">
          <div class="flex items-center justify-between mb-1">
            <span class="inline-flex items-center gap-1.5 text-[11px] font-bold text-navy-60 font-body">
              <span
                class="w-2 h-2 rounded-full shrink-0"
                style={`background: ${categoryColors[fixture.category] || '#2563eb'}`}
              ></span>
              {fixture.team1.name}
            </span>
            <span class="text-[10px] font-normal text-navy-60 font-body">
              {fixture.date}
            </span>
          </div>

          <div class="flex items-center justify-between mb-1">
            <span class="inline-flex items-center gap-1.5 text-[12px] font-bold text-navy font-body">
              <span
                class="w-2 h-2 rounded-full shrink-0"
                style={`background: ${fixture.team1.color}`}
              ></span>
              {fixture.category}
            </span>
            <span class="bg-navy-10 text-navy text-[11px] font-bold font-body py-0.5 px-1.5 rounded">
              {fixture.time}
            </span>
          </div>

          <div class="flex items-center justify-between">
            <span class="inline-flex items-center gap-1.5 text-[12px] font-normal text-navy-60 font-body">
              <span
                class="w-2 h-2 rounded-full shrink-0"
                style={`background: ${fixture.team2.color}`}
              ></span>
              {fixture.team2.name}
            </span>
            <span class="text-[10px] font-normal text-navy-60 font-body">
              {fixture.venue}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  /* Marquee animation — keeps the marquee logic isolated so Tailwind doesn't have to ship it */
  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .marquee-track {
    animation: marquee 40s linear infinite;
    will-change: transform;
  }

  /* Pause on hover for accessibility */
  [role="region"]:hover .marquee-track,
  [role="region"]:focus-within .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      transform: none;
    }
  }

  /* Vertical divider on the right of each card, centered in the gap */
  .fixture-card::after {
    content: '';
    position: absolute;
    right: -0.75rem;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 70%;
    background: var(--color-navy-10);
  }

  @media (max-width: 768px) {
    .marquee-track {
      gap: 1rem;
      animation-duration: 28s;
    }
  }
</style>
