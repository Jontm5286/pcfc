---
/**
 * FaqSection — PCFC
 * Sección de preguntas frecuentes con accordion nativo.
 *
 * Props:
 *   - eyebrow?: string          Label superior (default "DUDAS FRECUENTES")
 *   - title?: string           Título de sección (default "Preguntas antes de inscribirte")
 *   - subtitle?: string        Subtítulo descriptivo (default "")
 *   - faqs: FaqItem[]          Array de preguntas/respuestas
 *   - contactEmail?: string    Email de contacto (default "admisiones@puntacanafc.com")
 *   - contactPhone?: string   Teléfono WhatsApp (default "+1 809-652-9450")
 *
 * FaqItem = { question: string; answer: string }
 */

export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  faqs: FaqItem[];
  contactEmail?: string;
  contactPhone?: string;
}

const {
  eyebrow = "DUDAS FRECUENTES",
  title = "Preguntas antes de inscribirte",
  subtitle = "Si no encuentras la respuesta que buscas, escríbenos directamente y te responderemos a la brevedad.",
  faqs,
  contactEmail = "admisiones@puntacanafc.com",
  contactPhone = "+1 809-652-9450",
} = Astro.props;

const whatsappLink = `https://wa.me/${contactPhone.replace(/\D/g, "")}`;
---

<section class="w-full bg-navy-dark" data-component="faq-section">
  <div class="max-w-[1280px] mx-auto px-6 md:px-8 py-16 md:py-20">

    <!-- Header row: eyebrow + title left, subtitle right -->
    <header class="grid grid-cols-1 md:grid-cols-[1fr_auto] md:items-end gap-x-16 gap-y-6 mb-12 md:mb-16">
      <div>
        <p class="eyebrow eyebrow--on-navy">{eyebrow}</p>
        <h2 class="h-section h-section--on-navy">{title}</h2>
      </div>
      <div class="md:text-right max-w-[420px]">
        <p class="lede lede--on-navy">{subtitle}</p>
        <!-- Contact links -->
        <div class="mt-4 flex flex-col sm:flex-row md:flex-col gap-1 sm:gap-4 md:gap-1 items-start md:items-end">
          <a
            href={`mailto:${contactEmail}`}
            class="text-sky hover:text-sky-60 transition-colors duration-200 text-sm font-medium"
          >
            {contactEmail}
          </a>
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener"
            class="text-sky hover:text-sky-60 transition-colors duration-200 text-sm font-medium flex items-center gap-1.5"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 shrink-0" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            {contactPhone}
          </a>
        </div>
      </div>
    </header>

    <!-- FAQ list -->
    <ol class="list-none divide-y divide-white/8" role="list">
      {faqs.map((faq) => (
        <li>
          <details class="faq-item group">
            <summary class="faq-question">
              <span class="faq-indicator" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" class="w-5 h-5">
                  <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </span>
              <span>{faq.question}</span>
            </summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        </li>
      ))}
    </ol>

  </div>
</section>

<style>
  /* Accordion: hide native marker */
  .faq-item summary {
    list-style: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  /* Question row */
  .faq-question {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem 0;
    color: var(--color-white);
    opacity: 0.92;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.45;
    text-align: left;
    width: 100%;
    transition: color 150ms ease;
  }
  .faq-item summary:hover .faq-question {
    color: var(--color-white);
  }

  /* Plus/minus indicator */
  .faq-indicator {
    flex-shrink: 0;
    color: var(--color-navy-30);
    margin-top: 0.1rem;
    transition: color 150ms ease;
  }
  .faq-item summary:hover .faq-indicator {
    color: var(--color-sky);
  }

  /* Rotate + to × when open */
  .faq-item[open] .faq-indicator svg {
    transform: rotate(45deg);
  }
  .faq-indicator svg {
    display: block;
    transition: transform 200ms ease;
  }

  /* Answer panel */
  .faq-answer {
    padding: 0 0 1.5rem 2.5rem;
    color: var(--color-white);
    opacity: 0.72;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.65;
    animation: faq-open 200ms ease forwards;
  }

  @keyframes faq-open {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
