---
/**
 * StockImage — PCFC / FutbolPro
 * Component reutilizable para imágenes de stock optimizadas.
 * Misma API de siempre; por dentro usa <Image /> de Astro + Sharp:
 * genera AVIF + WebP (300/800/1600w) en build/primera petición.
 *
 * Props:
 *   - name: string   — clave del stock (historia, directivo, entrenamiento, partido-sub13, jugadores-cancha)
 *                    o URL directa (http(s)://...) para externas (van con <img> directo)
 *   - alt: string    — texto accesible (REQUERIDO)
 *   - width?: number — ancho intrínseco (para layout shift)
 *   - height?: number
 *   - className?: string — clases Tailwind extra
 *   - loading?: "lazy"|"eager" — default "lazy"
 *
 * WCAG: siempre incluye alt accesible. Si alt vacío → aria-hidden.
 */
import { Picture } from 'astro:assets';

interface Props {
  name: string;
  alt: string;
  width?: number;
  height?: number;
  className?: string;
  loading?: 'lazy' | 'eager';
}

const {
  name,
  alt,
  width = 800,
  height = 600,
  className = '',
  loading = 'lazy',
} = Astro.props;

// Si es URL externa, usar directamente (foto real post-semana)
const isExternal = name.startsWith('http://') || name.startsWith('https://');

// Fuentes locales en src/assets/stock (cualquier extensión soportada)
const stockModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/stock/*.{webp,png,jpg,jpeg,avif}',
  { eager: true },
);

function resolveStock(key: string): ImageMetadata | undefined {
  for (const ext of ['webp', 'png', 'jpg', 'jpeg', 'avif']) {
    const mod = stockModules[`/src/assets/stock/${key}.${ext}`];
    if (mod) return mod.default;
  }
  return undefined;
}

const stockSrc = isExternal ? undefined : resolveStock(name);
---

{isExternal || !stockSrc ? (
  <img
    src={isExternal ? name : '/images/stock/historia-800.webp'}
    alt={alt}
    width={width}
    height={height}
    class:list={[className]}
    loading={loading}
    decoding="async"
    style="content-visibility:auto;contain-intrinsic-size:1280px 720px"
  />
) : (
  <Picture
    src={stockSrc}
    alt={alt}
    width={width}
    height={height}
    widths={[300, 800, 1600]}
    sizes="(max-width: 768px) 300px, (max-width: 1280px) 800px, 1600px"
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    class:list={[className]}
    loading={loading}
    decoding="async"
    style="content-visibility:auto;contain-intrinsic-size:1280px 720px"
  />
)}

<style>
  /* Hero overlay pattern reutilizable */
  .hero-stock-overlay {
    position: relative;
  }
  .hero-stock-overlay::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(7,29,59,0.75) 0%, rgba(7,29,59,0.85) 100%);
    pointer-events: none;
  }
  .hero-stock-img {
    position: relative;
    z-index: 1;
  }
</style>
