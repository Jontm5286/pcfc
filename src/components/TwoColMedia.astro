---
/**
 * TwoColMedia — patrón `.two-col + .text-block + imagen` unificado
 * (antes copiado en club.astro, padres.astro y jugadores.astro).
 *
 * Props:
 *   - eyebrow?: string   — kicker opcional sobre el título
 *   - title: string      — titular de la columna de texto
 *   - paragraphs: string[] — párrafos `.text-block`
 *   - image?: string     — nombre de stock (StockImage), ruta `/...` o URL
 *   - imageAlt?: string  — alt accesible de la imagen
 *   - reverse?: boolean  — invierte el orden (imagen izquierda, texto derecha)
 *
 * Slots:
 *   - default — contenido extra tras los párrafos (p. ej. botones CTA)
 *   - media   — medio personalizado (p. ej. collage); si se usa, `image` se ignora
 */
import StockImage from './StockImage.astro';

interface Props {
  eyebrow?: string;
  title: string;
  paragraphs: string[];
  image?: string;
  imageAlt?: string;
  reverse?: boolean;
}

const { eyebrow, title, paragraphs, image, imageAlt = '', reverse = false } = Astro.props;
const hasMediaSlot = Astro.slots.has('media');
const isPlainImg = !!image && /^(\/|https?:)/.test(image);
---

<div class:list={['tcm', { 'tcm--reverse': reverse }]}>
  <div class="tcm-text">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="h-section">{title}</h2>
    {paragraphs.map((p) => <p class="text-block">{p}</p>)}
    <slot />
  </div>
  <div class="tcm-media">
    {
      hasMediaSlot ? (
        <slot name="media" />
      ) : isPlainImg ? (
        <img src={image} alt={imageAlt} class="tcm-img" loading="lazy" />
      ) : (
        <StockImage
          name={image ?? ''}
          alt={imageAlt}
          className="tcm-img"
          loading="lazy"
          width={1600}
          height={1200}
        />
      )
    }
  </div>
</div>

<style>
  .tcm {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .tcm--reverse .tcm-text {
    order: 2;
  }

  .tcm--reverse .tcm-media {
    order: 1;
  }

  .text-block {
    color: var(--color-navy-60);
    font-size: 1rem;
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .tcm-media {
    width: 100%;
    aspect-ratio: 4/3;
  }

  .tcm-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 12px;
    display: block;
  }

  @media (max-width: 992px) {
    .tcm {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
