  .checkbox-label.field-error {
    outline: 2px solid #b3261e;
    outline-offset: 4px;
    border-radius: 0.5rem;
  }

  .wiz-nav {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .wiz-nav__next {
    flex: 1;
    justify-content: center;
  }

  .wiz-cat {
    font-size: 0.875rem;
    color: var(--color-navy);
    background: var(--color-sky-10);
    border: 1px solid var(--color-sky-30);
