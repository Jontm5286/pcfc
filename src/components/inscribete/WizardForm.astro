    text-align: left;
    padding: 1rem 1.125rem;
    background: var(--color-pure-white);
    border: 2px solid var(--color-navy-10);
    border-radius: 0.75rem;
    cursor: pointer;
    transition:
      border-color 200ms ease,
      box-shadow 200ms ease,
      background 200ms ease;
  }

  .wiz-pick__btn:hover {
    border-color: var(--color-sky);
  }

  .wiz-pick__btn:focus-visible {
    outline: none;
    border-color: var(--color-sky);
    box-shadow: 0 0 0 3px rgba(66, 154, 192, 0.35);
  }

  .wiz-pick__btn.sel {
    border-color: var(--color-sky);
    background: var(--color-sky-10);
    box-shadow: 0 0 0 3px rgba(66, 154, 192, 0.18);
  }

  .wiz-pick__radio {
    width: 1.25rem;
    height: 1.25rem;
    min-width: 1.25rem;
    border-radius: 50%;
    border: 2px solid var(--color-navy-10);
    background: var(--color-pure-white);
    margin-top: 0.15rem;
    position: relative;
    transition:
      border-color 200ms ease,
      background 200ms ease;
  }

  .wiz-pick__btn:hover .wiz-pick__radio {
    border-color: var(--color-sky);
  }

  .wiz-pick__btn.sel .wiz-pick__radio {
    border-color: var(--color-sky);
  }

  .wiz-pick__btn.sel .wiz-pick__radio::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: var(--color-sky);
  }

  .wiz-pick__text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .wiz-pick__name {
    display: block;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-navy);
  }

  .wiz-pick__addr {
    display: block;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-navy-30);
  }

  .wiz-note {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-navy-30);
    margin: 0 0 0.5rem;
  }

  .wiz-err {
    font-size: 0.875rem;
    font-weight: 600;
    color: #b3261e;
    margin: 0.5rem 0 0;
  }

  .wiz-err[hidden] {
    display: none;
  }

  /* Campos con error de validación: borde rojo + mensaje nombra el campo */
  .form-input.field-error {
    border-color: #b3261e;
    box-shadow: 0 0 0 3px rgba(179, 38, 30, 0.15);
  }

  .wiz-pick.field-error .wiz-pick__btn,
  .wiz-chips.field-error button {
