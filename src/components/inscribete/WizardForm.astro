---
import type { SedeContacto } from '../../data/sedes';

interface Props {
  sedes: SedeContacto[];
  sedePreseleccionada: string;
}

const { sedes, sedePreseleccionada } = Astro.props;
---

<div
  id="formulario"
  class="bg-white rounded-2xl border border-navy-10 p-8 lg:p-10 shadow-[0_4px_24px_rgba(0,40,92,0.08)]"
  data-sede-preselect={sedePreseleccionada}
>
  <p class="wiz-eyebrow">Inscripción · 4 pasos cortos</p>
  <h2 class="h-card mb-2">Inscribe a tu hijo</h2>
  <p class="wiz-sub">Tu progreso se guarda solo en este dispositivo.</p>

  <!-- Barra de progreso -->
  <div class="wiz-progress" aria-hidden="true">
    <div class="wiz-bar"><div id="wiz-barfill"></div></div>
    <span class="wiz-stepcount" id="wiz-stepcount">Paso 1 de 4</span>
  </div>
  <ol class="wiz-dots" id="wiz-dots">
    <li class="on" data-dot="1">1 · Sede</li>
    <li data-dot="2">2 · Jugador</li>
    <li data-dot="3">3 · Tutor</li>
    <li data-dot="4">4 · Enviar</li>
  </ol>

  <!-- PASO 1: sede -->
  <section class="wiz-step on" data-step="1" aria-label="Paso 1: sede">
    <h3 class="wiz-title">¿Dónde va a entrenar?</h3>
    <p class="wiz-hint">Elige la sede donde entrenará.</p>
    <div class="wiz-pick" id="wiz-sedes" role="radiogroup" aria-label="Sede">
      {
        sedes.map((s) => (
          <button
            type="button"
            role="radio"
            aria-checked={sedePreseleccionada === s.slug ? 'true' : 'false'}
            data-slug={s.slug}
            data-nombre={s.nombre}
            class:list={['wiz-pick__btn', { sel: sedePreseleccionada === s.slug }]}
          >
            <span class="wiz-pick__radio" aria-hidden="true" />
            <span class="wiz-pick__text">
              <b class="wiz-pick__name">{s.nombre}</b>
              <small class="wiz-pick__addr">
                {s.direccion.includes('PLACEHOLDER')
                  ? 'Dirección por confirmar — escríbenos por WhatsApp.'
                  : s.direccion}
              </small>
            </span>
          </button>
        ))
      }
    </div>
    <p class="wiz-note">
      La <b>categoría la asigna el club</b> según la fecha de nacimiento — no tienes que elegirla.
    </p>
    <p class="wiz-err" id="wiz-e1" role="alert" hidden>Elige la sede para continuar.</p>
    <div class="wiz-nav">
      <button type="button" class="btn btn--primary btn--lg wiz-nav__next" data-go="2"
        >Continuar</button
      >
    </div>
  </section>

  <!-- PASO 2: jugador -->
  <section class="wiz-step" data-step="2" aria-label="Paso 2: jugador" hidden>
    <h3 class="wiz-title">Datos del jugador</h3>
    <p class="wiz-hint">Tal como aparecen en su acta de nacimiento.</p>
    <div class="form-row-2">
      <div class="form-group">
        <label for="wiz-nombre" class="form-label">Nombre *</label>
        <input
          type="text"
          id="wiz-nombre"
          class="form-input"
          placeholder="Ej. Liam"
          autocomplete="given-name"
        />
      </div>
      <div class="form-group">
        <label for="wiz-apellidos" class="form-label">Apellidos *</label>
        <input
          type="text"
          id="wiz-apellidos"
          class="form-input"
          placeholder="Ej. Tavárez Pérez"
          autocomplete="family-name"
        />
      </div>
    </div>
    <div class="form-group">
      <label for="wiz-nacimiento" class="form-label">Fecha de nacimiento *</label>
      <input type="date" id="wiz-nacimiento" class="form-input" />
    </div>
    <div class="form-group">
      <label for="wiz-colegio" class="form-label"
        >Colegio al que asiste <span class="wiz-opt">(opcional)</span></label
      >
      <input
        type="text"
        id="wiz-colegio"
        class="form-input"
        placeholder="Ej. Colegio Punta Cana"
        autocomplete="off"
        maxlength="120"
      />
    </div>
    <p class="wiz-cat" id="wiz-cat" hidden>
      Categoría provisional: <b id="wiz-cat-val"></b>
      <span>(la confirma el club)</span>
    </p>
    <p class="wiz-err" id="wiz-e2" role="alert" hidden>
      Completa nombre, apellidos y una fecha de nacimiento válida.
    </p>
    <div class="wiz-nav">
      <button type="button" class="btn btn--secondary wiz-nav__back" data-go="1">Atrás</button>
      <button type="button" class="btn btn--primary btn--lg wiz-nav__next" data-go="3"
        >Continuar</button
      >
    </div>
  </section>

  <!-- PASO 3: tutor -->
  <section class="wiz-step" data-step="3" aria-label="Paso 3: tutor" hidden>
    <h3 class="wiz-title">Datos del tutor</h3>
    <p class="wiz-hint">A este contacto enviaremos convocatorias y recibos.</p>
    <div class="form-group">
      <label for="wiz-tutor" class="form-label">Nombre del tutor *</label>
      <input type="text" id="wiz-tutor" class="form-input" placeholder="Nombre completo" />
    </div>
    <div class="form-group">
      <span class="form-label" id="wiz-parentesco-label">Parentesco *</span>
      <div
        class="wiz-chips"
        id="wiz-parentesco"
        role="radiogroup"
        aria-labelledby="wiz-parentesco-label"
      >
        <button type="button" data-v="Padre">Padre</button>
        <button type="button" data-v="Madre">Madre</button>
        <button type="button" data-v="Tutor Legal">Tutor Legal</button>
        <button type="button" data-v="Abuelo/a">Abuelo/a</button>
        <button type="button" data-v="Otro">Otro</button>
      </div>
    </div>
    <div class="form-row-2">
      <div class="form-group">
        <label for="wiz-tel" class="form-label">Teléfono / WhatsApp *</label>
        <input
          type="tel"
          id="wiz-tel"
          class="form-input"
          inputmode="tel"
          placeholder="809-000-0000"
          autocomplete="tel"
        />
      </div>
      <div class="form-group">
        <label for="wiz-email" class="form-label">Correo *</label>
        <input
          type="email"
          id="wiz-email"
          class="form-input"
          inputmode="email"
          placeholder="correo@ejemplo.com"
          autocomplete="email"
        />
      </div>
    </div>
    <div class="form-group">
      <label for="wiz-ocupacion" class="form-label"
        >Ocupación del tutor <span class="wiz-opt">(opcional)</span></label
      >
      <input
        type="text"
        id="wiz-ocupacion"
        class="form-input"
        placeholder="Ej. Médica, docente, comerciante…"
        autocomplete="off"
        maxlength="120"
      />
    </div>
    <button
      type="button"
      id="wiz-add2"
      class="wiz-toggle"
      aria-expanded="false"
      aria-controls="wiz-tutor2">+ Agregar segundo tutor (opcional)</button
    >
    <div id="wiz-tutor2" hidden>
      <div class="form-group">
        <label for="wiz-tutor2-nombre" class="form-label">Nombre del segundo tutor</label>
        <input
          type="text"
          id="wiz-tutor2-nombre"
          class="form-input"
          placeholder="Nombre completo"
        />
      </div>
      <div class="form-group">
        <span class="form-label" id="wiz-parentesco2-label">Parentesco</span>
        <div
          class="wiz-chips"
          id="wiz-parentesco2"
          role="radiogroup"
          aria-labelledby="wiz-parentesco2-label"
        >
          <button type="button" data-v="Padre">Padre</button>
          <button type="button" data-v="Madre">Madre</button>
          <button type="button" data-v="Tutor Legal">Tutor Legal</button>
          <button type="button" data-v="Abuelo/a">Abuelo/a</button>
          <button type="button" data-v="Otro">Otro</button>
        </div>
      </div>
      <div class="form-group">
        <label for="wiz-tutor2-tel" class="form-label">Teléfono / WhatsApp</label>
        <input
          type="tel"
          id="wiz-tutor2-tel"
          class="form-input"
          inputmode="tel"
          placeholder="809-000-0000"
        />
      </div>
    </div>
    <p class="wiz-err" id="wiz-e3" role="alert" hidden>
      Completa nombre, parentesco, teléfono y un correo válido del tutor.
    </p>
    <div class="wiz-nav">
      <button type="button" class="btn btn--secondary wiz-nav__back" data-go="2">Atrás</button>
      <button type="button" class="btn btn--primary btn--lg wiz-nav__next" data-go="4"
        >Revisar</button
      >
    </div>
  </section>

  <!-- PASO 4: opcionales + resumen + envío -->
  <section class="wiz-step" data-step="4" aria-label="Paso 4: revisar y enviar" hidden>
    <h3 class="wiz-title">Revisa y envía</h3>
    <p class="wiz-hint">Lo opcional puede quedar para después, en la sede.</p>
    <div class="form-group">
      <label for="wiz-dir" class="form-label"
        >Dirección <span class="wiz-opt">(opcional)</span></label
      >
      <input
        type="text"
        id="wiz-dir"
        class="form-input"
        placeholder="Sector, calle…"
        autocomplete="street-address"
      />
    </div>
    <div class="form-group">
      <label for="wiz-med" class="form-label"
        >Condición médica o alergia <span class="wiz-opt">(opcional)</span></label
      >
      <textarea id="wiz-med" rows="2" class="form-input" placeholder="Ej. Asma leve, usa inhalador"
      ></textarea>
    </div>
    <div class="wiz-resume" id="wiz-resumen" aria-live="polite"></div>
    <div class="form-group">
      <label class="checkbox-label">
        <input type="checkbox" id="wiz-terminos" class="form-checkbox" />
        <span class="form-label"
          >Acepto los <a href="/terminos#terminos" target="_blank" rel="noopener" class="form-link"
            >términos y condiciones</a
          > y la <a href="/terminos#privacidad" target="_blank" rel="noopener" class="form-link"
            >política de privacidad</a
          >, incluyendo el <a
            href="/terminos#descargo"
            target="_blank"
            rel="noopener"
            class="form-link">descargo de responsabilidad por lesiones</a
          >. *</span
        >
      </label>
      <p class="font-body text-[0.85rem] leading-[1.5] text-navy-60 mt-2">
        El fútbol es un deporte de contacto: al aceptar, reconoces sus riesgos y aceptas que el club
        no se hace responsable por las heridas o lesiones propias de la práctica.
      </p>
    </div>
    <!-- Honeypot anti-spam (oculto para humanos) -->
    <div class="hp-field" aria-hidden="true">
      <label for="wiz-sitio">Sitio web</label>
      <input type="text" id="wiz-sitio" tabindex="-1" autocomplete="off" />
    </div>
    <p class="wiz-err" id="wiz-e4" role="alert" hidden></p>
    <div class="wiz-nav">
      <button type="button" class="btn btn--secondary wiz-nav__back" data-go="3">Atrás</button>
      <button type="button" id="wiz-send" class="btn btn--primary btn--lg wiz-nav__next"
        >Enviar inscripción</button
      >
    </div>
  </section>

  <!-- ÉXITO -->
  <section class="wiz-step" data-step="5" aria-label="Inscripción recibida" hidden>
    <div class="wiz-ok">
      <div class="wiz-ok__big" aria-hidden="true">✓</div>
      <h3 class="wiz-title">¡Inscripción recibida!</h3>
      <p class="wiz-hint" id="wiz-okmsg">
        Te contactaremos por WhatsApp en menos de 48 horas para la prueba de nivel.
      </p>
    </div>
    <div class="wiz-nav">
      <button
        type="button"
        class="btn btn--primary btn--lg wiz-nav__next"
        data-go="1"
        id="wiz-again">Nueva inscripción</button
      >
    </div>
  </section>

  <p class="wiz-draft" id="wiz-draft" hidden>Borrador guardado en este dispositivo.</p>
</div>

<script>
  // ============================================================
  // Wizard de inscripción — 4 pasos + éxito.
  // Sin campo de categoría (decisión del club): se deriva una
  // categoría PROVISIONAL desde la fecha de nacimiento solo para
  // cumplir el contrato de /api/inscripcion-plataforma (CategoryType).
  // El coordinador la confirma al activar.
  //
  // TABLA EDAD→CATEGORÍA PROVISIONAL (a validar por el club):
  //   4–5 años → Sub-6 (Iniciación) | 6–7 → Sub-8 (Pre-Benjamín)
  //   8–9 → Sub-10 (Benjamín) | 10–11 → Sub-12 (Alevín)
  //   12–13 → Sub-14 (Infantil Mayor) | 14 → Sub-15 (Infantil)
  //   15–17 → Sub-18 (Juvenil)
  //   <4 → Sub-6 (Iniciación) · >17 → Sub-18 (Juvenil)
  //   Femenino Juvenil nunca se auto-deriva (lo asigna el club).
  // ============================================================
  const DRAFT_KEY = 'pcfc-inscripcion-draft-v1';
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  function categoriaProvisional(fechaISO: string): string {
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(fechaISO);
    if (!m) return '';
    const hoy = new Date();
    let edad = hoy.getFullYear() - Number(m[1]);
    const mesDia = (hoy.getMonth() + 1) * 100 + hoy.getDate();
    if (mesDia < Number(m[2]) * 100 + Number(m[3])) edad -= 1;
    if (edad <= 5) return 'Sub-6 (Iniciación)';
    if (edad <= 7) return 'Sub-8 (Pre-Benjamín)';
    if (edad <= 9) return 'Sub-10 (Benjamín)';
    if (edad <= 11) return 'Sub-12 (Alevín)';
    if (edad <= 13) return 'Sub-14 (Infantil Mayor)';
    if (edad === 14) return 'Sub-15 (Infantil)';
    return 'Sub-18 (Juvenil)';
  }

  function fechaValida(fecha: string): boolean {
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(fecha);
    if (!m) return false;
    const y = Number(m[1]);
    const mo = Number(m[2]);
    const d = Number(m[3]);
    if (y < 2000 || y > new Date().getFullYear()) return false;
    const dt = new Date(Date.UTC(y, mo - 1, d));
    return dt.getUTCFullYear() === y && dt.getUTCMonth() === mo - 1 && dt.getUTCDate() === d;
  }

  const root = document.getElementById('formulario');
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement | null;
  const val = (id: string) => ($(id)?.value ?? '').trim();

  let sede = root?.dataset.sedePreselect ?? '';
  let sedeNombre = '';
  let parentesco = '';
  let parentesco2 = '';
  let tutor2on = false;

  const sedeBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('#wiz-sedes button'));
  function syncSedes() {
    sedeBtns.forEach((b) => {
      const on = b.dataset.slug === sede;
      b.classList.toggle('sel', on);
      b.setAttribute('aria-checked', on ? 'true' : 'false');
      if (on) sedeNombre = b.dataset.nombre ?? '';
    });
  }
  sedeBtns.forEach((b) => {
    b.addEventListener('click', () => {
      sede = b.dataset.slug ?? '';
      syncSedes();
      hideErr(1);
      saveDraft();
    });
  });
  syncSedes();

  function chipGroup(id: string, set: (v: string) => void) {
    const btns = Array.from(document.querySelectorAll<HTMLButtonElement>(`#${id} button`));
    btns.forEach((b) => {
      if (b.dataset.v === (id === 'wiz-parentesco' ? parentesco : parentesco2))
        b.classList.add('sel');
      b.addEventListener('click', () => {
        btns.forEach((x) => x.classList.remove('sel'));
        b.classList.add('sel');
        set(b.dataset.v ?? '');
        hideErr(3);
        saveDraft();
      });
    });
    return btns;
  }
  const chips1 = chipGroup('wiz-parentesco', (v) => {
    parentesco = v;
  });
  const chips2 = chipGroup('wiz-parentesco2', (v) => {
    parentesco2 = v;
  });

  const add2 = $('wiz-add2');
  const tutor2 = document.getElementById('wiz-tutor2');
  function setTutor2(on: boolean) {
    tutor2on = on;
    if (tutor2) tutor2.hidden = !on;
    if (add2) {
      add2.textContent = on ? '− Quitar segundo tutor' : '+ Agregar segundo tutor (opcional)';
      add2.setAttribute('aria-expanded', on ? 'true' : 'false');
    }
  }
  add2?.addEventListener('click', () => setTutor2(!tutor2on));

  function showErr(step: number, msg?: string) {
    const e = document.getElementById(`wiz-e${step}`);
    if (!e) return;
    if (msg) e.textContent = msg;
    e.hidden = false;
  }
  function hideErr(step: number) {
    document.getElementById(`wiz-e${step}`)?.setAttribute('hidden', '');
  }

  // Nombres legibles de cada campo para el mensaje de error.
  const FIELD_LABELS: Record<string, string> = {
    'wiz-sedes': 'la sede',
    'wiz-nombre': 'el nombre del jugador',
    'wiz-apellidos': 'los apellidos',
    'wiz-nacimiento': 'la fecha de nacimiento',
    'wiz-tutor': 'el nombre del tutor',
    'wiz-parentesco': 'el parentesco',
    'wiz-tel': 'el teléfono',
    'wiz-email': 'el correo',
    'wiz-terminos': 'la aceptación de términos',
  };

  // Devuelve los ids de los campos inválidos del paso (vacío = todo bien).
  function invalidFields(n: number): string[] {
    const bad: string[] = [];
    if (n === 1) {
      if (sede === '') bad.push('wiz-sedes');
    } else if (n === 2) {
      if (val('wiz-nombre') === '') bad.push('wiz-nombre');
      if (val('wiz-apellidos') === '') bad.push('wiz-apellidos');
      if (!fechaValida(val('wiz-nacimiento'))) bad.push('wiz-nacimiento');
    } else if (n === 3) {
      if (val('wiz-tutor') === '') bad.push('wiz-tutor');
      if (parentesco === '') bad.push('wiz-parentesco');
      if (val('wiz-tel').replace(/\D/g, '').length < 7) bad.push('wiz-tel');
      if (!EMAIL_RE.test(val('wiz-email'))) bad.push('wiz-email');
    }
    return bad;
  }

  function clearMarks(): void {
    root?.querySelectorAll('.field-error').forEach((el) => {
      el.classList.remove('field-error');
      el.removeAttribute('aria-invalid');
    });
  }

  // Marca en rojo los campos con error, nombra cuáles son y lleva el foco al primero.
  function showFieldErrors(step: number, bad: string[]): void {
    clearMarks();
    bad.forEach((id) => {
      const el = document.getElementById(id);
      if (!el) return;
      const target = id === 'wiz-terminos' ? (el.closest('.checkbox-label') ?? el) : el;
      target.classList.add('field-error');
      if (el.matches('input, select, textarea')) el.setAttribute('aria-invalid', 'true');
    });
    const names = bad.map((id) => FIELD_LABELS[id] ?? 'este campo');
    const msg =
      bad.length === 1
        ? `Revisa este campo: ${names[0]}.`
        : `Revisa estos campos: ${names.join(', ')}.`;
    showErr(step, msg);
    const first = document.getElementById(bad[0]);
    const focusable =
      first?.matches('input, select, textarea, button') === true
        ? (first as HTMLElement)
        : first?.querySelector<HTMLElement>('button, input');
    focusable?.focus({ preventScroll: true });
    (focusable ?? first)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  // Al corregir un campo se le quita la marca de error automáticamente.
  root?.addEventListener('input', (e) => {
    const t = e.target;
    if (!(t instanceof HTMLElement)) return;
    t.classList.remove('field-error');
    t.removeAttribute('aria-invalid');
    if (t.id === 'wiz-terminos') t.closest('.checkbox-label')?.classList.remove('field-error');
  });
  // Sede y parentesco son botones: al elegir se limpia la marca del grupo.
  root?.addEventListener('click', (e) => {
    const t = e.target;
    if (!(t instanceof HTMLElement)) return;
    t.closest?.('.wiz-pick.field-error, .wiz-chips.field-error')?.classList.remove('field-error');
  });

  function escHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function renderResumen() {
    const el = document.getElementById('wiz-resumen');
    if (!el) return;
    const cat = categoriaProvisional(val('wiz-nacimiento'));
    const seg =
      tutor2on && val('wiz-tutor2-nombre')
        ? `<div><b>Segundo tutor:</b> ${escHtml(val('wiz-tutor2-nombre'))}${parentesco2 ? ` (${escHtml(parentesco2)})` : ''}${val('wiz-tutor2-tel') ? ` — ${escHtml(val('wiz-tutor2-tel'))}` : ''}</div>`
        : '';
    el.innerHTML =
      `<div><b>Sede:</b> ${escHtml(sedeNombre || sede)}</div>` +
      `<div><b>Jugador:</b> ${escHtml(val('wiz-nombre'))} ${escHtml(val('wiz-apellidos'))} (${escHtml(val('wiz-nacimiento'))})</div>` +
      `<div><b>Categoría provisional:</b> ${escHtml(cat)} <span class="wiz-resume__note">(la confirma el club)</span></div>` +
      (val('wiz-colegio') ? `<div><b>Colegio:</b> ${escHtml(val('wiz-colegio'))}</div>` : '') +
      `<div><b>Tutor:</b> ${escHtml(val('wiz-tutor'))} (${escHtml(parentesco)}) — ${escHtml(val('wiz-tel'))} · ${escHtml(val('wiz-email'))}</div>` +
      (val('wiz-ocupacion')
        ? `<div><b>Ocupación del tutor:</b> ${escHtml(val('wiz-ocupacion'))}</div>`
        : '') +
      seg;
  }

  function go(n: number) {
    document.querySelectorAll('.wiz-err').forEach((e) => e.setAttribute('hidden', ''));
    document.querySelectorAll('.wiz-step').forEach((s) => {
      const on = Number((s as HTMLElement).dataset.step) === n;
      (s as HTMLElement).hidden = !on;
      s.classList.toggle('on', on);
    });
    if (n <= 4) {
      const fill = document.getElementById('wiz-barfill');
      if (fill) fill.style.width = `${n * 25}%`;
      const count = document.getElementById('wiz-stepcount');
      if (count) count.textContent = `Paso ${n} de 4`;
      document.querySelectorAll('#wiz-dots li').forEach((d) => {
        d.classList.toggle('on', Number((d as HTMLElement).dataset.dot) === n);
      });
      if (n === 4) renderResumen();
    } else {
      const fill = document.getElementById('wiz-barfill');
      if (fill) fill.style.width = '100%';
      const count = document.getElementById('wiz-stepcount');
      if (count) count.textContent = 'Completado';
    }
    document.getElementById('formulario')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  document.querySelectorAll('[data-go]').forEach((b) => {
    b.addEventListener('click', () => {
      const n = Number((b as HTMLElement).dataset.go);
      const cur = currentStep();
      if (n > cur) {
        for (let s = cur; s < n; s += 1) {
          const bad = invalidFields(s);
          if (bad.length > 0) {
            go(s);
            showFieldErrors(s, bad);
            return;
          }
        }
      }
      if (n === 1 && (b as HTMLElement).id === 'wiz-again') resetWizard();
      else go(n);
    });
  });

  function currentStep(): number {
    const on = document.querySelector('.wiz-step.on');
    return on ? Number((on as HTMLElement).dataset.step) : 1;
  }

  // Borrador auto-guardado en localStorage
  function saveDraft() {
    try {
      localStorage.setItem(
        DRAFT_KEY,
        JSON.stringify({
          sede,
          parentesco,
          parentesco2,
          tutor2on,
          nombre: val('wiz-nombre'),
          apellidos: val('wiz-apellidos'),
          nacimiento: val('wiz-nacimiento'),
          colegio: val('wiz-colegio'),
          tutor: val('wiz-tutor'),
          ocupacion: val('wiz-ocupacion'),
          tel: val('wiz-tel'),
          email: val('wiz-email'),
          tutor2: val('wiz-tutor2-nombre'),
          tutor2tel: val('wiz-tutor2-tel'),
          dir: val('wiz-dir'),
          med: val('wiz-med'),
        })
      );
      document.getElementById('wiz-draft')?.removeAttribute('hidden');
    } catch {
      /* almacenamiento no disponible */
    }
  }
  function loadDraft() {
    let d: Record<string, string | boolean> = {};
    try {
      d = JSON.parse(localStorage.getItem(DRAFT_KEY) ?? '{}');
    } catch {
      return;
    }
    const set = (id: string, v: unknown) => {
      const el = $(id);
      if (el && typeof v === 'string') el.value = v;
    };
    if (typeof d.sede === 'string' && sedeBtns.some((b) => b.dataset.slug === d.sede))
      sede = d.sede as string;
    if (typeof d.parentesco === 'string') {
      parentesco = d.parentesco as string;
      chips1.forEach((b) => b.classList.toggle('sel', b.dataset.v === parentesco));
    }
    if (typeof d.parentesco2 === 'string') {
      parentesco2 = d.parentesco2 as string;
      chips2.forEach((b) => b.classList.toggle('sel', b.dataset.v === parentesco2));
    }
    set('wiz-nombre', d.nombre);
    set('wiz-apellidos', d.apellidos);
    set('wiz-nacimiento', d.nacimiento);
    set('wiz-colegio', d.colegio);
    set('wiz-tutor', d.tutor);
    set('wiz-ocupacion', d.ocupacion);
    set('wiz-tel', d.tel);
    set('wiz-email', d.email);
    set('wiz-tutor2-nombre', d.tutor2);
    set('wiz-tutor2-tel', d.tutor2tel);
    set('wiz-dir', d.dir);
    set('wiz-med', d.med);
    if (d.tutor2on === true) setTutor2(true);
    syncSedes();
    updateCat();
    if (Object.keys(d).length) document.getElementById('wiz-draft')?.removeAttribute('hidden');
  }
  [
    'wiz-nombre',
    'wiz-apellidos',
    'wiz-nacimiento',
    'wiz-colegio',
    'wiz-tutor',
    'wiz-ocupacion',
    'wiz-tel',
    'wiz-email',
    'wiz-tutor2-nombre',
    'wiz-tutor2-tel',
    'wiz-dir',
    'wiz-med',
  ].forEach((id) => {
    $(id)?.addEventListener('input', () => {
      if (id === 'wiz-nacimiento') updateCat();
      hideErr(currentStep());
      saveDraft();
    });
  });

  function updateCat() {
    const cat = categoriaProvisional(val('wiz-nacimiento'));
    const box = document.getElementById('wiz-cat');
    const lbl = document.getElementById('wiz-cat-val');
    if (box && lbl) {
      if (cat) {
        lbl.textContent = cat;
        box.hidden = false;
      } else box.hidden = true;
    }
  }

  function resetWizard() {
    try {
      localStorage.removeItem(DRAFT_KEY);
    } catch {
      /* noop */
    }
    [
      'wiz-nombre',
      'wiz-apellidos',
      'wiz-nacimiento',
      'wiz-colegio',
      'wiz-tutor',
      'wiz-ocupacion',
      'wiz-tel',
      'wiz-email',
      'wiz-tutor2-nombre',
      'wiz-tutor2-tel',
      'wiz-dir',
      'wiz-med',
      'wiz-sitio',
    ].forEach((id) => {
      const el = $(id);
      if (el) el.value = '';
    });
    const term = $('wiz-terminos') as HTMLInputElement | null;
    if (term) term.checked = false;
    sede = root?.dataset.sedePreselect ?? '';
    parentesco = '';
    parentesco2 = '';
    chips1.forEach((b) => b.classList.remove('sel'));
    chips2.forEach((b) => b.classList.remove('sel'));
    setTutor2(false);
    syncSedes();
    updateCat();
    document.getElementById('wiz-draft')?.setAttribute('hidden', '');
    go(1);
  }

  const sendBtn = document.getElementById('wiz-send') as HTMLButtonElement | null;
  sendBtn?.addEventListener('click', async () => {
    for (let s = 1; s <= 3; s += 1) {
      const bad = invalidFields(s);
      if (bad.length > 0) {
        go(s);
        showFieldErrors(s, bad);
        return;
      }
    }
    const term = $('wiz-terminos') as HTMLInputElement | null;
    if (!term?.checked) {
      clearMarks();
      showFieldErrors(4, ['wiz-terminos']);
      return;
    }
    const category = categoriaProvisional(val('wiz-nacimiento'));
    if (!category) {
      go(2);
      showErr(2);
      return;
    }
    if (!sendBtn) return;

    const payload = {
      firstName: val('wiz-nombre'),
      lastName: val('wiz-apellidos'),
      birthDate: val('wiz-nacimiento'),
      category,
      sede,
      parentName: val('wiz-tutor'),
      parentRelationship: parentesco,
      parentPhone: val('wiz-tel'),
      parentEmail: val('wiz-email'),
      school: val('wiz-colegio').slice(0, 120),
      parentOccupation: val('wiz-ocupacion').slice(0, 120),
      address: val('wiz-dir'),
      medicalNotes: val('wiz-med'),
      secondGuardian:
        tutor2on && val('wiz-tutor2-nombre')
          ? {
              name: val('wiz-tutor2-nombre'),
              relationship: parentesco2,
              phone: val('wiz-tutor2-tel'),
            }
          : null,
      sitio_web: val('wiz-sitio'),
      terminos: true,
    };

    sendBtn.disabled = true;
    sendBtn.textContent = 'Enviando…';
    try {
      const res = await fetch('/api/inscripcion-plataforma', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const out = (await res.json().catch(() => null)) as { ok?: boolean; error?: string } | null;
      if (res.ok && out?.ok) {
        try {
          localStorage.removeItem(DRAFT_KEY);
        } catch {
          /* noop */
        }
        document.getElementById('wiz-draft')?.setAttribute('hidden', '');
        const okmsg = document.getElementById('wiz-okmsg');
        if (okmsg)
          okmsg.textContent = `${payload.firstName} quedó preinscrito en ${sedeNombre || sede} (${category}, provisional). Te contactaremos por WhatsApp en menos de 48 horas.`;
        go(5);
      } else {
        showErr(4, out?.error ?? 'No pudimos enviar tu inscripción. Inténtalo de nuevo.');
      }
    } catch {
      showErr(4, 'Sin conexión. Revisa tu internet e inténtalo de nuevo.');
    } finally {
      sendBtn.disabled = false;
      sendBtn.textContent = 'Enviar inscripción';
    }
  });

  loadDraft();
</script>

<style>
