    line-height: 1.65;
    margin: 0 0 1rem;
  }

  .trust-card__footer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .trust-card__cite {
    font-style: normal;
    font-weight: 700;
    font-size: 0.875rem;
    color: var(--color-navy);
  }

  .trust-card__meta {
    font-size: 0.8125rem;
    color: var(--color-navy-30);
  }

  .trust-stat {
