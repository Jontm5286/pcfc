---
/**
 * Sponsors — PCFC
 * Sección de patrocinadores / aliados del club.
 * Grid asimétrico 12 columnas: cards de distinto tamaño + CTA final.
 * Logos grayscale → color al hover.
 *
 * Props:
 *   - eyebrow?: string       Texto superpuesto
 *   - title?: string         Título de la sección
 *   - sponsors: Sponsor[]    Array de patrocinadores
 *
 * Sponsor = {
 *   name: string,
 *   logo: string,       // URL de la imagen del logo
 *   href?: string,     // Link al sitio (opcional)
 * }
 */

export interface Sponsor {
  name: string;
  logo: string;
  href?: string;
  /** Tile oscuro para logos claros (texto blanco). */
  dark?: boolean;
  /** Dimensiones intrínsecas + srcset (vienen de homeData; ausentes en live). */
  width?: number;
  height?: number;
  logoSrcSet?: string;
  tier?: 'principal' | 'aliado';
  order?: number;
}

interface Props {
  eyebrow?: string;
  title?: string;
  sponsors: Sponsor[];
}

const { eyebrow, title, sponsors } = Astro.props;

// Layout 1 · 3 · 5 por tiers:
// - Hero (fila 1): primer `principal` (si no hay, el primero en orden).
// - Fila de 3: resto de principales (se rellena con aliados si faltan).
// - Fila de 5: resto de aliados + CTA.
const principals = sponsors.filter((s) => s.tier === 'principal');
const aliados = sponsors.filter((s) => s.tier !== 'principal');
const hero = principals[0] ?? aliados[0];
const rowB = [...principals.slice(1), ...aliados].slice(0, 3);
const rowBNames = new Set(rowB.map((s) => s.name));
const rowC = aliados.filter((s) => s.name !== hero?.name && !rowBNames.has(s.name));

// Placa navy sólida solo para logos claros (sin caja para el resto).
const tileClass = (s: Sponsor) => (s.dark ? 'rounded-xl bg-navy px-6 py-6' : '');
---

<section
  class="relative w-full py-14 md:py-16 border-t border-b border-navy-10 bg-white"
  data-component="sponsors"
>
  <div class="max-w-[1280px] mx-auto px-8">
    {
      (eyebrow || title) && (
        <header data-reveal class="mb-10 flex flex-col items-center text-center">
          {eyebrow && <p class="eyebrow text-navy-60 mb-3">{eyebrow}</p>}
          {title && <h2 class="h-section text-navy">{title}</h2>}
        </header>
      )
    }

    {
      sponsors.length > 0 && hero && (
        <div class="flex flex-col gap-4 md:gap-5" role="list">
          {/* FILA A — destacado (1) */}
          <div
            role="listitem"
            class={`group flex items-center justify-center ${tileClass(hero)} transition-transform duration-200 hover:-translate-y-0.5`}
          >
            {hero.href ? (
              <a
                href={hero.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visitar ${hero.name}`}
                class="flex items-center justify-center w-full h-28 md:h-36"
              >
                <img
                  src={hero.logo}
                  width={hero.width}
                  height={hero.height}
                  srcset={hero.logoSrcSet}
                  sizes="(max-width: 768px) 90vw, 412px"
                  alt={`Logo de ${hero.name}`}
                  loading="lazy"
                  class="max-h-20 md:max-h-28 w-auto max-w-full object-contain"
                />
              </a>
            ) : (
              <div class="flex items-center justify-center w-full h-28 md:h-36">
                <img
                  src={hero.logo}
                  width={hero.width}
                  height={hero.height}
                  srcset={hero.logoSrcSet}
                  sizes="(max-width: 768px) 90vw, 412px"
                  alt={`Logo de ${hero.name}`}
                  loading="lazy"
                  class="max-h-20 md:max-h-28 w-auto max-w-full object-contain"
                />
              </div>
            )}
          </div>

          {/* FILA B — tres */}
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 md:gap-5">
            {rowB.map((sponsor) => (
              <div
                role="listitem"
                class={`group flex items-center justify-center ${tileClass(sponsor)} transition-transform duration-200 hover:-translate-y-0.5`}
              >
                {sponsor.href ? (
                  <a
                    href={sponsor.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Visitar ${sponsor.name}`}
                    class="flex items-center justify-center w-full h-24 md:h-28"
                  >
                    <img
                      src={sponsor.logo}
                      width={sponsor.width}
                      height={sponsor.height}
                      srcset={sponsor.logoSrcSet}
                      sizes="(max-width: 768px) 45vw, 182px"
                      alt={`Logo de ${sponsor.name}`}
                      loading="lazy"
                      class="max-h-14 md:max-h-16 w-auto max-w-full object-contain"
                    />
                  </a>
                ) : (
                  <div class="flex items-center justify-center w-full h-24 md:h-28">
                    <img
                      src={sponsor.logo}
                      width={sponsor.width}
                      height={sponsor.height}
                      srcset={sponsor.logoSrcSet}
                      sizes="(max-width: 768px) 45vw, 182px"
                      alt={`Logo de ${sponsor.name}`}
                      loading="lazy"
                      class="max-h-14 md:max-h-16 w-auto max-w-full object-contain"
                    />
                  </div>
                )}
              </div>
            ))}
          </div>

          {/* FILA C — cinco (resto + CTA) */}
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 md:gap-5">
            {rowC.map((sponsor) => (
              <div
                role="listitem"
                class={`group flex items-center justify-center ${tileClass(sponsor)} transition-transform duration-200 hover:-translate-y-0.5`}
              >
                {sponsor.href ? (
                  <a
                    href={sponsor.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Visitar ${sponsor.name}`}
                    class="flex items-center justify-center w-full h-20 md:h-24"
                  >
                    <img
                      src={sponsor.logo}
                      width={sponsor.width}
                      height={sponsor.height}
                      srcset={sponsor.logoSrcSet}
                      sizes="(max-width: 768px) 45vw, 182px"
                      alt={`Logo de ${sponsor.name}`}
                      loading="lazy"
                      class="max-h-12 md:max-h-14 w-auto max-w-full object-contain"
                    />
                  </a>
                ) : (
                  <div class="flex items-center justify-center w-full h-20 md:h-24">
                    <img
                      src={sponsor.logo}
                      width={sponsor.width}
                      height={sponsor.height}
                      srcset={sponsor.logoSrcSet}
                      sizes="(max-width: 768px) 45vw, 182px"
                      alt={`Logo de ${sponsor.name}`}
                      loading="lazy"
                      class="max-h-12 md:max-h-14 w-auto max-w-full object-contain"
                    />
                  </div>
                )}
              </div>
            ))}

            {/* CTA: completa la fila de 5 y convierte */}
            <div
              role="listitem"
              class="col-span-2 sm:col-span-1 flex flex-col items-center justify-center gap-2 rounded-2xl border border-dashed border-navy-10 px-5 py-5 text-center"
            >
              <p class="text-navy-60 text-sm leading-snug">¿Tu marca aquí?</p>
              <a href="/sponsors#contacto" class="btn btn--sky shrink-0">
                Ser patrocinador
              </a>
            </div>
          </div>
        </div>
      )
    }

    {/* Placeholder cuando no hay datos */}
    {
      sponsors.length === 0 && (
        <p class="text-center text-navy-30 text-sm">Patrocinadores próximamente</p>
      )
    }
  </div>
</section>
