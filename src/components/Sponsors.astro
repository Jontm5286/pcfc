---
/**
 * Sponsors — PCFC
 * Sección de patrocinadores / aliados del club.
 * Grid asimétrico 12 columnas: cards de distinto tamaño + CTA final.
 * Logos grayscale → color al hover.
 *
 * Props:
 *   - eyebrow?: string       Texto superpuesto
 *   - title?: string         Título de la sección
 *   - sponsors: Sponsor[]    Array de patrocinadores
 *
 * Sponsor = {
 *   name: string,
 *   logo: string,       // URL de la imagen del logo
 *   href?: string,     // Link al sitio (opcional)
 * }
 */

export interface Sponsor {
  name: string;
  logo: string;
  href?: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  sponsors: Sponsor[];
}

const { eyebrow, title, sponsors } = Astro.props;

// Mosaico asimétrico (se repite si hay más/menos logos):
// fila 1: 7+5 (alto) · fila 2: 4+4+4 · fila 3: 5+7 · resto: 6+6
const SPANS = [
  'lg:col-span-7',
  'lg:col-span-5',
  'lg:col-span-4',
  'lg:col-span-4',
  'lg:col-span-4',
  'lg:col-span-5',
  'lg:col-span-7',
];
const HEIGHTS = ['lg:h-44', 'lg:h-44', 'lg:h-32', 'lg:h-32', 'lg:h-32', 'lg:h-36', 'lg:h-36'];
const spanFor = (i: number) => SPANS[i % SPANS.length];
const heightFor = (i: number) => HEIGHTS[i % HEIGHTS.length];
---

<section
  class="relative w-full py-14 md:py-16 border-t border-b border-white/5 bg-navy-dark"
  data-component="sponsors"
>
  <div class="max-w-[1280px] mx-auto px-8">
    {(eyebrow || title) && (
      <header class="mb-10 flex flex-col items-center text-center">
        {eyebrow && (
          <p class="eyebrow text-sky mb-3">{eyebrow}</p>
        )}
        {title && (
          <h2 class="h-section h-section--on-navy">
            {title}
          </h2>
        )}
      </header>
    )}

    {sponsors.length > 0 && (
      <div
        class="grid grid-cols-2 lg:grid-cols-12 gap-4 md:gap-5 items-stretch"
        role="list"
      >
        {sponsors.map((sponsor, i) => (
          <div
            role="listitem"
            class={`group flex items-center justify-center rounded-2xl bg-white px-6 py-6 shadow-[0_2px_16px_rgba(0,0,0,0.25)] transition-transform duration-200 hover:-translate-y-0.5 ${spanFor(i)}`}
          >
            {sponsor.href ? (
              <a
                href={sponsor.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visitar ${sponsor.name}`}
                class={`flex items-center justify-center w-full ${heightFor(i)}`}
              >
                <img
                  src={sponsor.logo}
                  alt={`Logo de ${sponsor.name}`}
                  loading="lazy"
                  class="max-h-12 md:max-h-14 lg:max-h-16 w-auto max-w-full object-contain"
                />
              </a>
            ) : (
              <div class={`flex items-center justify-center w-full ${heightFor(i)}`}>
                <img
                  src={sponsor.logo}
                  alt={`Logo de ${sponsor.name}`}
                  loading="lazy"
                  class="max-h-12 md:max-h-14 lg:max-h-16 w-auto max-w-full object-contain"
                />
              </div>
            )}
          </div>
        ))}

        {/* CTA: cierra el mosaico y convierte */}
        <div class="col-span-2 lg:col-span-12 flex flex-col sm:flex-row items-center justify-center gap-3 rounded-2xl border border-dashed border-white/20 px-6 py-5 text-center">
          <p class="text-white/70 text-sm">
            ¿Tu marca aquí? Sé parte de los aliados de Punta Cana FC.
          </p>
          <a
            href="/inscribete"
            class="btn btn--sky btn--on-navy shrink-0"
          >
            Ser patrocinador
          </a>
        </div>
      </div>
    )}

    {/* Placeholder cuando no hay datos */}
    {sponsors.length === 0 && (
      <p class="text-center text-white/30 text-sm">
        Patrocinadores próximamente
      </p>
    )}
  </div>
</section>
