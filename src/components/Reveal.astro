<script>
  document.documentElement.classList.add("js");

  const prefersReducedMotion: boolean = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const revealEls: NodeListOf<Element> =
    document.querySelectorAll("[data-reveal]");
  const VARIANTS: Record<string, string> = {
    up: "translateY(12px)",
    left: "translateX(24px)",
    right: "translateX(-24px)",
    zoom: "scale(0.96)",
  };
  if (revealEls.length > 0) {
    const revealObserver = new IntersectionObserver(
      (entries: IntersectionObserverEntry[]) => {
        entries.forEach((entry: IntersectionObserverEntry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 },
    );
    revealEls.forEach((el: Element) => {
      const v = (el as HTMLElement).dataset.reveal || "up";
      (el as HTMLElement).style.setProperty("--reveal-from", VARIANTS[v] ?? VARIANTS.up);
      const d = (el as HTMLElement).dataset.revealDelay;
      if (d) (el as HTMLElement).style.setProperty("--reveal-delay", `${parseInt(d, 10)}ms`);
      revealObserver.observe(el);
    });
  }

  const countupEls: NodeListOf<HTMLElement> =
    document.querySelectorAll("[data-countup]");
  if (countupEls.length > 0) {
    const countupObserver = new IntersectionObserver(
      (entries: IntersectionObserverEntry[]) => {
        entries.forEach((entry: IntersectionObserverEntry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          countupObserver.unobserve(el);
          const raw: string = (el.textContent ?? "").trim();
          const m: RegExpMatchArray | null = raw.match(/^([\d.,]+)(.*)$/);
          if (!m) return;
          const numStr: string = m[1];
          const suffix: string = m[2] ?? "";
          const target: number = Number(numStr.replace(/,/g, ""));
          if (Number.isNaN(target)) return;
          if (prefersReducedMotion) {
            el.textContent = numStr + suffix;
            return;
          }
          const decimals: number = numStr.split(".")[1]?.length ?? 0;
          const duration = 900;
          let start: number | null = null;
          const step = (ts: number): void => {
            if (start === null) start = ts;
            const t: number = Math.min((ts - start) / duration, 1);
            const eased: number = 1 - Math.pow(1 - t, 3);
            const current: number = target * eased;
            el.textContent = current.toFixed(decimals) + suffix;
            if (t < 1) {
              requestAnimationFrame(step);
            } else {
              el.textContent = numStr + suffix;
            }
          };
          requestAnimationFrame(step);
        });
      },
      { threshold: 0.2 },
    );
    countupEls.forEach((el: HTMLElement) => countupObserver.observe(el));
  }
</script>
