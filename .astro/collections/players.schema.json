{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 3
    },
    "slug": {
      "type": "string"
    },
    "position": {
      "type": "string",
      "enum": [
        "Portero",
        "Defensa",
        "Centrocampista",
        "Atacante"
      ]
    },
    "number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "photo": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "string",
              "pattern": "^\\/.*"
            }
          ]
        },
        {
          "type": "string",
          "pattern": "^\\.\\.\\/assets\\/.+\\.(jpg|jpeg|png|webp|avif)$"
        }
      ]
    },
    "photoAlt": {
      "type": "string",
      "minLength": 3
    },
    "category": {
      "type": "string",
      "enum": [
        "pre",
        "form-baja",
        "form-alta",
        "elite"
      ]
    },
    "featured": {
      "default": true,
      "type": "boolean"
    },
    "order": {
      "default": 99,
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "matches": {
      "default": 0,
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "goals": {
      "default": 0,
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "assists": {
      "default": 0,
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "season": {
      "default": "2026/2027",
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "slug",
    "position",
    "number",
    "photo",
    "photoAlt"
  ]
}