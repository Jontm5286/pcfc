{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "date": {
      "type": "string"
    },
    "time": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "categorySlug": {
      "type": "string",
      "enum": [
        "pre",
        "form-baja",
        "form-alta",
        "elite"
      ]
    },
    "home": {
      "type": "string"
    },
    "homeLogo": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "string",
          "pattern": "^\\/.*"
        }
      ]
    },
    "away": {
      "type": "string"
    },
    "awayLogo": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "string",
          "pattern": "^\\/.*"
        }
      ]
    },
    "venue": {
      "type": "string"
    },
    "homeId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "string",
          "const": ""
        }
      ]
    },
    "awayId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "string",
          "const": ""
        }
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "time",
    "category",
    "categorySlug",
    "home",
    "away",
    "venue"
  ]
}