{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 3
    },
    "slug": {
      "type": "string"
    },
    "category": {
      "default": "Noticias",
      "type": "string"
    },
    "publishedAt": {
      "type": "string"
    },
    "coverImage": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "string",
              "pattern": "^\\/.*"
            }
          ]
        },
        {
          "type": "string",
          "const": ""
        }
      ]
    },
    "coverAlt": {
      "type": "string"
    },
    "excerpt": {
      "type": "string"
    },
    "published": {
      "default": true,
      "type": "boolean"
    },
    "body": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ctaPrimary": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "href": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "href"
      ]
    },
    "ctaSecondary": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "href": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "href"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "slug",
    "publishedAt"
  ]
}