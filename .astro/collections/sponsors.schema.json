{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "logo": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "string",
          "pattern": "^\\/.*"
        }
      ]
    },
    "href": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "string",
          "const": ""
        }
      ]
    },
    "order": {
      "default": 99,
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "published": {
      "default": true,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "logo"
  ]
}