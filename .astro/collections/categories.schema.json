{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string"
    },
    "badge": {
      "type": "string",
      "enum": [
        "badge--pre",
        "badge--form-baja",
        "badge--form-alta",
        "badge--elite"
      ]
    },
    "ages": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "copy": {
      "type": "string"
    },
    "focus": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "schedule": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 3
    },
    "ctaHref": {
      "default": "/inscribete",
      "type": "string"
    },
    "order": {
      "default": 99,
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "published": {
      "default": true,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "slug",
    "badge",
    "ages",
    "name",
    "copy",
    "description"
  ]
}