{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "src": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "string",
          "pattern": "^\\/.*"
        }
      ]
    },
    "alt": {
      "type": "string",
      "minLength": 3
    },
    "order": {
      "default": 99,
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "published": {
      "default": true,
      "type": "boolean"
    },
    "partidoId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "string",
          "const": ""
        }
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "src",
    "alt"
  ]
}