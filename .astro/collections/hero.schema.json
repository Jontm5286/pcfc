{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "page": {
      "type": "string",
      "enum": [
        "home",
        "categorias",
        "calendario",
        "blog"
      ]
    },
    "eyebrow": {
      "default": "PCFC",
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "default": "Formando campeones en el Caribe.",
      "type": "string"
    },
    "backgroundImage": {
      "default": "/images/stock/jugadores-cancha.webp",
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "string",
          "pattern": "^\\/.*"
        }
      ]
    },
    "backgroundAlt": {
      "default": "Jugadores de Punta Cana FC entrenando en cancha",
      "type": "string"
    },
    "ctaPrimary": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "pattern": "^\\/.*"
        }
      },
      "required": [
        "label",
        "href"
      ]
    },
    "ctaSecondary": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "pattern": "^\\/.*"
        }
      },
      "required": [
        "label",
        "href"
      ]
    },
    "galleryImages": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "string",
                "pattern": "^\\/.*"
              }
            ]
          },
          "alt": {
            "type": "string",
            "minLength": 3
          }
        },
        "required": [
          "src",
          "alt"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "page",
    "title"
  ]
}