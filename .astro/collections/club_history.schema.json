{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "history",
        "teamMember"
      ]
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "roleDescription": {
      "type": "string"
    },
    "content": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "string",
          "pattern": "^\\/.*"
        }
      ]
    },
    "imageAlt": {
      "type": "string",
      "minLength": 3
    },
    "order": {
      "default": 99,
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "published": {
      "default": true,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "type"
  ]
}