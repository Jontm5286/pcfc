# ============================================
# PCFC — Variables de Entorno
# ============================================
# Copiar este archivo a .env y reemplazar los valores
# NUNCA commitear .env al repositorio

# EmDash CMS
# Dev (adapter Node): ruta de la SQLite. En Cloudflare se usa el binding DB (D1).
EMDASH_DATABASE_URL="file:./data/emdash.db"
# Generar con: pnpm exec emdash secrets generate
EMDASH_ENCRYPTION_KEY=emdash_enc_v1_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Producción (Cloudflare)
# El valor real va como secret: wrangler secret put EMDASH_ENCRYPTION_KEY
# EMDASH_ENCRYPTION_KEY="tu-clave-segura-aqui"

# Variables opcionales
# NODE_ENV=development
# PORT=4321

# Feed en vivo de partidos (FutbolPro Academy, sin auth — solo datos públicos)
# default en código: https://app.puntacanafc.com
# En local con la app corriendo: http://localhost:3001
# PUBLIC_ACADEMY_API_URL=http://localhost:3001

# Formulario de patrocinio (/sponsors#contacto → /api/contacto-patrocinio)
# En dev local (sin binding SEB) el endpoint solo registra en consola.
# SPONSOR_EMAIL=rrhhpuntacanafc@gmail.com
# SPONSOR_FROM=alianzas@puntacanafc.com

# Formulario de inscripción (/inscribete#formulario → /api/inscripcion)
# En dev local (sin binding SEB) el endpoint solo registra en consola.
# ADMISSION_EMAIL=rrhhpuntacanafc@gmail.com
# ADMISSION_FROM=inscripciones@puntacanafc.com

# Puente web → plataforma (/api/inscripcion-plataforma → POST {PLATFORM_URL}/api/public/preinscriptions)
# En dev: plataforma local en http://127.0.0.1:3000 con WEB_API_KEY=testkey123.
# NUNCA commitear valores reales — en prod van como secrets de Cloudflare.
# PLATFORM_URL=http://127.0.0.1:3000
# PLATFORM_API_KEY=testkey123
